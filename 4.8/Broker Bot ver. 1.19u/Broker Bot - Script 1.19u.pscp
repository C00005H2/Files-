end_Init;


start_Log;

_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[16],=Player;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
_RegExp=%Var[PlayerName],^([a-zA-Z0-9]*),PlayerName;
#ELSE
_SetVar=PlayerName,[Unknown];
#ENDIF

LogWrite=%VANILLATOOL\Logs\%DAY-%MONTH-%YEAR--%Var[ScriptTitle].txt,%HOUR:%MIN:%SEC -- [%AionTitle::%Var[PlayerName]] %Var[MSG]/n,+;

_IFRegExp=%Var[DiscordURL],^http;
_HTTPPost=https://subvanillatool.com/discord.php,url=%Var[DiscordURL]&message=__**[%Var[ScriptTitle]] [%AionTitle::%Var[PlayerName]]**__ [%THour:%TMin:%TSec] %Var[MSG];
#ENDIF

end_Log;


start_CloseWindows;

#DO=1500;
SendKey=0x1B;
Delay=1;
_UNTILMemPtrRead=%AddrESChwnd,%OffsetESChwnd,BYTE,=175;
Delay=15;
MemPtrWrite=%AddrESChwnd,%OffsetESChwnd,142,BYTE;

end_CloseWindows;


start_WaitForFrameClosed;

#DO=%Var[WaitForFrame_Timeout];
_IFFrameVisibleByName=%Var[WaitForFrame_Name];
_SetVar=t_WaitForFrame,0;
#ELSE
_SetVar=t_WaitForFrame,1;
#ENDIF
#UNTIL=%Var[t_WaitForFrame],=1;
Delay=150;

end_WaitForFrameClosed;


start_WaitForFrame;

#DO=%Var[WaitForFrame_Timeout];
_IFFrameVisibleByName=%Var[WaitForFrame_Name];
_SetVar=t_WaitForFrame,1;
#ELSE
_SetVar=t_WaitForFrame,0;
#ENDIF
#UNTIL=%Var[t_WaitForFrame],=1;
Delay=150;

end_WaitForFrame;



start_CheckInvSlot;

_SetVar=Item_Coord_X,0;
_SetVar=Item_Coord_Y,0;

_IFInventoryContains=%Var[SearchedItemID];
#ELSE
#Return
#ENDIF

MemPtrWrite=%AddrFrameName[inventory_dialog],%Var[Offset_Frame_XPos],4.032836914,FLOAT;
MemPtrWrite=%AddrFrameName[inventory_dialog],%Var[Offset_Frame_YPos],0,FLOAT;

_Calc[CubeAmount]=%InventoryMaxSlots/27;
_RegExp=%Var[CubeAmount],^([0-9]*?)(?:\.[0-9]*?$|$),CubeAmount;
_Calc[RemainingSlots]=%Var[CubeAmount]*27;
_Calc[RemainingSlots]=%InventoryMaxSlots-%Var[RemainingSlots];

_SetVar=DynamicCubeOffsetBase,%Var[Offset_Inv_Cube];
_SetVar=tResult,0;
_SetVar=tSlot,0;
_SetVar=CubeCount,0;
_SetVar=DynamicSlotOffset,0x0;
_Calc[DynamicCubeOffset]=%Var[CubeCount]*0x8;
_Calc[DynamicCubeOffset]=%Var[DynamicCubeOffsetBase]+%Var[DynamicCubeOffset];

#DO=90000;
_IFMemPtrRead=%AddrFrameName[inventory_dialog],%Var[DynamicCubeOffset]/%Var[Offset_Inv_Item]/%Var[DynamicSlotOffset]/%Var[Offset_Inv_ItemID],DWORD,=%Var[SearchedItemID];
_Calc[tResult]=%Var[tResult]+1;
#IF=%Var[tResult],>%Var[SecondResult];
_MemPtrReadVar=%AddrFrameName[inventory_dialog],%Var[DynamicCubeOffset]/%Var[Offset_Inv_Item]/%Var[DynamicSlotOffset]/%Var[Offset_Inv_ItemName],WCHAR[128],Sell_ItemName;
#EXECUTE=InvSlotToCoord;
#Return
#ENDIF
_Calc[tSlot]=%Var[tSlot]+1;
_Calc[DynamicSlotOffset]=%Var[tSlot]*0x8;
#IF=%Var[tSlot],=27;
_SetVar=tSlot,0;
_SetVar=DynamicSlotOffset,0x0;
_Calc[CubeCount]=%Var[CubeCount]+1;
_Calc[DynamicCubeOffset]=%Var[CubeCount]*0x8;
_Calc[DynamicCubeOffset]=%Var[DynamicCubeOffsetBase]+%Var[DynamicCubeOffset];
#ENDIF
#UNTIL=%Var[CubeCount],=%Var[CubeAmount];
#UNTIL=%Var[tSlot],=%Var[RemainingSlots];

end_CheckInvSlot;


start_InvSlotToCoord;

#IF=%ClientID,5-6;
_SetVar=FirstSlot_X,569;
_SetVar=FirstSlot_Y,57;
_SetVar=Icon_Width,30;
_SetVar=Icon_Height,30;
_SetVar=Cube_Height,20;
#ELSE
_SetVar=FirstSlot_X,563;
_SetVar=FirstSlot_Y,48;
_SetVar=Icon_Width,27;
_SetVar=Icon_Height,27;
_SetVar=Cube_Height,21;
#ENDIF

_Calc[tRow]=%Var[tSlot]/9;
_RegExp=%Var[tRow],^([0-9]*?)(?:\.[0-9]*?$|$),tRow;
_Calc[rSlots]=%Var[tRow]*9;
_Calc[cSlot]=%Var[tSlot]-%Var[rSlots];

_Calc[Cube_Distance]=%Var[CubeCount]*%Var[Cube_Height];
_Calc[Row_Distance]=%Var[CubeCount]*3;
_Calc[Row_Distance]=%Var[Row_Distance]+%Var[tRow];
_Calc[Row_Distance]=%Var[Row_Distance]*%Var[Icon_Height];
_Calc[Item_Coord_Y]=%Var[Cube_Distance]+%Var[Row_Distance];
_Calc[Item_Coord_Y]=%Var[FirstSlot_Y]+%Var[Item_Coord_Y];

_Calc[Slot_Distance]=%Var[cSlot]*%Var[Icon_Width];
_Calc[Item_Coord_X]=%Var[FirstSlot_X]+%Var[Slot_Distance];

end_InvSlotToCoord;


start_WaitForRelease;

#DO=5000;

_IFKey=2E,1; // Press/Hold Delete
#ELSE
#Return
#ENDIF

#UNTIL=1,=2;

end_WaitForRelease;


start_OnScriptExit;

MemPtrWrite=%PlayerBase,%OffsetActionID,0,DWORD;
Console=\g_maxfps 120;
MemWrite=%Var[AddrKinahRedirect],%OffsetKinah,DWORD;
MemPtrWrite=%AddrKinah,0x120,0,UINT64;

end_OnScriptExit;


