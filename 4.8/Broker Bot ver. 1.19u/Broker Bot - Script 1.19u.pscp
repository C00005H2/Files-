############# BROKER BOT ###############
# This script keeps trying to buy your desired item from   #
# Broker for the price you did setup                                 #
# Make sure UI Size is at 1.00, Client is english              #
# Auto-Arrange Windows is turned off                             #
# HUD is at bottom, eventually reset window positions   #
#######################################


#IF=%FirstTime,;
#SmoothBackground
RequireVersion=9.49;
_SetVar=ScriptTitle,Broker Bot;
Console=\g_maxfps 30;
UseSpeed=1;
Command=;
#SetWindow
#EXECUTE=GetOffsets;
#EXECUTE=Setup;
#EXECUTE=Init;
#ENDIF

#EXECUTE=Main;




start_Main;

#EXECUTE=Reset_Broker;

_SetVar=MSG,Broker Bot started searching for %Var[ItemName_1] at a maximum price of %Var[UnitPrice_1].. (%Var[ItemsDefined] Items in total);
#EXECUTE=Log;

_SetVar=Index,0;
#DO=999999999;

_Calc[Index]=%Var[Index]+1;
#IF=%Var[Index],>%Var[ItemsDefined];
_SetVar=Index,1;
#ENDIF

_IFMemPtrRead=%AddrFrameName[radar_dialog],%Var[Offset_Vendor_Notice],BYTE,=7; // Can collect Kinah
#EXECUTE=CollectKinah;
#ENDIF

_SetVar=Kinah,%Var[UnitPrice_%Var[Index]];
#EXECUTE=SetKinah; // Limit kinah we can spend for unit price

_Calc[BuyAttempts]=%Var[BuyAttempts]+1;
_MemPtrReadVar=%AddrKinah,%OffsetKinah,UINT64,Kinah_Cache;

#IF=%Var[ItemsDefined],>1;
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Search_Mode],%Var[SearchMode_%Var[Index]],BYTE; // Set SearchMode to "Exact Match" or "Keyword"
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Sort],%Var[Vendor_SortMode],BYTE; // Sort items
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_SearchBtn],7,BYTE; // Enable Search Btn
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Search_Text],%Var[ItemName_%Var[Index]],WCHAR[64];
Mouse=%Var[Vendor_SearchBtn_MouseX],%Var[Vendor_SearchBtn_MouseY]; // Search Button
#2DO=1000;
_2UNTILMemPtrRead=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_SearchCancelBtn],BYTE,=7; // loading completed
Delay=5;
#ELSE
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_RefreshBtn],7,BYTE; // Enable Refresh Bt
Mouse=%Var[Vendor_RefreshBtn_MouseX],%Var[Vendor_RefreshBtn_MouseY]; // Refresh Button
Delay=5; // Delay for loading items
#ENDIF

Mouse=%Var[Vendor_FirstItem_MouseX],%Var[Vendor_FirstItem_MouseY],Right; // First Item

#2DO=175;
_IFFrameVisibleByName=vendor_buy_each_dialog;
_SetVar2=1;
#ENDIF
_IFFrameVisibleByName=vendor_single_buy_dialog;
_SetVar2=1;
#ENDIF
#2UNTIL=%Var2,=1;

#IF=%Var2,=1; // If buy window poped up
_MemPtrReadVar=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_ItemAmount],DWORD,ItemAmount;
#EXECUTE=RestoreKinah; // Restore Kinah so we can buy for entire stack
Delay=%Var[BuyDelay];
SendKey=0x0D;
Command=;
#EXECUTE=CheckSuccess;
#ENDIF

_IFMemPtrRead=%TargetBase,%OffsetName,WCHAR[128],=%Var[Broker_Name];
#ELSE
#EXECUTE=Reset_Broker;
#ENDIF

_IFFrameVisibleByName=vendor_dialog;
#ELSE
#EXECUTE=Reset_Broker;
#ENDIF

#IF=%Var[BuyAttempts],>2000; // Reset broker window after 2000 attempts
#EXECUTE=Reset_Broker;
#ENDIF

#UNTIL=1,=2;

end_Main;




start_CheckSuccess;

#DO=2000;
Delay=10;
_MemPtrReadVar=%AddrKinah,%OffsetKinah,UINT64,CurrentKinah;
#UNTIL=%Var[CurrentKinah],<%Var[Kinah_Cache];

#IF=%Var[CurrentKinah],<%Var[Kinah_Cache];
_Calc[Kinah_Spend]=%Var[Kinah_Cache]-%Var[CurrentKinah];
_Calc[UnitPrice_Spend]=%Var[Kinah_Spend]/%Var[ItemAmount];
_SetVar=MSG,has spend %Var[Kinah_Spend] Kinah for <%Var[ItemName_%Var[Index]]> (%Var[ItemAmount]x %Var[UnitPrice_Spend] Kinah);
#EXECUTE=Log;
#IF=%Var[Sell_%Var[Index]],=1;
#EXECUTE=CheckSell;
#ENDIF

end_CheckSuccess;


start_CheckSell;

#2DO=99999999;

_IFInventoryContains=%Var[Sell_ItemID_%Var[Index]]; // If has item in inventory
#ELSE
#Return
#ENDIF

_IFInventoryContains=%Var[Sell_ItemID_%Var[Index]],%Var[Sell_stack_%Var[Index]]; // If has enough items for selling as required stack size
#ELSE
#IF=%Var[Sell_stack_%Var[Index]],>0;
#Return
#ENDIF

#EXECUTE=RestoreKinah;

Mouse=%Var[Vendor_SellTab_MouseX],%Var[Vendor_SellTab_MouseY]; // Sell Tab
Delay=650;
FrameActionByName=inventory_dialog,STATE,SHOW;

_SetVar=SearchedItemID,%Var[Sell_ItemID_%Var[Index]];
#EXECUTE=CheckInvSlot;
Mouse=%Var[Item_Coord_X],%Var[Item_Coord_Y],Right; // Rightclick on Item

#IF=%ClientID,10-13; // Not 4.6
_SetVar=WaitForFrame_Name,item_price_dialog;
#ELSE
_SetVar=WaitForFrame_Name,vendor_sell_stack_dialog;
#ENDIF
#DO=3000;
_SetVar=WaitForFrame_Timeout,5000;
#EXECUTE=WaitForFrame;
#UNTIL=%Var[t_WaitForFrame],=1;
#IF=%Var[t_WaitForFrame],=1;
#ELSE
#EXECUTE=Reset_Broker;
#Return
#ENDIF

#EXECUTE=SetSellMode;
#IF=%Var[Sell_stack_%Var[Index]],>0;
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_ItemAmount],%Var[Sell_stack_%Var[Index]],DWORD;
_SetVar=Sell_Amount,%Var[Sell_stack_%Var[Index]];
#ELSE
_MemPtrReadVar=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_ItemAmount],DWORD,Sell_Amount;
#ENDIF


#IF=%Var[Sell_UnitPrice_%Var[Index]],>0; // Sell price is not negative
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_Price],%Var[Sell_UnitPrice_%Var[Index]],DWORD;
_Calc[Sell_StackPrice]=%Var[Sell_Amount]*%Var[Sell_UnitPrice_%Var[Index]];
_SetVar=MSG,did put %Var[Sell_Amount]x <%Var[Sell_ItemName]> for %Var[Sell_UnitPrice_%Var[Index]] Kinah each for sale (%Var[Sell_StackPrice] Kinah total);
#EXECUTE=Log;
#ELSE
#EXECUTE=GetCurrentLowestPrice;
#IF=%Var[Broker_Sell_CurrentLowestPrice],>0; // Lowest price found
_Calc[t_Sell_UnitPrice]=%Var[Broker_Sell_CurrentLowestPrice]+%Var[Sell_UnitPrice_%Var[Index]];
#IF=%Var[t_Sell_UnitPrice],>0;
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_Price],%Var[t_Sell_UnitPrice],DWORD;
_Calc[Sell_StackPrice]=%Var[Sell_Amount]*%Var[t_Sell_UnitPrice];
_SetVar=MSG,did put %Var[Sell_Amount]x <%Var[Sell_ItemName]> for %Var[t_Sell_UnitPrice] Kinah each for sale (%Var[Sell_StackPrice] Kinah total - the lowest price was %Var[Broker_Sell_CurrentLowestPrice] Kinah);
#EXECUTE=Log;
#ENDIF


Delay=225;
SendKey=0x0D; // Enter
Delay=1250;
SendKey=0x0D; // Enter
Delay=650;
Mouse=%Var[Vendor_BuyTab_MouseX],%Var[Vendor_BuyTab_MouseY]; // Buy Tab
Delay=650;
Command=;

FrameActionByName=inventory_dialog,STATE,HIDE;

#2UNTIL=1,=2;

end_CheckSell;


start_SetSellMode;

#IF=%ClientID,%ARRAY3; // 4.6
#Return
#ENDIF

#IF=%ClientID,%ARRAY2; // Classic
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_Mode],%Var[Sell_mode_%Var[Index]],DWORD;
#Return
#ENDIF

#IF=%ClientID,%ARRAY1; // Retail
#IF=%Var[Sell_mode_%Var[Index]],=1; // Sell Each
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_Total],0,BYTE; // Uncheck
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_Each],4,BYTE; // Check
#Return
#ENDIF
#IF=%ClientID,%ARRAY1; // Retail
#IF=%Var[Sell_mode_%Var[Index]],=0; // Sell Total
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_Total],4,BYTE; // Check
MemPtrWrite=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_Each],0,BYTE; // Uncheck
#Return
#ENDIF

end_SetSellMode;


start_CollectKinah;

#IF=%Var[Sell_Collect],=0;
#Return
#ENDIF

_MemPtrReadVar=%AddrKinah,%OffsetKinah,UINT64,Kinah_Cache;

Mouse=%Var[Vendor_SoldTab_MouseX],%Var[Vendor_SoldTab_MouseY]; // Sold Tab
Delay=1250;
Mouse=%Var[Vendor_Sold_Collect_MouseX],%Var[Vendor_Sold_Collect_MouseY]; // Collect Kinah
Delay=1250;
Mouse=%Var[Vendor_BuyTab_MouseX],%Var[Vendor_BuyTab_MouseY]; // Buy Tab
Delay=1250;

_MemPtrReadVar=%AddrKinah,%OffsetKinah,UINT64,CurrentKinah;

#IF=%Var[CurrentKinah],>%Var[Kinah_Cache];
_Calc[Kinah_Gained]=%Var[CurrentKinah]-%Var[Kinah_Cache];
_SetVar=MSG,has collected %Var[Kinah_Gained] Kinah;
#EXECUTE=Log;
#ENDIF

end_CollectKinah;


start_Reset_Broker;

_SetVar=BuyAttempts,0;

#DO=45000;
#EXECUTE=CloseWindows;
Delay=850;
Command=/select %Var[Broker_Name];
Delay=150;
Command=/attack;
_SetVar=WaitForFrame_Name,dlg_dialog;
_SetVar=WaitForFrame_Timeout,5000;
#EXECUTE=WaitForFrame;
#UNTIL=%Var[t_WaitForFrame],=1;

_IFFrameVisibleByName=dlg_dialog;
DialogClick=;
Delay=1500;
#ELSE
#EXECUTE=Reset_Broker;
#ENDIF

_IFFrameVisibleByName=vendor_dialog;
#ELSE
#EXECUTE=Reset_Broker;
#ENDIF

MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Frame_XPos],0,FLOAT;
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Frame_YPos],0,FLOAT;

Mouse=%Var[Vendor_BuyTab_MouseX],%Var[Vendor_BuyTab_MouseY]; // Buy Tab

_IFMemPtrRead=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Search_Space],BYTE,<64;
Mouse=%Var[Vendor_Search_MouseX],%Var[Vendor_Search_MouseY]; // Search field
Delay=100;
Mouse=%Var[Vendor_Search_MouseX],%Var[Vendor_Search_MouseY]; // Search field
Delay=750;
SendKey=1234567890123456789012345678901234567890123456789012345678901234; // Allocate space for search string
Delay=6500;
#ENDIF
_IFMemPtrRead=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Search_Space],BYTE,<64;
#EXECUTE=Reset_Broker;
#ENDIF

MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Search_Mode],%Var[SearchMode_1],BYTE; // Set SearchMode to "Exact Match" or "Keyword"
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_SearchBtn],7,BYTE; // Enable Search Btn
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Search_Text],%Var[ItemName_1],WCHAR[64];
MemPtrWrite=%AddrFrameName[vendor_dialog],%Var[Offset_Vendor_Sort],%Var[Vendor_SortMode],BYTE; // Sort items
Delay=150;
Mouse=%Var[Vendor_SearchBtn_MouseX],%Var[Vendor_SearchBtn_MouseY]; // Search Button
Delay=800;

end_Reset_Broker;



start_Setup;

TrayInfo=Target the Broker NPC and press "Delete";
#EXECUTE=GetBrokerName;

Ask=Load last settings?;
#EXECUTE=Load_Session;
#Return
#ENDIF

#SetVar=User_BuyDelay,Enter a delay offset if some payments are not registered correctly/n/nRecommended values: 0-300;
_Calc[BuyDelay]=300+%Var[User_BuyDelay];

_SetVar=Index,0;
#DO=99999999;
_Calc[Index]=%Var[Index]+1;

#SetVar=ItemName_%Var[Index],[%Var[Index]]/n/nEnter the Item Name the bot should buy/n/nEnter nothing to stop defining items;
_IFRegExp=%Var[ItemName_%Var[Index]],.+;
#SetVar=UnitPrice_%Var[Index],[%Var[Index] - %Var[ItemName_%Var[Index]]]/n/nHow much kinah is the bot allowed to spend (Unit price)?;
#SetVar=SearchMode_%Var[Index],[%Var[Index] - %Var[ItemName_%Var[Index]]]/n/nChange to search mode to "Exact Match" or leave it on "Keyword"?/n/n1 = Exact Match/n0 = Keyword;
#SetVar=Sell_%Var[Index],[%Var[Index] - %Var[ItemName_%Var[Index]]]/n/nShould the item be sold again when it got bought?/n/n1 = Yes/n0 = No;
#IF=%Var[Sell_%Var[Index]],=1;
#SetVar=Sell_ItemID_%Var[Index],[%Var[Index] - %Var[ItemName_%Var[Index]]]/n/nHow is the Item ID of the Item it should sell?/n/nYou get the item ID while no script runs when you/ncheck "Show IDs" on the Script Editor and hover/nabove the item ingame;
#SetVar=Sell_UnitPrice_%Var[Index],[%Var[Index] - %Var[ItemName_%Var[Index]]]/n/nHow should the unit price be when selling it?/n/nYou can also enter a negative number as an offset from the cheapest price/nLike "-1" would sell for 599 Kinah if the cheapest price was 600 Kinah/nNegative offsets do not work on Aion Nova;
#SetVar=Sell_stack_%Var[Index],[%Var[Index] - %Var[ItemName_%Var[Index]]]/n/nShould it wait till it has a certain amount before selling?/n/nEnter the Amount it should wait for or "0" for selling right away;
#IF=%ClientID,<10; // Not 4.6
#SetVar=Sell_mode_%Var[Index],[%Var[Index] - %Var[ItemName_%Var[Index]]]/n/nHow should it sell it?/n/n1 = Sell Separately/n0 = Sell all;
#ENDIF

#UNTIL=%Var[ItemName_%Var[Index]],=;
_Calc[ItemsDefined]=%Var[Index]-1;

#SetVar=Sell_Collect,Should it collect the kinah from selling items?/n/n1 = Yes/n0 = No;
#SetVar=DiscordURL,Enter your Discord Webhook URL for Discord messages/notherwise enter 0/n/n( more information at https://vanillatool.com/discord );

Ask=Save current settings for next time?;
#EXECUTE=Save_Session;
#ENDIF

end_Setup;



start_Save_Session;

IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,Created,1;
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,User_BuyDelay,%Var[User_BuyDelay];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,Sell_Collect,%Var[Sell_Collect];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,DiscordURL,%Var[DiscordURL];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,ItemsDefined,%Var[ItemsDefined];

_SetVar=Index,0;
#DO=99999999;
_Calc[Index]=%Var[Index]+1;

_IFRegExp=%Var[ItemName_%Var[Index]],.+;
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],ItemName,%Var[ItemName_%Var[Index]];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],UnitPrice,%Var[UnitPrice_%Var[Index]];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],SearchMode,%Var[SearchMode_%Var[Index]];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell,%Var[Sell_%Var[Index]];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_ItemID,%Var[Sell_ItemID_%Var[Index]];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_UnitPrice,%Var[Sell_UnitPrice_%Var[Index]];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_stack,%Var[Sell_stack_%Var[Index]];
IniWrite=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_mode,%Var[Sell_mode_%Var[Index]];
#ENDIF

#UNTIL=%Var[Index],>%Var[ItemsDefined];

WaitForResponse=Settings saved under/n/n\[Vanillatool Folder]\Logs\BrokerBot Session\LastSession.ini;

end_Save_Session;


start_Load_Session;

IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,Created,Created;
#IF=%Var[Created],=1;
#ELSE
WaitForResponse=No settings found;
#Return
#ENDIF

IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,User_BuyDelay,User_BuyDelay;
_Calc[BuyDelay]=300+%Var[User_BuyDelay];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,Sell_Collect,Sell_Collect;
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,DiscordURL,DiscordURL;
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,Main,ItemsDefined,ItemsDefined;

_SetVar=Index,0;
#DO=99999999;
_Calc[Index]=%Var[Index]+1;

IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],ItemName,Temp;
_IFRegExp=%Var[Temp],.+;
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],ItemName,ItemName_%Var[Index];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],UnitPrice,UnitPrice_%Var[Index];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],SearchMode,SearchMode_%Var[Index];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell,Sell_%Var[Index];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_ItemID,Sell_ItemID_%Var[Index];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_UnitPrice,Sell_UnitPrice_%Var[Index];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_stack,Sell_stack_%Var[Index];
IniRead=%VANILLATOOL\Logs\BrokerBot Session\LastSession.ini,%Var[Index],Sell_mode,Sell_mode_%Var[Index];
#ENDIF

#UNTIL=%Var[Index],>%Var[ItemsDefined];

end_Load_Session;


start_GetBrokerName;

GetEntity=%OffsetData/%Var[Offset_Base_Family],DWORD,=350419,%Distance,FLOAT,<12,Broker_Addr;
#IF=%Var[Broker_Addr_Elements],>0;
_MemPtrReadVar=%Var[Broker_Addr_1],%OffsetName,WCHAR[128],Broker_Name;
TrayInfo=Found NPC: %Var[Broker_Name];
#ELSE
// Target the Broker NPC and press "Delete"
WaitForKey=2E,1; // Press/Hold Delete
#EXECUTE=WaitForRelease;
_MemPtrReadVar=%TargetBase,%OffsetName,WCHAR[128],Broker_Name;
TrayInfo=Recorded NPC: %Var[Broker_Name];
#ENDIF

end_GetBrokerName;


start_GetCurrentLowestPrice;

_IFMemPtrRead=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_CurrentSellPrice]/0x29,BYTE,=0;
_IFMemPtrRead=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_CurrentSellPrice]/0x2B,BYTE,=0;
_IFMemPtrRead=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_CurrentSellPrice]/0x2D,BYTE,=0;
_MemPtrReadVar=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_CurrentSellPrice]/0x28,WCHAR[8],r_Price;
#ELSE
_MemPtrReadVar=%AddrFrameName[vendor_sell_stack_dialog],%Var[Offset_Vendor_Sell_CurrentSellPrice]/0x28/0x0,WCHAR[64],r_Price;
#ENDIF

_IFRegExp=%Var[r_Price],^([0-9\.\|||\'\ \ ]+) ;
#ELSE
_SetVar=Broker_Sell_CurrentLowestPrice,0; // no price available
#Return
#ENDIF

_RegExp=%Var[r_Price],^([0-9\.\|||\'\ \ ]+) ,t_Price;

StringSplit=temp,,,%Var[t_Price];
#IF=%Var[temp_Elements],>0;
_SetVar=t_Price,;
_SetVar=i,0;
#DO=5000;
_Calc[i]=%Var[i]+1;
_SetVar=t_Price,%Var[t_Price]%Var[temp_%Var[i]];
#UNTIL=%Var[i],=%Var[temp_Elements];
#ENDIF

StringSplit=temp,.,%Var[t_Price];
#IF=%Var[temp_Elements],>0;
_SetVar=t_Price,;
_SetVar=i,0;
#DO=5000;
_Calc[i]=%Var[i]+1;
_SetVar=t_Price,%Var[t_Price]%Var[temp_%Var[i]];
#UNTIL=%Var[i],=%Var[temp_Elements];
#ENDIF

StringSplit=temp,',%Var[t_Price];
#IF=%Var[temp_Elements],>0;
_SetVar=t_Price,;
_SetVar=i,0;
#DO=5000;
_Calc[i]=%Var[i]+1;
_SetVar=t_Price,%Var[t_Price]%Var[temp_%Var[i]];
#UNTIL=%Var[i],=%Var[temp_Elements];
#ENDIF

StringSplit=temp, ,%Var[t_Price];
#IF=%Var[temp_Elements],>0;
_SetVar=t_Price,;
_SetVar=i,0;
#DO=5000;
_Calc[i]=%Var[i]+1;
_SetVar=t_Price,%Var[t_Price]%Var[temp_%Var[i]];
#UNTIL=%Var[i],=%Var[temp_Elements];
#ENDIF

StringSplit=temp, ,%Var[t_Price];
#IF=%Var[temp_Elements],>0;
_SetVar=t_Price,;
_SetVar=i,0;
#DO=5000;
_Calc[i]=%Var[i]+1;
_SetVar=t_Price,%Var[t_Price]%Var[temp_%Var[i]];
#UNTIL=%Var[i],=%Var[temp_Elements];
#ENDIF

_SetVar=Broker_Sell_CurrentLowestPrice,%Var[t_Price];

end_GetCurrentLowestPrice;


start_SetKinah;

MemPtrWrite=%AddrKinah,0x120,%Var[Kinah],UINT64;

end_SetKinah;


start_RestoreKinah;

_MemPtrReadVar=%AddrKinah,%OffsetKinah,UINT64,CurrentKinah;
MemPtrWrite=%AddrKinah,0x120,%Var[CurrentKinah],UINT64;

end_RestoreKinah;


start_Init;

_SetArray1=1,2; // Retail Clients
_SetArray2=5,6,15; // Classic Clients
_SetArray3=10,11,12,13,14; // 4.x Clients

#IF=%ClientID,=1; // NA
_SetVar=KinahRedirect_Pattern,C3488B05........488B80........C3;
_SetVar=KinahRedirect_Offset,0xB;
_SetVar=Vendor_SortMode,6; // Unit price smallest
_SetVar=Vendor_SearchBtn_MouseX,460;
_SetVar=Vendor_SearchBtn_MouseY,57;
_SetVar=Vendor_Search_MouseX,411;
_SetVar=Vendor_Search_MouseY,43;
_SetVar=Vendor_RefreshBtn_MouseX,504;
_SetVar=Vendor_RefreshBtn_MouseY,68;
_SetVar=Vendor_FirstItem_MouseX,310;
_SetVar=Vendor_FirstItem_MouseY,109;
_SetVar=Vendor_BuyTab_MouseX,24;
_SetVar=Vendor_BuyTab_MouseY,24;
_SetVar=Vendor_SellTab_MouseX,62;
_SetVar=Vendor_SellTab_MouseY,24;
_SetVar=Vendor_SoldTab_MouseX,105;
_SetVar=Vendor_SoldTab_MouseY,24;
_SetVar=Vendor_Sold_Collect_MouseX,499;
_SetVar=Vendor_Sold_Collect_MouseY,345;
#ENDIF

#IF=%ClientID,=2; // EU
_SetVar=KinahRedirect_Pattern,C3488B05........488B80........C3;
_SetVar=KinahRedirect_Offset,0xB;
_SetVar=Vendor_SortMode,6; // Unit price smallest
_SetVar=Vendor_SearchBtn_MouseX,568;
_SetVar=Vendor_SearchBtn_MouseY,57;
_SetVar=Vendor_Search_MouseX,150;
_SetVar=Vendor_Search_MouseY,87;
_SetVar=Vendor_RefreshBtn_MouseX,639;
_SetVar=Vendor_RefreshBtn_MouseY,65;
_SetVar=Vendor_FirstItem_MouseX,448;
_SetVar=Vendor_FirstItem_MouseY,131;
_SetVar=Vendor_BuyTab_MouseX,23;
