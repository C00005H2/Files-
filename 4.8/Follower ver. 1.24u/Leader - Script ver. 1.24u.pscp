#IF=%FirstTime,;
#SmoothBackground
#EXECUTE=GetOffsets;
UseSpeed=1;
_SetVar=KeyRelease,1;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],5;
SessionPushVar=5;
_SetVar1=0; // Wait
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],WAIT,WCHAR[16];
#ENDIF


#EXECUTE=WaitForKey;




start_WaitForKey;

#DO=99999999;
_IFKey=22,1; // Page Down
_SetVar1=0; // Wait
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],WAIT,WCHAR[16];
#ENDIF
_IFKey=21,1; // Page Up
_SetVar1=1; // Follow
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],FOLLOW,WCHAR[16];
#ENDIF
_IFKey=23,1; // End
_SetVar1=2; // Combat
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],COMBAT,WCHAR[16];
#ENDIF
_IFKey=24,1; // Home/Pos1
_SetVar1=3; // Loot
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],LOOT,WCHAR[16];
#ENDIF
_IFKey=2E,1; // Del
_SetVar1=4; // Regenerate
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],REGENERATE,WCHAR[16];
#ENDIF
_IFKey=60,1; // Numpad 0
_IFRegExp=%Var1,^[0-4];
MemPtrWrite=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_XPos],2.545898438,FLOAT;
MemPtrWrite=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_YPos],3.321690083,FLOAT;
_SetVar=KeyRelease,0;
_SetVar1=5; // Quest
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],QUEST,WCHAR[16];
#ENDIF
#IF=%Var[KeyRelease],=0;
_IFKey=60,1; // Numpad 0
#ELSE
_SetVar=KeyRelease,1;
#ENDIF
#IF=%Var[KeyRelease],=1;
_IFKey=60,1; // Numpad 0
_IFRegExp=%Var1,^[5];
_MemReadVar=%AddrMouseX,WORD,MouseX;
_MemReadVar=%AddrMouseY,WORD,MouseY;
_SetVar2=%Var[MouseX];
_SetVar3=%Var[MouseY];
SessionPushVar=2;
SessionPushVar=3;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],QUEST: %Var2|%Var3,WCHAR[16];
#ENDIF
_UNTILMemPtrRead=%AddrChat,%Var[Offset_ChatText],WCHAR[32],=stop lead;

_SetVar1=0; // Wait
SessionPushVar=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],0,BYTE;

end_WaitForKey;




start_GetOffsets;

#DO=60000;
#2DO=5000;
Delay=250;
#2UNTIL=%Timer=997,5000;

