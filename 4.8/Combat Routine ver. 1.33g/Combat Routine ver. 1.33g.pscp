//#COMBAT ROUTINE VER 1.33s
//##################InstaScript Settings###################

#IF=%FirstTime,;
RequireVersion=9.18;
#SmoothBackground
_SetVar=UserPIN,0000001; // Your PIN
_SetVar=FPSCap,30; // Limits the FPS
_SetVar=QuitClient,1; // exit aion when script finished - 0 = No | 1 = Yes
_SetVar=HidePlayers,1; // Hides other Players - 0 = No | 1 = Yes
_SetVar=Animation,0; // Want to use Animation modifications during combat and morphing? - 0 = No | 1 = Yes
_SetVar=AntiStuck,1; // Enable Anti-Stuck detection at the beginning of each round? - 0 = No | 1 = Yes
_SetVar=DiscordURL,0; // Enter your Discord Webhook URL for Discord messages, otherwise enter 0 ( more information at https://vanillatool.com/discord )
_SetVar=ChangeChannel,0; // Change channel at the end of every round? - 0 = No | 1 = Yes
_SetVar=Timeout,0; // Want to stop grinding after a certain amount of minutes?/n/nEnter the amount of minutes or 0 if you don't want any time limit

_SetVar=GMDetection,1; // Enable GM Detection? - 0 = No | 1 = Yes - (add more "#EXECUTE=EntityScan;" lines after every few waypoints for better detection)
_SetVar17=; // (Optional) Declare Player names where you want to close the Client when they're within render distance (110m)
_SetVar18=; // (Optional) Declare Player names that you want to ignore on the following 5 functions
_SetVar=NotifyWhenPlayerClose,0; // Gives sound alarm when another player is within 20m radius (Requires "GMDetection") - 0 = No | 1 = Yes
_SetVar=NotifyWhenPlayerTargets,1; // Gives sound alarm when another player has the bot as target (Requires "GMDetection") - 0 = No | 1 = Yes
_SetVar=WhisperWhenPlayerTargets,0; // Whispers the player with one of the WhisperAnswers from below, only once for each player (Requires "GMDetection") - 0 = No | 1 = Yes
_SetVar=ParanoidTargeted,0; // Instantly closes the client when a player targets you (If no Obelisk is within 110m) (Requires "GMDetection")  - 0 = No | 1 = Yes | 2 = Instantly suicides as well
_SetVar=ParanoidNearby,0; // Instantly suicides and closes the client when another player is within a certain radius (If no Obelisk is within 110m) (Requires "GMDetection") - 0 = Off  | otherwise enter the distance to check
_SetVar=AutoReplyToWhisper,0; // Auto replies to whispers with one of the WhisperAnswers from below, only once for each player (Requires "GMDetection") - 0 = No | 1 = Yes

_SetVar=StatusInvisible,1; // Sets Status to Invisible on friendlist - 0 = No | 1 = Yes
_SetVar=SoulHeal,1; // Heals Soulsickness - 0 = No | 1 = Yes
_SetVar=DisableLooting,0; // Want to stop looting if inventory is full? - 0 = No | 1 = Yes
_SetVar=PauseAfterDeath,3; // How many minutes you want to wait after death to enemy race?
_SetVar=StopAfterDeath,1; // Want to stop botting if died to mobs 3 times within 20 minutes? - 0 = No | 1 = Yes
_SetVar=Morph,0; // Want to morph when ever DP is full? - 0 = No | 1 = Yes
_SetVar=RecipeID,155000001; // Which Recipe ID you want to morph? - you find them at https://aioncodex.com/usc/recipe/
_SetVar=PetUsage,0; // Want to take gifts from pet? - 0 = No | 1 = Yes
_SetVar=RunScroll,0; // Use Greater Running Scroll? - 0 = No | 1 = Yes
_SetVar=AtkSpeedScroll,0; // Use Greater Courage Scroll? - 0 = No | 1 = Yes
_SetVar=CritStrikeScroll,0; // Use Fine Crit Strike Scroll? - 0 = No | 1 = Yes
_SetVar=CastSpeedScroll,0; // Use Greater Awakening Scroll? - 0 = No | 1 = Yes
_SetVar=CritSpellScroll,0; // Use Fine Crit Spell Running Scroll? - 0 = No | 1 = Yes
_SetVar=RallySerumAndFocusAgent,5; // Use Rally Serum and Focus Agent? - 0 = No | 1 = Lesser | 2 = Normal | 3 = Greater | 4 = Major | 5 = Fine
_SetVar=Sell,0; // Enable selling when inventory is full? - 0 = No | 1 = Yes, On recorded sell path | 2 = Yes, in Pande / Sanctum on predeclared sell path
_SetVar9=5; // Enter the ItemIDs the bot is allowed to sell (Example: 182010036,182010037,182010038) | You can also enter 1 to sell all White rarity Equipment items or enter 2 to sell all White + Green rarity Equipment items or enter 3 to sell all White + Green + Blue rarity Equipment items or enter 4 for my recommended custom list
_SetVar12=; // (Optional) Declare additional item IDs it's allowed to sell (Example: 182010036,182010037,182010038)
_SetVar=Disenchant,0; // Enable disenchanting at the beginning of every round? - 0 = No | 1 = Yes
_SetVar10=4; // Enter the ItemIDs the bot is allowed to disenchant (Example: 182010036,182010037,182010038) | You can also enter 1 to sell all White rarity Equipment items or enter 2 to sell all White + Green rarity Equipment items or enter 3 to sell all White + Green + Blue rarity Equipment items or enter 4 for my recommended custom list
_SetVar=Destroy,0; // Enable destruction of items when inventory is full? [0 = Off | 1 = Destroy items on list | 2 = Destroy items not on list] (Requires Real Mouse)
_SetVar11=4; // Enter the ItemIDs the bot is allowed to destroy (Example: 182010036,182010037,182010038) | You can also enter 1 to sell all White rarity Equipment items or enter 2 to sell all White + Green rarity Equipment items or enter 3 to sell all White + Green + Blue rarity Equipment items or enter 4 for my recommended custom list
_SetVar=WhisperAnswer1,?; // Enter a automatic reply text to whispers, If you don't want to reply to whispers enter nothing (Make sure "T" is binded to "Reply to Whisper" at Aion, and "Thread" option is enabled at script)
_SetVar=WhisperAnswer2,yes?; // Enter a automatic reply text to whispers
_SetVar=WhisperAnswer3,sorry busy; // Enter a automatic reply text to whispers
_SetVar=WhisperAnswer4,hello; // Enter a automatic reply text to whispers
_SetVar=WhisperAnswer5,我不会说英语; // Enter a automatic reply text to whispers
_SetVar=PrisonAnswer_1_1,where the hell am I?; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_1_2,wtf?; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_1_3,what just happend?; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_1_4,am I bugged?; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_1_5,剛剛發生了什麼; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_2_1,I cannot do anything; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_2_2,can I get out?; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_2_3,someone here?; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_2_4,how do I get out?; // Enter a automatic text when teleported to the prison
_SetVar=PrisonAnswer_2_5,我怎樣才能離開這裡; // Enter a automatic text when teleported to the prison
#EXECUTE=AccountSettings; // Scroll at the very end to setup account specific settings
#EXECUTE=InstaScriptLogin;
#ENDIF

//##################END Settings###################








//################## Startup ###################

#IF=%FirstTime,;
UseSpeed=1;
#UseLoop
#EnableChatLog
#ClearChatLog
#EnableSpeech
#EXECUTE=CheckInstaScript;
_Calc[TimeoutMS]=%Var[Timeout]*60000;
Command=;
Console=\g_maxfps %Var[FPSCap];
_SetVar=ScriptVersion,1.33s;
_SetVar=Token,ImHKGe;
_SetVar=ScanTimeout,12000; // Each GM scan can take up to 12 seconds
_SetVar=DetectFrom,100000;
_SetVar=DetectTill,100003;
_SetVar=ChannelNumber,1;
_SetVar=FailedSellAttempts,0;
_SetVar=TotalDeaths,0;
_SetVar=DiedToMob,0;
_SetVar=RecoverableEXP_Cache,0;
#EXECUTE=GetPetID; // Make sure the Pet is somewhere on Quickbar
#EXECUTE=CombatSort;
#EXECUTE=HidePlayers;
#EXECUTE=DisableClickToMove;
#EXECUTE=DisablePetCamera;
#ENDIF

_IFRegExp=%Var[WhisperAnswer1],.+;
_SetVar=WhisperEnabled,1;
#ELSE
_SetVar=WhisperEnabled,0;
#ENDIF

_IFProcessAlive=%Var[ThreadPID];
#ELSE
#IF=%Var[GMDetection],=1;
#ThreadEXECUTE=ThreadRoutine,True,False,ThreadPID; // frequently checks for nearby GMs and Whispers
#ENDIF

#IF=%FirstTime,;
#IF=%Var[StatusInvisible],=1;
#EXECUTE=SetStatusInvisible;
#ENDIF
#IF=%FirstTime,;
#IF=%Var[Sell],>0;
#EXECUTE=SetupSellList;
#ENDIF
#IF=%FirstTime,;
#IF=%Var[Disenchant],>0;
#EXECUTE=SetupDisenchantList;
#ENDIF
#IF=%FirstTime,;
#IF=%Var[Destroy],>0;
#EXECUTE=SetupDestroyList;
#ENDIF
#IF=%FirstTime,;
#EXECUTE=CombatSort;
#EXECUTE=StartUpRoutine;
#EXECUTE=DetectObelisk;
CreateTimer=9999998;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
_ShowLog
_SetVar=MainVTPID,%VTPID;
#ENDIF

//############### END Startup ###############


//############### Round beginning #############

#EXECUTE=CloseWindows;
#EXECUTE=CheckBug;
#EXECUTE=CheckDead;
#EXECUTE=GetPotionID; // Checks for new potions at the beginning of each round

#IF=%Var[PetUsage],=1;
#EXECUTE=CheckPetGift; // Checks for pet gift at the beginning of each round (disabled can freeze the camera)
#ENDIF

#IF=%Var[Sell],>0;
#IF=%InventoryRemainingSlots,=0;
#EXECUTE=Set_SellList;
#EXECUTE=InventoryCheck;
#ENDIF

#IF=%Var[Destroy],=1;
#IF=%InventoryRemainingSlots,=0;
_SetArray2=99,%Var11;
#EXECUTE=DestroyItem;
#ENDIF

#IF=%Var[Disenchant],=1;
#IF=%InventoryRemainingSlots,>1;
_SetArray2=99,%Var10;
Disenchant=%ARRAY2;
#ENDIF

#IF=%InventoryRemainingSlots,=0;
#IF=%Var[DisableLooting],=1;
_ACMob_Looting=False;
#IF=%Var[DisableLooting],=1;
_SetVar=MSG,has no inventory slots remaining. Looting will be turned off now;
#EXECUTE=Log;
_SetVar=DisableLooting,2;
#ENDIF

#IF=%InventoryRemainingSlots,>1;
#EXECUTE=Morph;
#ENDIF

#IF=%Var[Timeout],>0;
#IF=%Timer=9999998,%Var[TimeoutMS];
#EXECUTE=Reset;
Speech=%Var[PlayerName] has finished his grind session after %Var[Timeout] minutes.;
#EXECUTE=End;
#ENDIF


#IF=%FirstTime,;
_MemPtrReadVar=%PlayerBase,%OffsetPosX,FLOAT,StartPosX;
_MemPtrReadVar=%PlayerBase,%OffsetPosY,FLOAT,StartPosY;
_MemPtrReadVar=%PlayerBase,%OffsetPosZ,FLOAT,StartPosZ;
_Calc[StartPosX1]=%Var[StartPosX]-7.5;
_Calc[StartPosY1]=%Var[StartPosY]-7.5;
_Calc[StartPosZ1]=%Var[StartPosZ]-3;
_Calc[StartPosX2]=%Var[StartPosX]+7.5;
_Calc[StartPosY2]=%Var[StartPosY]+7.5;
_Calc[StartPosZ2]=%Var[StartPosZ]+3;
_Calc[ResetPosZ]=%Var[StartPosZ]+10;
_SetVar=MSG,started farming;
#EXECUTE=Log;
#ELSE
#LogAddRound
FlySmooth=%Var[StartPosX],%Var[StartPosY],%Var[StartPosZ];
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetPosX,FLOAT,%Var[StartPosX1]-%Var[StartPosX2];
_IFMemPtrRead=%PlayerBase,%OffsetPosY,FLOAT,%Var[StartPosY1]-%Var[StartPosY2];
_IFMemPtrRead=%PlayerBase,%OffsetPosZ,FLOAT,%Var[StartPosZ1]-%Var[StartPosZ2];
#ELSE
#LogAddStuck
_SetVar=MSG,got stuck. attempting Return..;
#EXECUTE=Log;
#IF=%Var[AntiStuck],=1;
#EXECUTE=Reset;
#EXECUTE=Return;
#ENDIF

//############### END Round beginning #############

//############### Grind Path #############

#GRINDMARK

//############### END Grind Path #############

#EXECUTE=ChangeChannel;

















//############### FUNCTIONS #############

start_CombatSort;

//;;;;;;;;BASIC SETTINGS;;;;;;;;;;;

#IF=%Var[Animation],=1;
_ACUseAnimation=True;
#ENDIF

#IF=%Var[Morph],=1;
_ACAllowDPSkills=False;
#ENDIF

_SetVar=PotionHP,70; // Use Potion if HP below 70%
_SetVar=PotionMP,66; // Use Potion if MP below 66%
_ACRegenerateEnabled=True; // Enables sitting
_ACRegMPPercentage=30; // Starts sitting when MP drop below 35%
_ACRegHPPercentage=50; // Starts sitting when HP drop below 50%
_ACTimeoutNoDamage=7000; // combat times out if the mob hasn't taken any damage within the first 7000 milliseconds
_ACTimeout=300; // Combat times out if the fight takes longer than 300 seconds
_ACMob_Looting=True; // Enables Looting
_ACAllowAllMobs=False; // Keeps fighting if enemy has another entity as target
_ACAllowEnemyRace=False; // Allows combat against enemy race
_ACEnableAutoAttack=False; // Enables AutoAttacks while fighting
_ACResetPosition=True; // Reset the player position after a fight to where he was before the fight started
_ACExperimentalCooldown=True; // Leave that on True
_ACMob_IgnoreLowLevel=True;

_SetVar1=200000000/99999;
#IF=%Var[RunScroll],=1;
_SetVar1=%Var1,164000076/9960; // Greater Running Scroll
#ENDIF
#IF=%Var[AtkSpeedScroll],=1;
_SetVar1=%Var1,164000073/9959; // Greater Courage Scroll
#ENDIF
#IF=%Var[CastSpeedScroll],=1;
_SetVar1=%Var1,164000134/9965; // Greater Awakening Scroll
#ENDIF
#IF=%Var[CritStrikeScroll],=1;
_SetVar1=%Var1,164000255/10766; // Fine Crit Strike Scroll
#ENDIF
#IF=%Var[CritSpellScroll],=1;
_SetVar1=%Var1,164000256/10767; // Fine Crit Spell Scroll
#ENDIF
#IF=%Var[RallySerumAndFocusAgent],=1; //Rally Serum and Focus Agent
_SetVar1=%Var1,160003552/10044,160003558/10051; // Lesser
#ENDIF
#IF=%Var[RallySerumAndFocusAgent],=2;
_SetVar1=%Var1,160003553/10044,160003559/10051; // Normal
#ENDIF
#IF=%Var[RallySerumAndFocusAgent],=3;
_SetVar1=%Var1,160003554/10044,160003560/10051; // Greater
#ENDIF
#IF=%Var[RallySerumAndFocusAgent],=4;
_SetVar1=%Var1,160003555/10044,160003561/10051; // Major
#ENDIF
#IF=%Var[RallySerumAndFocusAgent],=5;
_SetVar1=%Var1,160003556/10044,160003562/10051; // Fine
#ENDIF

_ACItems=%Var1;

//;;;;;;;END BASIC SETTINGS;;;;;;;;


#EXECUTE=GetPotionID;


_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=0;
