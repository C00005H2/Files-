start_InvSlotToCoord;

_SetVar=FirstSlot_X,563;
_SetVar=FirstSlot_Y,48;
_SetVar=Icon_Width,27;
_SetVar=Icon_Height,27;
_SetVar=Cube_Height,21;

_Calc[tRow]=%Var[tSlot]/9;
_RegExp=%Var[tRow],^([0-9]*?)(?:\.[0-9]*?$|$),tRow;
_Calc[rSlots]=%Var[tRow]*9;
_Calc[cSlot]=%Var[tSlot]-%Var[rSlots];

_Calc[Cube_Distance]=%Var[CubeCount]*%Var[Cube_Height];
_Calc[Row_Distance]=%Var[CubeCount]*3;
_Calc[Row_Distance]=%Var[Row_Distance]+%Var[tRow];
_Calc[Row_Distance]=%Var[Row_Distance]*%Var[Icon_Height];
_Calc[Item_Coord_Y]=%Var[Cube_Distance]+%Var[Row_Distance];
_Calc[Item_Coord_Y]=%Var[FirstSlot_Y]+%Var[Item_Coord_Y];

_Calc[Slot_Distance]=%Var[cSlot]*%Var[Icon_Width];
_Calc[Item_Coord_X]=%Var[FirstSlot_X]+%Var[Slot_Distance];

end_InvSlotToCoord;



