_SetVar=Dead,1;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,=0;
_SetVar=Dead,1;
#ENDIF

_IFDebuffAlive=8299; // Soul sickness
_SetVar=Dead,1;
#ENDIF

#IF=%Var[Dead],=1;
CreateTimer=105; // Restart Timer with ID 105
#SetWindow
#LogAddDeath
#DO=60000;
