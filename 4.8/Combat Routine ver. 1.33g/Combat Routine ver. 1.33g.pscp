_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Dialog_Scroll,(?m)\[4\.8\]\n.*?^Dialog_Scroll=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_Cube,(?m)\[4\.8\]\n.*?^Inv_Cube=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_Item,(?m)\[4\.8\]\n.*?^Inv_Item=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_ItemID,(?m)\[4\.8\]\n.*?^Inv_ItemID=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_ItemHandle,(?m)\[4\.8\]\n.*?^Inv_ItemHandle=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Confirm_ItemHandle,(?m)\[4\.8\]\n.*?^Confirm_ItemHandle=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Whisper_LastName,(?m)\[4\.8\]\n.*?^Whisper_LastName=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Whisper_Check,(?m)\[4\.8\]\n.*?^Whisper_Check=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Whisper_Channel,(?m)\[4\.8\]\n.*?^Whisper_Channel=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Base_TargetNPCID,(?m)\[4\.8\]\n.*?^Base_TargetNPCID=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Base_EntityID,(?m)\[4\.8\]\n.*?^Base_EntityID=(.*?)$;
CreateTimer=997;

end_GetOffsets;



start_InstaScriptLogin;

CreateTimer=997;
_SetVar=ScriptTitle,Combat; // Scriptname used for Logs or Script Editor title
#EXECUTE=GetOffsets;

#IF=%FirstTime,;
_SetVar=WrongPIN,0;
MemPtrWrite=%AddrFPS,%OffsetFPS1,%Var[FPSCap],BYTE;
MemPtrWrite=%AddrFPS,%OffsetFPS2,%Var[FPSCap],FLOAT;
MemWrite=%AddrMouseX,0x00000000000000000000000000000000,BYTE[16]; // initialize mouse usage
#ENDIF

_IFMemRead=%AddrMap,DWORD,<999999999;
_IFMemRead=%AddrMap,DWORD,>0; // if already logged in
#SetWindow
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%Var[PlayerName] - InstaScript;
#Return
#ENDIF

#DO=600000;
Delay=1500;
_UNTILMemRead=%AddrCharacterScene,DWORD,=8;

_IFMemRead=%AddrCharacterScene,DWORD,=8; // Accept EULA screen
#SetWindow
#DO=600000;
Delay=1500;
_UNTILMemRead=%AddrMap,DWORD,=4294967295;
#DO=15000;
Delay=500;
_UNTILMemRead=0x500,BYTE,=1;
_UNTILMemRead=0x504,BYTE,=1;
SetScriptTitle=%AionTitle;
Delay=2500;
SendKey=0x0D; // Accept
Delay=9000;
#ENDIF

_IFMemRead=%AddrCharacterScene,DWORD,=8; // Accept EULA screen
#Crash
#ENDIF

_IFMemRead=%AddrCharacterScene,DWORD,=9; // Select Server screen
Mouse=457,115; // Sort by Character
Delay=750;
Mouse=457,115; // Sort by Character
Delay=750;
Mouse=397,130; // First Server
Delay=750;
SendKey=0x0D; // Accept
Delay=12000;
#ENDIF

#EXECUTE=EmptyServerCheckup;
Mouse=50,503; // First Char
Delay=500;
Mouse=297,571; // Start
Delay=500;
Mouse=297,571; // Start
Delay=2000;

_IFFrameVisibleByName=second_password_dialog; PIN window
#ELSE
LogWrite=%VANILLATOOL\Logs\%DAY-%MONTH-%YEAR--Combat_Log.txt,%HOUR:%MIN:%SEC -- %AionTitle Had the PIN bug/n,+;
#ENDIF

MemWrite=%AddrFreeMem10,1,BYTE;
#DO=600000;

_IFFrameVisibleByName=second_password_dialog; PIN window
Mouse=496,335;
Delay=50;
#EXECUTE=WrongPIN;
FrameActionByName=second_password_dialog,XPOS,0;
FrameActionByName=second_password_dialog,YPOS,0;
#EnterPIN=%Var[UserPIN];
Delay=1000;
SendKey=0x0D;
#ELSE
MemWrite=%AddrFreeMem10,0,BYTE;
#ENDIF

Delay=750;
_UNTILMemRead=%AddrFreeMem10,BYTE,=0;

Delay=14000;
#DO=1500;
SendKey=0x1B;
Delay=25;
_UNTILMemPtrRead=%AddrESChwnd,%OffsetESChwnd,BYTE,=175;
Delay=15;

_IFMemRead=%AddrMap,DWORD,>999999999; // not successfully logged in
#EXECUTE=End;
#ENDIF

_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%Var[PlayerName] - InstaScript;

end_InstaScriptLogin;


start_EmptyServerCheckup;

#DO=150000;
_IFMemRead=%AddrCharacterScene,DWORD,=13; // Create Char screen
Delay=1000;
Mouse=434,573; // Main Screen
Delay=1000;
Mouse=164,571; // Server Selection
Delay=9000;
Mouse=397,145; // Lowest Server
Delay=1000;
SendKey=0x0D; // Accept
Delay=5500;
#ENDIF
_UNTILMemRead=%AddrCharacterScene,DWORD,=11; // Char selection screen

end_EmptyServerCheckup;


start_WrongPIN;

_IFFrameVisible=%ConfirmFrameID;
_Calc[WrongPIN]=%Var[WrongPIN]+1;
Mouse=480,347; //
Delay=50;
Mouse=497,345; // Prompt wrong PIN
Delay=1000;
#ENDIF

#IF=%Var[WrongPIN],>1;
LogWrite=%VANILLATOOL\Logs\%DAY-%MONTH-%YEAR--Combat_Log.txt,%HOUR:%MIN:%SEC -- [%AionTitle::%Var[PlayerName]] entered the PIN {%Var[UserPIN]} incorrectly 2 times. logging off now/n,+;
#QuitAtRound=-1,True;
#ENDIF

end_WrongPIN;


start_End;

#IF=%Var[QuitClient],=1;
#QuitAtRound=-1,True;
#ELSE
#EndScript
#ENDIF

end_End;


start_AccountSettings; // Customize PIN and character amount for each account here

_SetVar=IgnoreThis,0;

#IF=%AionTitle,=Account1; // IF window title = Account1 then
_SetVar=UserPIN,024689; // Your PIN
_Calc[IgnoreThis]=%Var[IgnoreThis]+1;
#ENDIF

#IF=%AionTitle,=Account2; // IF window title = Account2 then
_SetVar=UserPIN,111111; // Your PIN
_Calc[IgnoreThis]=%Var[IgnoreThis]+1;
#ENDIF

#IF=%AionTitle,=Account3; // IF window title = Account3 then
_SetVar=UserPIN,1234567; // Your PIN
_Calc[IgnoreThis]=%Var[IgnoreThis]+1;
#ENDIF



#IF=%Var[IgnoreThis],=0; // IF neither of them is found use default values from top of script
_SetVar=UserPIN,%Var[UserPIN];
#ENDIF

end_AccountSettings;
