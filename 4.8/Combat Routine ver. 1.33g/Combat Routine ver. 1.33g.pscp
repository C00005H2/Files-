#IF=%Var[RunScroll],=1;
_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player; // if not in loading screen
_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,>0; // if alive
_IFInventoryContains=164000076; // Greater Running Scroll
UseID=164000076;
Delay=333;
#ENDIF


