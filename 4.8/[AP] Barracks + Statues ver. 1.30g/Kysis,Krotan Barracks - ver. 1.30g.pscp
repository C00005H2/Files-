end_CloseWindows;



start_CombatSort;

_MemPtrReadVar=%PlayerBase,%OffsetPosX,FLOAT,PlayerX;
_MemPtrReadVar=%PlayerBase,%OffsetPosY,FLOAT,PlayerY;
_MemPtrReadVar=%PlayerBase,%OffsetPosZ,FLOAT,PlayerZ;

_IFMemPtrRead=%PlayerBase,%OffsetData/0x38,BYTE,=1;
#DO=3000;
UseID=50000;
Command=/skill Toggle Combat;
#2DO=1500;
MoveTo=%Var[PlayerX],%Var[PlayerY],%Var[PlayerZ],True,False;
_2UNTILMemPtrRead=%PlayerBase,%OffsetData/0x38,BYTE,=33;
_UNTILMemPtrRead=%PlayerBase,%OffsetData/0x38,BYTE,=33;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=1; <-GLAD
#EXECUTE=CombatOthers;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=2;
#EXECUTE=CombatTemplar; <- Impossible
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=4; <-SIN
#EXECUTE=CombatOthers;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=5;
#EXECUTE=CombatRanger;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=7;
#EXECUTE=CombatSorcerer;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=8;
#EXECUTE=CombatSpiritmaster;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=10;
#EXECUTE=CombatCleric;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=11;
#EXECUTE=CombatChanter;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=13; <-AT
#EXECUTE=CombatOthers;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=14; <-GUN
#EXECUTE=CombatOthers;
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=16; <-SW
#EXECUTE=CombatOthers;
#ENDIF

MoveTo=%Var[PlayerX],%Var[PlayerY],%Var[PlayerZ],True,False;

end_CombatSort;


start_CombatSorcerer;

Delay=750;
#DO=120000;
UseID=1447; // Erosion
Delay=3100;
