#IF=%FirstTime,;
#SetVar=QuitClient,Exit Aion when a GM is found nearby?/n/n1 = Yes/n0 = No;
_HTTPGetVar=http://pastebin.com/raw/kvP6EM6m,,GMList;
CreateTimer=997;
Command=;
Print=;
#UseLoop
UseSpeed=1;
_SetVar=ScriptVersion,1.13;
_SetVar=Token,OCD6p6;
_SetVar=ScanTimeout,3500; // Each scan can take up to 3.5 seconds
_SetVar=DetectFrom,100000;
_SetVar=DetectTill,100003;
#EXECUTE=StartGMDetection;
#ENDIF


#EXECUTE=EntityScan;
Delay=2500; // Pause 2.5 seconds between each scan








start_EntityCheckup;
//Checkups for a found entity

_IFMemPtrRead=%PlayerBase,%OffsetName,WCHAR[32],=%Var[PlayerName];
#ELSE
#Return
#ENDIF

MemWrite=%AddrFreeMem0,%Var[tPtr],UINT64;
_MemPtrReadVar=%AddrFreeMem0,%OffsetName,WCHAR[64],Name;
_MemPtrReadVar=%AddrFreeMem0,%OffsetPosX,FLOAT,XPOSF;
_MemPtrReadVar=%AddrFreeMem0,%OffsetPosY,FLOAT,YPOSF;
_MemPtrReadVar=%AddrFreeMem0,%OffsetPosZ,FLOAT,ZPOSF;
_MemPtrReadVar=%AddrFreeMem0,%OffsetLevel,BYTE,Level;
MemWrite=%AddrFreeMem8,%Var[XPOSF],DWORD; // float to dword
_MemReadVar=%AddrFreeMem8,DWORD,XPOS;
MemWrite=%AddrFreeMem8,%Var[YPOSF],DWORD; // float to dword
_MemReadVar=%AddrFreeMem8,DWORD,YPOS;
MemWrite=%AddrFreeMem8,%Var[ZPOSF],DWORD; // float to dword
_MemReadVar=%AddrFreeMem8,DWORD,ZPOS;
MemPtrWrite=%AddrFreeMem0,%OffsetData/0x4C8,1,DWORD; // set already scanned


#IF=%Var[XPOS],=0;
#Return
#ENDIF
#IF=%Var[YPOS],=0;
#Return
#ENDIF
#IF=%Var[ZPOS],=0;
#Return
#ENDIF

#IF=%Var[MapID],=4294967295; // Loading screen
#Return
#ENDIF
#IF=%Var[Name],=;
#Return
#ENDIF

#IF=%Var[Name],=%Var[PlayerName];
#Return
#ELSE
//Print=<%Var[Name]> detected at [pos:Location/:%Var[RaceCode] %Var[MapID] %Var[XPOS] %Var[YPOS] 0.0 0];
#ENDIF

_SetVar=GM_Found,0;
_SetArray2=220010000,210010000; // Ishalgen, Poeta
#IF=%Var[MapID],%ARRAY2;
#ELSE
#IF=%Var[Level],1-8;
_IFMemPtrRead=%AddrFreeMem0,%OffsetName,WCHAR[32],=%Var[Name];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x34,DWORD,%Var[DetectFrom]-%Var[DetectTill];
_SetVar=GM_Found,1;
_SetVar=GM_Method,1;
#EXECUTE=GMReport;
#ENDIF

#IF=%Var[GM_Found],=0;
_SetArray2=%Var[GMList];
#IF=%Var[Name],%ARRAY2;
_IFMemPtrRead=%AddrFreeMem0,%OffsetName,WCHAR[32],=%Var[Name];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x34,DWORD,%Var[DetectFrom]-%Var[DetectTill];
_SetVar=GM_Found,1;
_SetVar=GM_Method,2;
#EXECUTE=GMReport;
#ENDIF

#IF=%Var[GM_Found],=0;
_IFMemPtrRead=%AddrFreeMem0,%OffsetName,WCHAR[32],=%Var[Name];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x34,DWORD,%Var[DetectFrom]-%Var[DetectTill];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x378,BYTE,>2; // 192
_SetVar=GM_Found,1;
_SetVar=GM_Method,4;
#EXECUTE=GMReport;
#ENDIF

#IF=%Var[GM_Found],=0;
_IFMemPtrRead=%AddrFreeMem0,%OffsetName,WCHAR[32],=%Var[Name];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x34,DWORD,%Var[DetectFrom]-%Var[DetectTill];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x24,BYTE,=22;
_SetVar=GM_Found,1;
_SetVar=GM_Method,5;
#EXECUTE=GMReport;
#ENDIF

#IF=%Var[GM_Found],=0;
_IFMemPtrRead=%AddrFreeMem0,%OffsetName,WCHAR[32],=%Var[Name];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x34,DWORD,%Var[DetectFrom]-%Var[DetectTill];
_IFMemPtrRead=%AddrFreeMem0,%OffsetData/0x379,BYTE,>2; // Eye level
_SetVar=GM_Found,1;
_SetVar=GM_Method,6;
#EXECUTE=GMReport;
#ENDIF

#IF=%Var[GM_Found],=1;
#IF=%Var[QuitClient],=1;
#QuitAtRound=-1,True;
#UseNoLoop
#EndScript
#ENDIF

#IF=%Var[GM_Found],=1;
#IF=%Var[QuitClient],=0;
Print=<GM: %Var[Name]> detected at [pos:Location/:%Var[RaceCode] %Var[MapID] %Var[XPOS] %Var[YPOS] 0.0 0];
WaitForResponse=GM: %Var[Name] Detected Nearby! (%Var[MapID] | %Var[XPOS] | %Var[YPOS]);
#ENDIF

end_EntityCheckup;



start_EntityScan;
//Checks for Entities nearby

CreateTimer=998;
_MemReadVar=%AddrMap,DWORD,MapID;

#DO=%Var[ScanTimeout];

_SetVar=tFound,0;

_IFMemPtrRead=%AddrChat,0xC8,UINT64,>0;
_SetVar=tFound,1;
_IFMemPtrRead=%AddrChat,0xC8/%OffsetData/0x4C8,DWORD,=0;
_MemPtrReadVar=%AddrChat,0xC8,UINT64,tPtr;
MemPtrWrite=%AddrChat,0xC8,0,UINT64;
#EXECUTE=EntityCheckup;
CreateTimer=998;
#ENDIF

#IF=%Var[tFound],=0;
#IF=%Timer=998,750;
#Return
#ENDIF

#UNTIL=1,=2;

end_EntityScan;


start_StartGMDetection;
//Declares some variables and initiates code injection
_IFMemPtrRead=%PlayerBase,%OffsetRace,CHAR[1],=L;
_SetVar=RaceCode,0;
#ELSE
_SetVar=RaceCode,1;
#ENDIF

_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;

_Calc[tDetectFrom]=%Var[DetectFrom]-1;
_Calc[tDetectTill]=%Var[DetectTill]+1;
_SetVar=TypeLimit,5;
_Calc[InjectAddr]=%AddrFreeMem30+0x40;
_Calc[InjectNPCID]=%Var[InjectAddr]+3;
_Calc[InjectNPCID2]=%Var[InjectAddr]+12;
_IFMemRead=%Var[InjectAddr],WORD,=31617;
#ELSE
#EXECUTE=StartThread;
#ENDIF

MemWrite=%Var[InjectNPCID],%Var[tDetectFrom],DWORD;
MemWrite=%Var[InjectNPCID2],%Var[tDetectTill],DWORD;

end_StartGMDetection;


start_StartThread;
//Injects code

#DO=5000;
Delay=250;
#UNTIL=%Timer=997,5000;

_HTTPGetVar=http://subvanillatool.com/data/Threads.html,,AddrThread,4\.6-9A4="(.*?)";
_HTTPGetVar=http://subvanillatool.com/data/Threads.html,,Offset,4\.6_CODE="(.*?)";

_SetVar=ReturnValue,0x3C;
_Calc[AddrThread2]=%Var[ReturnValue]+0x5;
_Calc[AddrThread2]=%Var[AddrThread]+%Var[AddrThread2]; Thread 2


_Pause=True;

MemWrite=%Var[InjectAddr],%Var[InjectAddr],DWORD;
_MemReadVar=%Var[InjectAddr],DWORD,FreeMemory;

_Calc[Jump]=%Var[FreeMemory]-%Var[AddrThread];
_Calc[Jump]=%Var[Jump]-5;

_Calc[Jump2]=%Var[FreeMemory]-%Var[AddrThread2];
_Calc[Jump2]=%Var[Jump2]-5;

_Calc[Return]=%Var[AddrThread]+4294967295;
_Calc[Return]=%Var[Return]-%Var[FreeMemory];
_Calc[Return]=%Var[Return]+5;

MemWrite=%Var[InjectAddr],0x817B34A08601007620817B34A0860100731783BBC804000000750E488B430848A3D8B80F3A0000000048B80000000000000000%Var[Offset]0000E9,BYTE[58];

_MemReadVar=%AddrChat,DWORD,ChatStruct;
_Calc[ChatStruct]=%Var[ChatStruct]+0xC8; create ptr at Chat/D8
_Calc[InjectSaveSlot]=%Var[FreeMemory]+0x21;
MemWrite=%Var[InjectSaveSlot],%Var[ChatStruct],DWORD;

_Calc[Return1]=%Var[Return]-%Var[ReturnValue];
_Calc[AddrReturn1]=%Var[FreeMemory]+0x3A;
MemWrite=%Var[AddrReturn1],%Var[Return1],DWORD;

_Calc[AddrJump1]=%Var[AddrThread]+0x1;
_Calc[AddrJump2]=%Var[AddrThread]+0x5;
MemWrite=%Var[AddrThread],0xE9,BYTE[1];
MemWrite=%Var[AddrJump1],%Var[Jump],DWORD;
MemWrite=%Var[AddrJump2],0x90,BYTE[1];

_Calc[AddrJump21]=%Var[AddrThread2]+0x1;
_Calc[AddrJump22]=%Var[AddrThread2]+0x5;
MemWrite=%Var[AddrThread2],0xE9,BYTE[1];
MemWrite=%Var[AddrJump21],%Var[Jump2],DWORD;
MemWrite=%Var[AddrJump22],0x90,BYTE[1];
_Pause=False;

end_StartThread;


start_GMReport;

_HTTPPost=https://subvanillatool.com/POST/%Var[Token]/post.php,text=<b><font color="#ff0000">[GM Detector %Var[ScriptVersion]] [Method %Var[GM_Method]]</font></b> [%Var[Name]] (%Var[Level]) detected at Map: %Var[MapID] | X: %Var[XPOSF] | Y: %Var[YPOSF] | Z: %Var[ZPOSF];
_MemPtrReadVar=%AddrFreeMem0,0x0,BYTE[1024],Dump;
_MemPtrReadVar=%AddrFreeMem0,%OffsetData/0x0,BYTE[2048],DataDump;
%ResetLogFile
LogWrite=%VANILLATOOL\Logs\GM Detector\%Var[Name]__%DAY-%MONTH-%YEAR.txt,%Var[Dump],r;
%ResetLogFile
LogWrite=%VANILLATOOL\Logs\GM Detector\%Var[Name]__Data__%DAY-%MONTH-%YEAR.txt,%Var[DataDump],r;

end_GMReport;
