#COMBAT ROUTINE VER 1.00s
#IF=%FirstTime,;
RequireVersion=8.17;
UseSpeed=1;
#UseLoop
#EnableSpeech
WaitForResponse=Make sure F8 is bound to "Select Nearest Target" to get a soul heal after death;
#SetVar4=Want to use NoAnimation while grinding?/n/nType 1 for yes or 0 for no;
#SetVar7=Enable selling when inventory is full?/n/nType 0 for no/nType 1 for selling at merchant(requires recorded sell path);
#SetVar2=Enable Anti-Stuck detection at the beginning of each round?/n/nType 1 for yes or 0 for no;
#SetVar=DiscordURL,Enter your Discord Webhook URL for Discord messages/notherwise enter 0/n/n( more information at https://vanillatool.com/discord );
#SetVar=Timeout,Want to stop grinding after a certain amount of minutes?/n/nEnter the amount of minutes or 0 if you don't want any time limit;
_Calc[TimeoutMS]=%Var[Timeout]*60000;
#AUTOSELLMARK
_SetVar=TabDistance,60; // Distance the "Tab" key finds entities (default distance is 40)
#EXECUTE=TabMod;
#SmoothBackground
Command=;
MemWrite=%AddrFreeMem4,%Var4,BYTE;
MemWrite=%AddrFreeMem2,%Var5,BYTE;
MemWrite=%AddrFreeMem6,0,BYTE;
#EXECUTE=CombatSort;
MemPtrWrite=%AddrFPS,%OffsetFPS1,30,BYTE; // these 2 lines cap the fps at 30
MemPtrWrite=%AddrFPS,%OffsetFPS2,30,FLOAT; // these 2 lines cap the fps at 30
_MemPtrReadVar=%PlayerBase,%OffsetPosX,FLOAT,15;
_MemPtrReadVar=%PlayerBase,%OffsetPosY,FLOAT,16;
_MemPtrReadVar=%PlayerBase,%OffsetPosZ,FLOAT,17;
MemPtrWrite=%AddrCamMax,%OffsetCamMax,44,FLOAT;
Delay=100;
MemPtrWrite=%AddrThirdPerson,%OffsetThirdPerson,44,FLOAT;
MemWrite=%AddrCamX,90,FLOAT;
MemWrite=%AddrCamY,85,FLOAT;
#IF=%Var7,>0;
#SetArray2=Enter the ItemIDs the bot is allowed to sell/nExample: 182010036,182010037,182010038;
#ENDIF
#IF=%FirstTime,;
//#EXECUTE=GetPetID;
//#EXECUTE=CheckAutoLoot;
//#EXECUTE=CheckAutoBuff;
#EXECUTE=DetectObelisk;
CreateTimer=9999998;
_ShowLog
#ENDIF


#EXECUTE=CheckDead;
#EXECUTE=GetPotionID;

#IF=%Var7,>0;
#IF=%InventoryRemainingSlots,<5;
#EXECUTE=InventoryCheck;
_SetVar=MSG,[%THour:%TMin:%TSec] Luna daily script got started;
#EXECUTE=DiscordPost;
#ENDIF

#IF=%Var[Timeout],>0;
#IF=%Timer=9999998,%Var[TimeoutMS];
#EXECUTE=Stop;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[64],25;
Speech=%Var25 has finished his grind session after %Var[Timeout] minutes.;
#UseNoLoop
#EndScript
#ENDIF


#IF=%FirstTime,;
_MemPtrReadVar=%PlayerBase,%OffsetPosX,FLOAT,StartPosX;
_MemPtrReadVar=%PlayerBase,%OffsetPosY,FLOAT,StartPosY;
_MemPtrReadVar=%PlayerBase,%OffsetPosZ,FLOAT,StartPosZ;
_Calc[StartPosX1]=%Var[StartPosX]-7.5;
_Calc[StartPosY1]=%Var[StartPosY]-7.5;
_Calc[StartPosZ1]=%Var[StartPosZ]-3;
_Calc[StartPosX2]=%Var[StartPosX]+7.5;
_Calc[StartPosY2]=%Var[StartPosY]+7.5;
_Calc[StartPosZ2]=%Var[StartPosZ]+3;
_Calc[ResetPosZ]=%Var[StartPosZ]+10;
#ELSE
#LogAddRound
FlySmooth=%Var[StartPosX],%Var[StartPosY],%Var[StartPosZ];
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetPosX,FLOAT,%Var[StartPosX1]-%Var[StartPosX2];
_IFMemPtrRead=%PlayerBase,%OffsetPosY,FLOAT,%Var[StartPosY1]-%Var[StartPosY2];
_IFMemPtrRead=%PlayerBase,%OffsetPosZ,FLOAT,%Var[StartPosZ1]-%Var[StartPosZ2];
#ELSE
#IF=%Var2,=1;
#EXECUTE=Reset;
#ENDIF


#IF=%Position,%Var15/%Var16/%Var17;
#ELSE
#DO=15000;
MoveSmooth=%Var15,%Var16;
SendAction=3,2;
#UNTIL=%Position,%Var15/%Var16/%Var17;
#ENDIF

MemWrite=%AddrCamY,85,FLOAT;
MemPtrWrite=%AddrThirdPerson,%OffsetThirdPerson,44,FLOAT;
_IFMemRead=%AddrCamX,FLOAT,=90;
MemWrite=%AddrCamX,-90,FLOAT;
#ELSE
MemWrite=%AddrCamX,90,FLOAT;
#ENDIF

_ACCheckMob=;

_ACDetectIfAttacked=;
Delay=25;




start_CheckDead;

_SetVar=Dead,0;

_IFFrameVisibleByName=resurrect_dialog;
_SetVar=Dead,1;
#ENDIF

_IFMemRead=%AddrResurrect,FLOAT,>0;
_SetVar=Dead,1;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,=0;
_SetVar=Dead,1;
#ENDIF

_IFDebuffAlive=8299; // Soul sickness
_SetVar=Dead,1;
#ENDIF

#IF=%Var[Dead],=1;
#SetWindow
#LogAddDeath
#DO=60000;
MemWrite=%AddrResurrect,0,FLOAT; <- Resurrect
Delay=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetHP,DWORD,>0;
Delay=5000;
#EXECUTE=FindSoulHealer;
Delay=1000;
#EXECUTE=Return;
//#EXECUTE=CheckAutoLoot;
#ENDIF

end_CheckDead;



start_TabMod;

_IFMemRead=0x408,DWORD,=0; // not modded yet
_MemPattern=7472F30F1005,6,False,True;
#ENDIF

#IF=%Var[PatternFound],>0;
_Calc[Temp]=4294967292-%Var[PatternRet_1];
_Calc[Temp]=%Var[Temp]+0x408;
MemWrite=%Var[PatternRet_1],%Var[Temp],DWORD;
MemWrite=0x408,%Var[TabDistance],FLOAT;
#ENDIF

end_TabMod;


start_Stop;

#IF=%Timer=1801,1200000;
SmartSkill=1801,1200000,6500,False,False;
CreateTimer=1801;
#ELSE
#DO=1200000;
Delay=150;
#UNTIL=%Timer=1801,1200000;
SmartSkill=1801,1200000,6500,False,False;
CreateTimer=1801;
#ENDIF
Delay=4500;

end_Stop;



start_Reset;

#IF=%Timer=1801,1200000;
SmartSkill=1801,1200000,6500,False,False;
CreateTimer=1801;
#ELSE
#DO=1200000;
Delay=150;
#UNTIL=%Timer=1801,1200000;
SmartSkill=1801,1200000,6500,False,False;
CreateTimer=1801;
#ENDIF

Delay=4500;
#LogAddStuck
#EXECUTE=Return;

end_Reset;


start_DetectObelisk;

Command=/select Obelisk;
Command=/select Obélisque;
Command=/select Obelisco;
Delay=125;
_IFMemPtrRead=%TargetBase,%OffsetName,WCHAR[2],=Ob;
#EXECUTE=Return;
#ENDIF

end_DetectObelisk;


start_FindSoulHealer;

MemWrite=%AddrCamY,85,FLOAT;
#DO=7000;
SendKey=0x77;
Delay=35;
_UNTILMemPtrRead=%TargetBase,%OffsetRace,CHAR[10],=soulhealer;
_IFMemPtrRead=%TargetBase,%OffsetRace,CHAR[10],=soulhealer;
#DO=15000;
Command=/attack;
Delay=1550;
DialogClick=NpcFunc30;
Delay=750;
_UNTILMemPtrRead=%AddrFrameID[%ConfirmFrameID],0x28,BYTE,=175;
FrameAction=%ConfirmFrameID,XPOS,0;
FrameAction=%ConfirmFrameID,YPOS,0;
Delay=550;
Mouse=160,95;
Delay=750;
_UNTILMemPtrRead=%PlayerBase,%OffsetPercentHP,BYTE,=100;
_IFMemPtrRead=%PlayerBase,%OffsetPercentHP,BYTE,=100;
#ELSE
SendKey=0x1B;
Delay=15;
SendKey=0x1B;
MemPtrWrite=%AddrFrameName[system_menu_dialog],0x28,142,BYTE;
_ACReg=;
#ENDIF
SendKey=0x1B;
Delay=15;
SendKey=0x1B;
MemPtrWrite=%AddrFrameName[system_menu_dialog],0x28,142,BYTE;
MemWrite=%AddrCamY,25,FLOAT;
//#EXECUTE=CheckAutoLoot;
//#EXECUTE=CheckAutoBuff;

end_FindSoulHealer;


start_CheckAutoLoot;

_IFMemRead=%AddrMinion,BYTE,=0;
_IFMemRead=%AddrPet,BYTE,=0;
#IF=%Var[PetAvailable],=1;
UseID=%Var[PetID],%Var[PetType];
Delay=250;
#ENDIF

MemWrite=%AddrFreeMem30,%AddrPet,DWORD;
_MemReadVar=%AddrFreeMem30,DWORD,CATempAddr;
_Calc[CATempAddr]=%Var[CATempAddr]+748;

_IFMemRead=%Var[CATempAddr],DWORD,=0;
#DO=1000;
UseID=50045;
Delay=250;
_UNTILMemRead=%Var[CATempAddr],DWORD,=1;
#ENDIF

_IFMemRead=%Var[CATempAddr],DWORD,=0;
_ACMob_Looting=True;
#ELSE
_ACMob_Looting=False;
#ENDIF

end_CheckAutoLoot;


start_CheckAutoBuff;

_IFMemRead=%AddrMinion,BYTE,=0;
_IFMemRead=%AddrPet,BYTE,=0;
#IF=%Var[PetAvailable],=1;
UseID=%Var[PetID],%Var[PetType];
Delay=250;
#ENDIF

MemWrite=%AddrFreeMem30,%AddrPet,DWORD;
_MemReadVar=%AddrFreeMem30,DWORD,CATempAddr;
_Calc[CATempAddr]=%Var[CATempAddr]+696;

_IFMemRead=%Var[CATempAddr],DWORD,=0;
#DO=1000;
UseID=50044;
Delay=250;
_UNTILMemRead=%Var[CATempAddr],DWORD,=1;
#ENDIF

end_CheckAutoBuff;


start_GetPetID;

_SetVar=PetAvailable,0;

_IFMemRead=%AddrPet,BYTE,>0;
_SetVar=PetAvailable,1;
MemWrite=%AddrFreeMem30,%AddrPet,DWORD;
_MemReadVar=%AddrFreeMem30,DWORD,CATempAddr;
_Calc[CATempAddr]=%Var[CATempAddr]-4;
_MemReadVar=%Var[CATempAddr],DWORD,PetID;
_SetVar=PetType,46;
#ENDIF

end_GetPetID;


start_InventoryCheck;

_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],8;


#IF=%Var7,=1;
#SetWindow
_MemPtrReadVar=%AddrKinah,%OffsetKinah,DWORD,KinahPrevious;
#EXECUTE=SellToMerchant;
_MemPtrReadVar=%AddrKinah,%OffsetKinah,DWORD,KinahNew;
_Calc[KinahGained]=%Var[KinahNew]-%Var[KinahPrevious];
Speech=%Var8 has sold his cash loot and gained %Var[KinahGained] Kinah.;
#ENDIF

#IF=%Var7,=0;
Speech=%Var8 has full inventory and no sale method, looting will be turned off now;
_ACMob_Looting=False;
#ENDIF

end_InventoryCheck;



start_SellToMerchant;

#SELLMARK

end_SellToMerchant;


start_Return;

#RETURNMARK

end_Return;


start_GetPotionID;
