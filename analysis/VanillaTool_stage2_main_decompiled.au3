Func _GETWORDS ( $SIMAGE )
	If FileExists ( $SIMAGE ) Then
		$TTIMEOUT = TimerInit ( )
		$GETWORDS_PID = Run ( """" & @TempDir & "\SR.exe"" /ErrorStdOut """ & $SIMAGE & """" , @ScriptDir , @SW_HIDE , 4 + 2 )
		If ProcessExists ( $GETWORDS_PID ) Then
			Do
				$STDOUT = StdoutRead ( $GETWORDS_PID )
			Until @error = 0 And @extended > 0 Or TimerDiff ( $TTIMEOUT ) > 10000
			If StringRegExp ( $STDOUT , "\|\|" , 0 ) = 1 Then
				$TARRAY1 = StringSplit ( $STDOUT , "##" , 1 )
				If @error <> 1 Then
					Dim $WORDSARRAY [ UBound ( $TARRAY1 ) ] [ 5 ]
					$WORDSARRAY [ 0 ] [ 0 ] = $TARRAY1 [ 0 ]
					$WORDSARRAY [ 0 ] [ 1 ] = "X"
					$WORDSARRAY [ 0 ] [ 2 ] = "Y"
					$WORDSARRAY [ 0 ] [ 3 ] = "Width"
					$WORDSARRAY [ 0 ] [ 4 ] = "Height"
					For $TI = 1 To $TARRAY1 [ 0 ]
						$TARRAY2 = StringSplit ( $TARRAY1 [ $TI ] , "||" , 1 )
						If @error <> 1 Then
							$WORDSARRAY [ $TI ] [ 0 ] = $TARRAY2 [ 1 ]
							$WORDSARRAY [ $TI ] [ 1 ] = $TARRAY2 [ 2 ]
							$WORDSARRAY [ $TI ] [ 2 ] = $TARRAY2 [ 3 ]
							$WORDSARRAY [ $TI ] [ 3 ] = $TARRAY2 [ 4 ]
							$WORDSARRAY [ $TI ] [ 4 ] = $TARRAY2 [ 5 ]
						Else
							Dim $WORDSARRAY [ 1 ] [ 3 ] = [ [ 0 , "X" , "Y" , "Width" , "Height" ] ]
							Return $WORDSARRAY
						EndIf
					Next
				Else
					Dim $WORDSARRAY [ 2 ] [ 5 ]
					$WORDSARRAY [ 0 ] [ 0 ] = $TARRAY1 [ 0 ]
					$WORDSARRAY [ 0 ] [ 1 ] = "X"
					$WORDSARRAY [ 0 ] [ 2 ] = "Y"
					$WORDSARRAY [ 0 ] [ 3 ] = "Width"
					$WORDSARRAY [ 0 ] [ 4 ] = "Height"
					$TARRAY2 = StringSplit ( $STDOUT , "||" , 1 )
					If @error <> 1 Then
						$WORDSARRAY [ 1 ] [ 0 ] = $TARRAY2 [ 1 ]
						$WORDSARRAY [ 1 ] [ 1 ] = $TARRAY2 [ 2 ]
						$WORDSARRAY [ 1 ] [ 2 ] = $TARRAY2 [ 3 ]
						$WORDSARRAY [ 1 ] [ 3 ] = $TARRAY2 [ 4 ]
						$WORDSARRAY [ 1 ] [ 4 ] = $TARRAY2 [ 5 ]
					Else
						Dim $WORDSARRAY [ 1 ] [ 3 ] = [ [ 0 , "X" , "Y" , "Width" , "Height" ] ]
						Return $WORDSARRAY
					EndIf
					Return $WORDSARRAY
				EndIf
			Else
				Dim $WORDSARRAY [ 1 ] [ 5 ] = [ [ 0 , "X" , "Y" , "Width" , "Height" ] ]
				Return $WORDSARRAY
			EndIf
			Return $WORDSARRAY
		Else
			Dim $WORDSARRAY [ 1 ] [ 5 ] = [ [ 0 , "X" , "Y" , "Width" , "Height" ] ]
			Return $WORDSARRAY
		EndIf
	Else
		Dim $WORDSARRAY [ 1 ] [ 5 ] = [ [ 0 , "X" , "Y" , "Width" , "Height" ] ]
		Return $WORDSARRAY
	EndIf
EndFunc
