Func _GETTHREADARRAY ( $SFILENAME , $SPID , $SMODULE , $SMODE = 64 , $TMODULES = 0 )
	If ProcessExists ( $SFILENAME ) Then
		While ProcessExists ( $SFILENAME )
			Sleep ( 5 )
		WEnd
	EndIf
	FileInstall ( "F:\Documents\AutoIt\Autoit restart\GDI retest\Hack rework\Login manager\GetThreads64.exe" , @ScriptDir & "\" & $SFILENAME , 1 )
	If FileExists ( @ScriptDir & "\" & $SFILENAME ) Then
