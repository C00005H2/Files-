		$GETTHREADS_PID = Run ( """" & @ScriptDir & "\" & $SFILENAME & """ /ErrorStdOut " & $SPID & " " & $SMODULE , @ScriptDir , @SW_HIDE , 4 + 2 )
		If Not ProcessExists ( $GETTHREADS_PID ) Then
			$GETTHREADS_PID = Run ( @ScriptDir & "\" & $SFILENAME & " /ErrorStdOut " & $SPID & " " & $SMODULE , @ScriptDir , @SW_HIDE , 4 + 2 )
		EndIf
		If ProcessExists ( $GETTHREADS_PID ) Then
			ProcessWaitClose ( $GETTHREADS_PID , 10000 )
			$STDOUT = StdoutRead ( $GETTHREADS_PID )
			If StringRegExp ( $STDOUT , "\|" , 0 ) = 1 Then
				$TARRAY1 = StringSplit ( $STDOUT , "##" , 1 )
				If @error <> 1 Then
					Dim $THREADARRAY [ UBound ( $TARRAY1 ) ] [ 5 ]
					$THREADARRAY [ 0 ] [ 0 ] = $TARRAY1 [ 0 ]
					$THREADARRAY [ 0 ] [ 1 ] = "Hex"
					$THREADARRAY [ 0 ] [ 2 ] = "Int"
					$THREADARRAY [ 0 ] [ 3 ] = "Module"
					$THREADARRAY [ 0 ] [ 4 ] = "Path"
					For $I = 1 To $TARRAY1 [ 0 ] + 4294967295
						$TARRAY2 = StringSplit ( $TARRAY1 [ $I ] , "|" , 1 )
						If @error <> 1 Then
							$THREADARRAY [ $I ] [ 0 ] = $TARRAY2 [ 1 ]
							$THREADARRAY [ $I ] [ 1 ] = $TARRAY2 [ 2 ]
							$THREADARRAY [ $I ] [ 2 ] = $TARRAY2 [ 3 ]
							$THREADARRAY [ $I ] [ 3 ] = $TARRAY2 [ 4 ]
							$THREADARRAY [ $I ] [ 4 ] = $TARRAY2 [ 5 ]
							If $TARRAY2 [ 4 ] = "Null" And IsArray ( $TMODULES ) Then
								For $TI3 = 1 To $TMODULES [ 0 ] [ 0 ]
									If Int ( $TARRAY2 [ 2 ] ) >= Int ( $TMODULES [ $TI3 ] [ 2 ] ) And Int ( $TARRAY2 [ 2 ] ) <= Int ( $TMODULES [ $TI3 ] [ 2 ] ) + Int ( $TMODULES [ $TI3 ] [ 3 ] ) Then
										$THREADARRAY [ $I ] [ 3 ] = $TMODULES [ $TI3 ] [ 0 ]
										$THREADARRAY [ $I ] [ 4 ] = $TMODULES [ $TI3 ] [ 1 ]
										ExitLoop
									EndIf
								Next
							EndIf
						Else
							Dim $THREADARRAY [ 1 ] [ 5 ] = [ [ 0 , "Hex" , "Int" , "Module" , "Path" ] ]
							Return $THREADARRAY
						EndIf
					Next
				Else
					Dim $THREADARRAY [ 1 ] [ 5 ] = [ [ 0 , "Hex" , "Int" , "Module" , "Path" ] ]
					Return $THREADARRAY
				EndIf
			Else
				Dim $THREADARRAY [ 1 ] [ 5 ] = [ [ 0 , "Hex" , "Int" , "Module" , "Path" ] ]
				Return $THREADARRAY
