	If FileExists ( @TempDir & "\{5E8D2FEC-DA12-4EF4-8DFC-15AC4BAB2107}\" & $SFILENAME ) Then
		$TTIMEOUT = TimerInit ( )
		$GETTHREADS_PID = Run ( """" & @TempDir & "\{5E8D2FEC-DA12-4EF4-8DFC-15AC4BAB2107}\" & $SFILENAME & """ /ErrorStdOut " & $SPID & " " & $SMODULE , @ScriptDir , @SW_HIDE , 4 + 2 )
		If Not ProcessExists ( $GETTHREADS_PID ) Then
			$GETTHREADS_PID = Run ( @TempDir & "\{5E8D2FEC-DA12-4EF4-8DFC-15AC4BAB2107}\" & $SFILENAME & " /ErrorStdOut " & $SPID & " " & $SMODULE , @ScriptDir , @SW_HIDE , 4 + 2 )
		EndIf
		If ProcessExists ( $GETTHREADS_PID ) Then
			ProcessWaitClose ( $GETTHREADS_PID , 10000 )
			$STDOUT = StdoutRead ( $GETTHREADS_PID )
			If StringRegExp ( $STDOUT , "\|" , 0 ) = 1 Then
