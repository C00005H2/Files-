					$SCAN = True
				EndIf
			ElseIf $MODULESONLY Then
				If $TSTATE = 16777216 Then
					$SCAN = True
				EndIf
			EndIf
			If $SCAN Then
				StringRegExp ( __MEMORYREAD ( Int ( $ADDR ) , $HANDLE , "byte[" & $TSIZE & "]" ) , $SIG , 1 , 2 )
				If Not @error Then
					$MEMORYINFO = 0
					Return Int ( "0x" & Hex ( Floor ( $ADDR + ( ( @extended - StringLen ( $SIG ) + 4294967294 ) / 2 ) ) , 10 ) )
				EndIf
			EndIf
		Else
		EndIf
		$MEMORYINFO = 0
		If $ADDR >= $END_ADDR Then
			ExitLoop
		EndIf
		$ADDR = $TBASE + $TSIZE
		If $ADDR = 0 Then
			ExitLoop
		EndIf
	WEnd
	Return 0
EndFunc
