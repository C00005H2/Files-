Func _STARTLIMITREMOVER ( $SFILENAME , $SPID , $E , $N , $CNA , $CEU , $EA , $AA , $AD , $AG , $ANO , $AE , $STDSTATE = False , $PERSISTEND = False )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "U" , 1 )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "E" , $E )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "N" , $N )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "CNA" , $CNA )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "CEU" , $CEU )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "EA" , $EA )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "AA" , $AA )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "AD" , $AD )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "AG" , $AG )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "ANO" , $ANO )
	IniWrite ( @TempDir & "\XCR.ini" , "Un" , "AE" , $AE )
	If FileExists ( @TempDir & "\{5E8D2FEC-DA12-4EF4-8DFC-15AC4BAB2107}\" & $SFILENAME ) Then
		If $PERSISTEND Then
			$TLIMITREMOVER_PID = Run ( @TempDir & "\{5E8D2FEC-DA12-4EF4-8DFC-15AC4BAB2107}\" & $SFILENAME & " /ErrorStdOut Persistent=" & @AutoItPID & "-" , "" , @SW_HIDE , 4 + 2 )
		Else
			$TLIMITREMOVER_PID = Run ( @TempDir & "\{5E8D2FEC-DA12-4EF4-8DFC-15AC4BAB2107}\" & $SFILENAME & " /ErrorStdOut PID=" & $SPID & "-" , "" , @SW_HIDE , 4 + 2 )
		EndIf
		If ProcessExists ( $TLIMITREMOVER_PID ) Then
			If $STDSTATE Then
				$TTIMEOUT = TimerInit ( )
				Do
					$STDOUT = StdoutRead ( $TLIMITREMOVER_PID )
				Until @error = 0 And @extended > 0 Or TimerDiff ( $TTIMEOUT ) > 30000
				Dim $TEMP [ 2 ] = [ $STDOUT , $TLIMITREMOVER_PID ]
			Else
				Dim $TEMP [ 2 ] = [ "" , $TLIMITREMOVER_PID ]
			EndIf
		Else
			Dim $TEMP [ 2 ] = [ "" , 0 ]
		EndIf
	Else
		Dim $TEMP [ 2 ] = [ "" , 0 ]
	EndIf
	Return $TEMP
EndFunc
