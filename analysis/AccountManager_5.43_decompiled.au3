		$RET = DllCall ( "kernel32.dll" , "boolean" , "VirtualQueryEx" , "handle" , $HANDLE [ 1 ] , "ptr" , Int ( $ADDR ) , "ptr" , DllStructGetPtr ( $MEMORYINFO ) , "ulong_ptr" , DllStructGetSize ( $MEMORYINFO ) )
		$TSIZE = Int ( DllStructGetData ( $MEMORYINFO , "RegionSize" ) )
		$TBASE = Int ( DllStructGetData ( $MEMORYINFO , "BaseAddress" ) )
		$TSTATE = Int ( DllStructGetData ( $MEMORYINFO , "State" ) )
		$TPARTITIONID = Int ( DllStructGetData ( $MEMORYINFO , "PartitionId" ) )
		If BitAND ( 4096 , $TPARTITIONID ) And $TPARTITIONID < Int ( "0x10000000000" ) Then
