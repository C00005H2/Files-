// - Supports Reshanta Icon/Seal NPCs
// - Supports Gelk/Ingg Icon/Seal NPCs
// - Supports Abyss Core Crown/Goblet NPCs
// - Stand next to respective NPC and hit play

#IF=%FirstTime,;
#SetWindow
Command=;
Print=;
#EXECUTE=GetAP;
_SetVar=Finished,False;
#ENDIF

_SetVar=GobletNPC,Amarunerk; // Abyss Core
_SetVar=CrownNPC,Momorinrinerk; // Abyss Core

_IFMemPtrRead=%PlayerBase,%OffsetRace,BYTE,=68;  // Asmo
_SetVar=IconNPC,Byrgafa;
_SetVar=SealNPC,Bakan;
#ELSE // Reshanta Main Base NPCs
_SetVar=IconNPC,Iacchus;
_SetVar=SealNPC,Ceres;
#ENDIF

_IFMemRead=%AddrMap,DWORD,=210050000; // Inggison - Maint Fort NPCs
_SetVar=IconNPC,Fillia;
_SetVar=SealNPC,Elrin;
#ENDIF

_IFMemRead=%AddrMap,DWORD,=220070000; // Gelkmaros - Maint Fort NPCs
_SetVar=IconNPC,Frigga;
_SetVar=SealNPC,Taegir;
#ENDIF

Command=/select %Var[IconNPC];
Delay=222;
#IF=%TargetName,%Var[IconNPC];
GoTowardsTarget=<4,10000;
#IF=%TargetDistance,<5;
#EXECUTE=IconsSeals;
#EXECUTE=GetAP;
#ENDIF

Command=/select %Var[GobletNPC];
Delay=222;
#IF=%TargetName,%Var[GobletNPC];
GoTowardsTarget=<4,10000;
#IF=%TargetDistance,<5;
#EXECUTE=GobletsCrowns;
#EXECUTE=GetAP;
#ENDIF

WaitForResponse=Stand close next to NPC and start script again;
#EndScript

/////////////////////////////////
////////////////////////////////

start_IconsSeals;

#DO=9999000;
_IFInventoryContains=186000066; // Lesser icon
_SetVar=Temp,0;
Command=/Select %Var[IconNPC];
Delay=111;
Command=/attack;
Delay=333;
DialogClick=NpcFunc54;
Delay=333;
DialogClick=select1;
Delay=333;
FrameActionByName=dlg_dialog,XPOS,0;
FrameActionByName=dlg_dialog,YPOS,0;
Delay=333;
Mouse=190,310;
Delay=333;
#EXECUTE=CloseWindows;
#ELSE
_SetVar=Temp,1;
#ENDIF
#UNTIL=%Var[Temp],=1;

