//

start_GetAP;

#IF=%Var[Finished],=True;
_Calc[AddrAP]=%AddrHidePlayer-0xBC;
_MemReadVar=%Var[AddrAP],DWORD,EndingAP; // ending AP
_Calc[GainedAP]=%Var[EndingAP]-%Var[StartingAP]; // Calculates AP gain
Print=Starting AP = %Var[StartingAP]/nEnding AP = %Var[EndingAP]/n/nAP Gained = %Var[GainedAP];
#EndScript
#ELSE
_Calc[AddrAP]=%AddrHidePlayer-0xBC;
_MemReadVar=%Var[AddrAP],DWORD,StartingAP; // AP
#ENDIF

end_GetAP;

//

start_CloseWindows;

#DO=1500;
SendKey=0x1B;
Delay=1;
_UNTILMemPtrRead=%AddrESChwnd,%OffsetESChwnd,BYTE,=175;
Delay=15;
MemPtrWrite=%AddrESChwnd,%OffsetESChwnd,142,BYTE;

end_CloseWindows;
