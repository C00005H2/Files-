start_InstaScriptLogin;

_SetVar=ScriptTitle,AutoMorph; // Scriptname used for Logs or Script Editor title
_SetVar39=Charactername,Othername,Anothername; // Logs on Characters with certain name
_SetVar=Required_Level,>8; // Logs on Characters on certain level condition (Example conditions: ">0" or "<50" or "5-10" or "=50")

CreateTimer=997;
#EXECUTE=GetOffsets;
#EXECUTE=HidePlayers;

