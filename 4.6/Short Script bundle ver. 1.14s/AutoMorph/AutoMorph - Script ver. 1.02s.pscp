//##################InstaScript Settings###################

#IF=%FirstTime,;
#SmoothBackground
_SetVar=UserPIN,0000001; // Your PIN
_SetVar=FPSCap,20; // Limits the FPS
_SetVar=Loop,0; // 0 = Log trough all characters | 1 = Loop on the same character
_SetVar=QuitClient,1; // exit aion when script finished - 0 = No | 1 = Yes
_SetVar=HidePlayers,1; // Hides other Players - 0 = No | 1 = Yes
_SetVar=StatusInvisible,1; // Sets Status to Invisible on friendlist - 0 = No | 1 = Yes
_SetVar=DiscordURL,0; // Enter your Discord Webhook URL for Discord messages, otherwise enter 0 ( more information at https://vanillatool.com/discord )
_SetVar=Morph,1; // Want to morph when ever DP is full? - 0 = No | 1 = Yes
_SetVar=RecipeID,155000001; // Which Recipe ID you want to morph? - you find them at https://aioncodex.com/usc/recipes/convert/
#EXECUTE=AccountSettings; // Scroll at the very end to setup account specific settings
#EXECUTE=InstaScriptLogin;
#ENDIF

//##################END Settings###################



//################## Startup ###################

#DO=20000;
Delay=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetAFK,FLOAT,3-10;

#IF=%FirstTime,;
#SetWindow
#UseLoop
UseSpeed=170;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
_SetVar=HasMorphed,0;
_SetVar=FirstChar,%Var[PlayerName];
SetScriptTitle=%AionTitle::%Var[PlayerName] - %Var[ScriptTitle];
//_SetVar40=%Var40,%Var[PlayerName]; // adds Charactername to logging blacklist for next ChangeCharacter call
Command=;
#EXECUTE=HidePlayers;
#IF=%IsInstaScript,=0; // If script got loaded manually
#EXECUTE=MorphSetup;
#ENDIF

//#EXECUTE=CombatSort;
#EXECUTE=CloseWindows;
#EXECUTE=SetStatusInvisible;

//############### END Startup ###############



//############## Your Main Code Here ################

#IF=%Var[Loop],=0;
#EXECUTE=Morph;
#ELSE
#DO=9999999999;
#EXECUTE=Morph;
Delay=10000;
#UNTIL=1,=2;
#ENDIF









//################# END Main Code ##################


























CreateTimer=44; // Starts timeout to prevent infinite stuck in changechar function
#EXECUTE=ChangeCharacter;
#EndScript




//############### FUNCTIONS #############




start_MorphSetup;

Delay=1000;
UseID=40009,21;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Frame_XPos],0,FLOAT;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Frame_YPos],0,FLOAT;
Delay=2000;
Print=Select your desired morph design and hit "Del";
TrayInfo=Select your desired morph design and hit "Del";
WaitForKey=2E,1;
_IFKey=2E,1;
_MemPtrReadVar=%AddrFrameName[tool_making_dialog],%Var[Offset_Morph_ID],DWORD,RecipeID;
#ENDIF

#EXECUTE=CloseWindows;

end_MorphSetup;



start_Morph;

#IF=%Var[Morph],=0;
#Return
#ENDIF

#IF=%Var[HasMorphed],=1;
_IFMemPtrRead=%PlayerBase,%OffsetName,WCHAR[32],=%Var[FirstChar];
#DO=1800000;
//SendKey=0x76; <- F7
//Delay=50;
SendKey=0x49; <- I
Delay=50;
SendKey=0x50; <- P
Delay=2000;
GetCooldown=160001274,Jelly_CD_1;
GetCooldown=160002274,Jelly_CD_2;
GetCooldown=160001273,Jelly_CD_3;
GetCooldown=160002273,Jelly_CD_4;
_Calc[Jelly_CD]=%Var[Jelly_CD_1]+%Var[Jelly_CD_2];
_Calc[Jelly_CD]=%Var[Jelly_CD]+%Var[Jelly_CD_3];
_Calc[Jelly_CD]=%Var[Jelly_CD]+%Var[Jelly_CD_4];
#UNTIL=%Var[Jelly_CD],=0;
#EXECUTE=CloseWindows;
Delay=500;
#ENDIF


GetCooldown=160001274,Jelly_CD_1;
GetCooldown=160002274,Jelly_CD_2;
GetCooldown=160001273,Jelly_CD_3;
GetCooldown=160002273,Jelly_CD_4;
_Calc[Jelly_CD]=%Var[Jelly_CD_1]+%Var[Jelly_CD_2];
_Calc[Jelly_CD]=%Var[Jelly_CD]+%Var[Jelly_CD_3];
_Calc[Jelly_CD]=%Var[Jelly_CD]+%Var[Jelly_CD_4];
#IF=%Var[Jelly_CD],1-60000;
Delay=%Var[Jelly_CD];
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,>199;
#EXECUTE=SheatheWeapon;
#SetWindow
UseID=40009,21;
Delay=1000;
_IFFrameVisibleByName=tool_making_dialog;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Frame_XPos],0,FLOAT;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Frame_YPos],0,FLOAT;
Delay=1250;
Mouse=125,94; // First recipe
Delay=1000;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Morph_ID],%Var[RecipeID],DWORD;
_MemPtrReadVar=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,CurrentDP;
_Calc[MorphAmount]=%Var[CurrentDP]/200;
_RegExp=%Var[MorphAmount],^([0-9]+),MorphAmount; // Remove Comma
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Morph_Amount],%Var[MorphAmount],BYTE;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Morph_CraftAll],7,BYTE;
Delay=200;
Mouse=273,352; // Craft All
Delay=350;
Mouse=273,352; // Craft All
Delay=2000;
#EXECUTE=WaitForCraft;
Delay=1000;
#ENDIF

#DO=5000;
_IFMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,<4000;
_IFInventoryContains=160001274,1;
GetCooldown=160001274,Jelly_CD;
#IF=%Var[Jelly_CD],=0;
UseID=160001274; // Jelly ID
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,<4000;
_IFInventoryContains=160002274,1;
GetCooldown=160002274,Jelly_CD;
#IF=%Var[Jelly_CD],=0;
UseID=160002274; // Jelly ID
#ENDIF
_IFInventoryContains=160001273,1;
GetCooldown=160001273,Jelly_CD;
#IF=%Var[Jelly_CD],=0;
UseID=160001273; // Jelly ID
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,<4000;
_IFInventoryContains=160002273,1;
GetCooldown=160002273,Jelly_CD;
#IF=%Var[Jelly_CD],=0;
UseID=160002273; // Jelly ID
#ENDIF
_UNTILMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,>199;

_IFMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,>199;
#EXECUTE=SheatheWeapon;
#SetWindow
UseID=40009,21;
Delay=1000;
_IFFrameVisibleByName=tool_making_dialog;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Frame_XPos],0,FLOAT;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Frame_YPos],0,FLOAT;
Delay=1250;
Mouse=125,94; // First recipe
Delay=1000;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Morph_ID],%Var[RecipeID],DWORD;
_MemPtrReadVar=%PlayerBase,%OffsetData/%Var[Offset_Base_DP],DWORD,CurrentDP;
_Calc[MorphAmount]=%Var[CurrentDP]/200;
_RegExp=%Var[MorphAmount],^([0-9]+),MorphAmount; // Remove Comma
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Morph_Amount],%Var[MorphAmount],BYTE;
MemPtrWrite=%AddrFrameName[tool_making_dialog],%Var[Offset_Morph_CraftAll],7,BYTE;
Delay=200;
Mouse=273,352; // Craft All
Delay=350;
Mouse=273,352; // Craft All
Delay=2000;
#EXECUTE=WaitForCraft;
Delay=1000;
#ENDIF

_SetVar=HasMorphed,1;
#EXECUTE=CloseWindows;

end_Morph;


start_WaitForCraft;

#IF=%Var[Animation],=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],10,FLOAT; // 10x Animationspeed
#ENDIF

#DO=1000;
Delay=50;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=6;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=6;
#DO=300000;
Delay=1000;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=0;
Delay=2750;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=0;
Delay=250;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=0;
Delay=250;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=0;

#IF=%Var[Animation],=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],1,FLOAT; // Normal Animationspeed
#ENDIF

end_WaitForCraft;


start_SheatheWeapon;

_SetVar=temp_shard,0;
#DO=4000;
_IFMemPtrRead=%PlayerBase,%OffsetData/0x38,BYTE,=33; // combat mode without shard
UseID=50000;
Delay=1500;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetData/0x38,BYTE,=161; // combat mode with shard
UseID=50000;
Delay=1500;
#ENDIF
Delay=1500;
_IFMemPtrRead=%PlayerBase,%OffsetData/0x38,BYTE,=129;
_SetVar=temp_shard,1;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetData/0x38,BYTE,=1;
_SetVar=temp_shard,1;
#ENDIF
#UNTIL=%Var[temp_shard],=1;

end_SheatheWeapon;


start_CombatSort;

