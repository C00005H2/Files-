start_IsQuestComplete;

_MemPtrReadVar=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_XPos],FLOAT,XPosCache;
_MemPtrReadVar=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_YPos],FLOAT,YPosCache;
MemPtrWrite=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_XPos],0,FLOAT;
MemPtrWrite=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_YPos],0,FLOAT;

#DO=5000;
SendKey=0x0D;
Delay=125;
_UNTILMemPtrRead=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_State],BYTE,=7;
SendKey=123456789012345;
#DO=10000;
Delay=100;
_UNTILMemPtrRead=%AddrFrameName[chat_input_dialog],%Var[Offset_ChatText],WCHAR[128],=123456789012345;
MemPtrWrite=%AddrFrameName[chat_input_dialog],%Var[Offset_ChatText],[quest:%Var[QuestID]],WCHAR[16];
Delay=50;
SendKey=1;
MemPtrWrite=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_State],15,BYTE;
Delay=150;
Mouse=63,8;
Delay=250;
_IFFrameVisibleByName=quest_summary_dialog;
_MemPtrReadVar=%AddrFrameName[quest_summary_dialog],%Var[Offset_Quest_Name],WCHAR[256],QuestName;
_MemPtrReadVar=%AddrFrameName[quest_summary_dialog],%Var[Offset_Quest_Complete],BYTE,QuestComplete;
#ELSE
_SetVar=QuestName,Quest not found;
_SetVar=QuestComplete,-1;
#ENDIF

#IF=%Var[QuestComplete],>1;
_SetVar=QuestComplete,1;
#ELSE
_SetVar=QuestComplete,0;
#ENDIF

#DO=10000;
SendKey=0x08; // backspace
Delay=10;
_UNTILMemPtrRead=%AddrFrameName[chat_input_dialog],%Var[Offset_ChatText],WORD,=0;

MemPtrWrite=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_XPos],%Var[XPosCache],FLOAT;
MemPtrWrite=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_YPos],%Var[YPosCache],FLOAT;
MemPtrWrite=%AddrFrameName[chat_input_dialog],%Var[Offset_Frame_State],7,BYTE;  // do not force foreground, fix for Command=

MemPtrWrite=%AddrFrameName[system_menu_dialog],%Var[Offset_Frame_State],142,BYTE;
#DO=5000;
SendKey=0x1B; // ESC
Delay=1;
_UNTILMemPtrRead=%AddrFrameName[system_menu_dialog],%Var[Offset_Frame_State],BYTE,=175;
MemPtrWrite=%AddrFrameName[system_menu_dialog],%Var[Offset_Frame_State],142,BYTE;

end_IsQuestComplete;


start_SelectChar;
//Requires [Required_Name], [Required_Level]
//Uses [Array3], [%Var31], [%Var40], [%Var39], [OffsetStep], [CharacterName_%i], [CharacterLevel_%i], [CharacterClassID_%i]
//Returns [ReturnSlot]

_MemPtrReadVar=%AddrUsers,0x15C,DWORD,CharacterAmount; // Reads current rendered Entity Amount to CharacterAmount variable
_Calc[ScreenCharSlotAddress]=%AddrCharSlot-%Var[Offset_CharSelection_Array];
_SetVar31=0;

#DO=30000;
_Calc[OffsetStep]=%Var31*8;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Name],WCHAR[32],CharacterName_%Var31;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Level],BYTE,CharacterLevel_%Var31;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Class],BYTE,CharacterClassID_%Var31;

_SetArray3=999,%Var40; // already logged list
#IF=%Var[CharacterName_%Var31],%ARRAY3;
#ELSE
_SetArray3=999,%Var39; // character name whitelist
#IF=%Var[CharacterName_%Var31],%ARRAY3;
//_SetVar40=%Var40,%Var[CharacterName_%Var31];
_SetVar=ReturnSlot,%Var31;
#Return
#ENDIF

_SetArray3=999,%Var40; // already logged list
#IF=%Var[CharacterName_%Var31],%ARRAY3;
#ELSE
#IF=%Var[CharacterLevel_%Var31],%Var[Required_Level];
//_SetVar40=%Var40,%Var[CharacterName_%Var31];
_SetVar=ReturnSlot,%Var31;
#Return
#ENDIF

_Calc31=%Var31+1;
#UNTIL=%Var31,=%Var[CharacterAmount];

_SetVar=ReturnSlot,-1;

end_SelectChar;


start_SelectSlot;

Mouse=146,499; // Second Slot
Delay=550;
_MemPtrReadVar=%AddrUsers,0x15C,DWORD,CharacterAmount;
_Calc[CharacterAmountTemp]=%Var[CharacterAmount]-1;
MemWrite=%AddrCharSlot,%Var[CharacterAmountTemp],DWORD;

end_SelectSlot;


start_HidePlayers;

