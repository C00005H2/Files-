#IF=%FirstTime,;
UseSpeed=1;
_SetArray1=100000,100001,100002,100003;
_SetVar=Gear1,0x1220; // Weapon Main
_Calc[Gear2]=%Var[Gear1]+0x4; // Godstone Main
_Calc[Gear3]=%Var[Gear1]+0x10; // Weapon Offhand
_Calc[Gear4]=%Var[Gear1]+0x14; // Godstone Offhand
_Calc[Gear5]=%Var[Gear1]+0x20; // Head
_Calc[Gear6]=%Var[Gear1]+0x30; // Torso
_Calc[Gear7]=%Var[Gear1]+0x40; // Arms
_Calc[Gear8]=%Var[Gear1]+0x50; // Shoes
_Calc[Gear9]=%Var[Gear1]+0x60; // Earring Left
_Calc[Gear10]=%Var[Gear1]+0x70; // Earring Right
_Calc[Gear11]=%Var[Gear1]+0x80; // Ring Left
_Calc[Gear12]=%Var[Gear1]+0x90; // Ring Right
_Calc[Gear13]=%Var[Gear1]+0xA0; // Necklace
_Calc[Gear14]=%Var[Gear1]+0xB0; // Shoulder
_Calc[Gear15]=%Var[Gear1]+0xC0; // Waist
_Calc[Gear16]=%Var[Gear1]+0xD0; // Shards Left
_Calc[Gear17]=%Var[Gear1]+0xE0; // Shards Right
_Calc[Gear18]=%Var[Gear1]+0xF0; // Wings
_Calc[Gear19]=%Var[Gear1]+0x130; // Plume
_SetVar=TargetNameCache,---;
_SetVar=LangCode,4x;
#ENDIF

#DO=9999999999;
_IFMemPtrRead=%TargetBase,%OffsetData/0x34,DWORD,%ARRAY1;
_MemPtrReadVar=%TargetBase,%OffsetName,WCHAR[64],TargetName;
#EXECUTE=GetTargetGear;
#ENDIF
Delay=250;
#UNTIL=1,=2;



start_GetTargetGear;



#IF=%Var[TargetName],=;
#Return
#ENDIF

#IF=%Var[TargetName],=%Var[TargetNameCache];
#Return
#ELSE
_SetVar=TargetNameCache,%Var[TargetName];
#ENDIF

_SetVar1=1;
#DO=5000;
_MemPtrReadVar=%TargetBase,%OffsetData/%Var[Gear%Var1],DWORD,ID_Gear%Var1;
_Calc1=%Var1+1;
#UNTIL=%Var1,=20;
Display=Translating...,0,0,Gear Translation: %Var[TargetName];

_SetVar1=1;
#DO=15000;
Display=Translating... (%Var1/19),0,0,Gear Translation: %Var[TargetName];
#IF=%Var[ID_Gear%Var1],=0;
_SetVar=Name_Gear%Var1,;
#ELSE
_HTTPGetVar=https://aioncodex.com/%Var[LangCode]/item/%Var[ID_Gear%Var1]/,,Name_Gear%Var1,id="item_name"><b>(.*?)</b></span>;
#ENDIF
_Calc1=%Var1+1;
#UNTIL=%Var1,=20;
Display=Weapon Main = %Var[Name_Gear1]/nGodstone Main = %Var[Name_Gear2]/nWeapon Offhand = %Var[Name_Gear3]/nGodstone Offhand = %Var[Name_Gear4]/nHead = %Var[Name_Gear5]/nTorso = %Var[Name_Gear6]/nArms = %Var[Name_Gear7]/nShoes = %Var[Name_Gear8]/nEarring Left = %Var[Name_Gear9]/nEarring Right = %Var[Name_Gear10]/nRing Left = %Var[Name_Gear11]/nRing Right = %Var[Name_Gear12]/nNecklace = %Var[Name_Gear13]/nShoulder = %Var[Name_Gear14]/nWaist = %Var[Name_Gear15]/nShards Left = %Var[Name_Gear16]/nShards Right = %Var[Name_Gear17]/nWings = %Var[Name_Gear18]/nPlume = %Var[Name_Gear19],0,0,Gear Inspector: %Var[TargetName];

end_GetTargetGear;
