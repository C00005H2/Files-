#IF=%FirstTime,;
#UseLoop
UseSpeed=1;
#EXECUTE=GetItemID;
_SetVar=CastTime,3500;
_SetVar2=1;
#EXECUTE=FirstUse;
#ENDIF

#IF=%Var[ItemID%Var2],=;
#UseNoLoop
#EndScript
#ENDIF
#IF=%Var[ItemID%Var2],=0;
#UseNoLoop
#EndScript
#ENDIF

_Calc[DeltaTime]=%Var[CastTime]+1000;
#IF=%Var[Amount%Var2],>0;
#EXECUTE=OpenQuantity;
#ELSE
#EXECUTE=OpenTillEmpty;
#ENDIF

_Calc2=%Var2+1;
#IF=%Var2,>%Var1;
#UseNoLoop
#EndScript
#ENDIF
#EXECUTE=FirstUse;


start_FirstUse;

#DO=15000;
MemPtrWrite=%PlayerBase,%OffsetActionID,15,BYTE;
Delay=3500;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID3,DWORD,=15;

//_MemPtrReadVar=%PlayerBase,%OffsetActionID,BYTE,ActionId;
//WaitForResponse=%Var[ActionId];
_IFInventoryContains=%Var[ItemID%Var2];
#ELSE
#UseNoLoop
#EndScript
#ENDIF

#IF=%Var[Amount%Var2],=;
_SetVar=Amount%Var2,0;
#ENDIF

_IFInventoryContains=%Var[ItemID%Var2];
UseID=%Var[ItemID%Var2];
Delay=500;
_Calc[Amount%Var2]=%Var[Amount%Var2]-1;
_IFMemPtrRead=%PlayerBase,%OffsetCastTime,DWORD,>500;
_MemPtrReadVar=%PlayerBase,%OffsetCastTime,DWORD,CastTime;
Delay=%Var[CastTime];
Delay=500;
MemPtrWrite=%PlayerBase,%OffsetActionID,14,BYTE;
#DO=5000;
Delay=3000;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID3,DWORD,=14;
#ENDIF

end_FirstUse;

start_OpenQuantity;

_IFInventoryContains=%Var[ItemID%Var2];
_GetInventoryItemHandle=%Var[ItemID%Var2];
#ELSE
#Return
#ENDIF

#IF=%VarItemAmount,<%Var[Amount%Var2];
_SetVar=Amount%Var2,%VarItemAmount;
#ENDIF
_Calc[SaveQuantity]=%VarItemAmount-%Var[Amount%Var2];
_Calc[SaveQuantity]=%Var[SaveQuantity]+1;
_Calc[LoopTime]=%Var[Amount%Var2]*%Var[DeltaTime];

#DO=%Var[LoopTime];
_IFInventoryContains=%Var[ItemID%Var2];
UseID=%Var[ItemID%Var2];
Delay=%Var[CastTime];
#ELSE
#Return
#ENDIF
_GetInventoryItemHandle=%Var[ItemID%Var2];
#UNTIL=%Var[SaveQuantity],=%VarItemAmount;
Delay=500;
_IFInventoryContains=%Var[ItemID%Var2];
_GetInventoryItemHandle=%Var[ItemID%Var2];
#ELSE
#Return
#ENDIF

#IF=%VarItemAmount,<%Var[SaveQuantity];
#ELSE
UseID=%Var[ItemID%Var2];
Delay=%Var[CastTime];
#ENDIF

end_OpenQuantity;

start_OpenTillEmpty;

_GetInventoryItemHandle=%Var[ItemID%Var2];
_Calc[LoopTime]=%VarItemAmount*%Var[DeltaTime];
#DO=%Var[LoopTime];
_IFInventoryContains=%Var[ItemID%Var2];
UseID=%Var[ItemID%Var2];
Delay=%Var[CastTime];
#ENDIF
_GetInventoryItemHandle=%Var[ItemID%Var2];
#UNTIL=%VarItemAmount,=1;
Delay=100;
_IFInventoryContains=%Var[ItemID%Var2];
UseID=%Var[ItemID%Var2];
Delay=%Var[CastTime];
#ENDIF

end_OpenTillEmpty;

start_GetItemID;

WaitForResponse=1.Select aion client/n2.move your Mouse hover item/n3.hold Delete key to get item id;
_SetVar1=1;
_SetVar=ItemID%Var1,0;
_SetVar=AddMore,0;
#DO=3600000;
#2DO=180000;
_IFKey=2E,1;
_MemReadVar=%AddrMouseID,DWORD,ItemID%Var1;
#SetVar=Amount%Var1,Add Item %Var1 Id %Var[ItemID%Var1]/n/nEnter Quantity to open/nInput 0 if you want to open all of them;
#SetVar=AddMore,Do you want to add more/n1 Yes/n0 No;
#ENDIF
#2UNTIL=%Var[ItemID%Var1],>0;
#IF=%Var[AddMore],=1;
_Calc1=%Var1+1;
_SetVar=ItemID%Var1,0;
#ENDIF
#UNTIL=%Var[AddMore],=0;

end_GetItemID;
