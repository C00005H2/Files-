start_GMScan;
//Checks for GM nearby

//_SetArray2=100000,100001,100002,100003; // Asmo + Elyos
GetEntity=%OffsetType,CHAR[32],=User,%OffsetRank,DWORD,>0,EntityAddr;
#IF=%Var[EntityAddr_Elements],>0;
_SetVar=i,1;
#DO=4000;

_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetName,WCHAR[64],Name;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetType,CHAR[32],Type;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetLevel,BYTE,Level;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetPosX,FLOAT,PosX_Decimal;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetPosY,FLOAT,PosY_Decimal;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetPosZ,FLOAT,PosZ_Decimal;
#EXECUTE=GetMapID;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetNPCID,DWORD,NPCID;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetHideLevel,BYTE,HideLevel;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetEyeLevel,BYTE,EyeLevel;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetMovement,FLOAT,Movement;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],0x0,BYTE[1024],Dump;
_MemPtrReadVar=%Var[EntityAddr_%Var[i]],%OffsetData/0x0,BYTE[2048],DataDump;
#EXECUTE=EntityCheckup;

MemPtrWrite=%Var[EntityAddr_%Var[i]],%OffsetRank,0,DWORD; // To ignore entity till it got reloaded

_Calc[i]=%Var[i]+1;
#UNTIL=%Var[i],>%Var[EntityAddr_Elements];
#ENDIF

end_GMScan;


