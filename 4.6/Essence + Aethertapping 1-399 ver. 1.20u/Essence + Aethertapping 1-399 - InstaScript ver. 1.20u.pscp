end_GetOffsets;



start_InstaScriptLogin;

_SetVar=Required_Level,>9; // Logs on Characters on certain level condition (Example conditions: ">0" or "<50" or "5-10" or "=50")
_SetVar=ChangeChannel,1; // Change channel at the end of every round? - 0 = No | 1 = Yes | 2 or higher to define to change to this channel specific channel at the beginning
_SetVar=RecipeID,155000001; // Which Recipe ID you want to morph? - you find them at https://aioncodex.com/usc/recipes/convert/
_SetVar=PetUsage,0; // Want to take gifts from pet? - 0 = No | 1 = Yes
_SetVar=Thread,1; // Manage Potion usage in a second Vanillatool process (Smoother Flight)? - 0 = No | 1 = Yes
_SetVar=Morph,0; // Want to morph when ever DP is full? - 0 = No | 1 = Yes
_SetVar=PauseAfterDeath,0; // How many minutes you want to wait after death to enemy race?
_SetVar=StopAfterDeath,0; // Want to stop botting if died to mobs 3 times within 20 minutes? - 0 = No | 1 = Yes
_SetVar=LogOffOnNoPotion,0; // Want to stop botting if no flight potions in inventory? - 0 = No | 1 = Yes
_SetVar=LogOffOnNoExtractor,0; // Want to stop botting if no aether extractor in inventory? - 0 = No | 1 = Yes
_SetVar=SelfDefenseOnReturn,1; // Self defend on the return path? - 0 = No | 1 = Yes
_SetVar=LogOutOnTime,0; // Should the bot close the client at a specific timespan? - 0 = No | 1 = Yes
_SetVar=LogOutOnTime_Range,10:50-18:00; // Define the timespan (local PC time)
_SetVar=GMDetection,1; // Enable GM Detection? - 0 = No | 1 = Yes
_SetVar=RarityMinimum,0; // Enter the minimum required item rarity it allows to collect otherwise it cancels during gathering - 0 = Any | 2 = Green | 3 = Blue | 4 = Gold

CreateTimer=997;
#EXECUTE=GetOffsets;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
_SetVar=ScriptTitle,Tapping 1-399 %Var[PlayerName]; // Scriptname used for Logs or Script Editor title
#EXECUTE=HidePlayers;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_SubText],Startup [1/3]..,WCHAR[16];

#IF=%FirstTime,;
_SetVar=WrongPIN,0;
MemPtrWrite=%AddrFPS,%OffsetFPS1,%Var[FPSCap],BYTE;
MemPtrWrite=%AddrFPS,%OffsetFPS2,%Var[FPSCap],FLOAT;
MemWrite=%AddrMouseX,0x00000000000000000000000000000000,BYTE[16]; // initialize mouse usage
#ENDIF

_IFMemRead=%AddrMap,DWORD,<999999999;
_IFMemRead=%AddrMap,DWORD,>0; // if already logged in
#SetWindow
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%AionTitle::%Var[PlayerName] - %Var[ScriptTitle];
#Return
#ENDIF

#DO=600000;
Delay=1500;
_UNTILMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_Terms];
_IFMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_Terms]; // Accept EULA screen
#SetWindow
#DO=600000;
Delay=1500;
_UNTILMemRead=%AddrMap,DWORD,=4294967295;
#ENDIF

#IF=%ClientID,10-14; // 4.x
_IFMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_Terms]; // Accept EULA screen
#DO=15000;
Delay=500;
_UNTILMemRead=0x500,BYTE,=1;
_UNTILMemRead=0x504,BYTE,=1;
#ENDIF

_IFMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_Terms]; // Accept EULA screen
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%AionTitle::%Var[PlayerName] - %Var[ScriptTitle];
Delay=2500;
SendKey=0x0D; // Accept
Delay=9000;
#ENDIF
_IFMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_ServerSelection]; // Select Server screen
SendKey=0x0D; // Connect to Game Server
Delay=1500;
SendKey=0x0D; // Connect to Game Server
Delay=1500;
#ENDIF
_IFFrameVisible=%ConfirmFrameID; // New player cannot create new characters prompt
FrameAction=%ConfirmFrameID,XPOS,0;
FrameAction=%ConfirmFrameID,YPOS,0;
Delay=450;
Mouse=%Var[Mouse_CharSelect_Prompt1_X],%Var[Mouse_CharSelect_Prompt1_Y];
#ENDIF
_Calc[CautionFrameID]=%ConfirmFrameID+20;
_IFFrameVisible=%Var[CautionFrameID];
FrameAction=%Var[CautionFrameID],XPOS,0;
FrameAction=%Var[CautionFrameID],YPOS,0;
MemPtrWrite=%AddrFrameID[%Var[CautionFrameID]],0x580/%Var[Offset_Frame_State],7,BYTE;
MemPtrWrite=%AddrFrameID[%Var[CautionFrameID]],0x588/%Var[Offset_Frame_State],7,BYTE;
MemPtrWrite=%AddrFrameID[%Var[CautionFrameID]],0x590/%Var[Offset_Frame_State],7,BYTE;
Delay=225;
Mouse=%Var[Mouse_CharSelect_Prompt2_X],%Var[Mouse_CharSelect_Prompt2_Y];
Delay=450;
#ENDIF
Delay=10500;
_IFMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_CharSelect]; // Select Char screen
//#EXECUTE=EmptyServerCheckup;
Delay=5500;
#EXECUTE=SelectChar;
#IF=%Var[ReturnSlot],>-1; // If char was found
_Calc[CharCounter]=%Var[CharCounter]+1;
Mouse=%Var[Mouse_CharSelect_FirstSlot_X],%Var[Mouse_CharSelect_FirstSlot_Y]; // First Char
MemWrite=%AddrCharSlot,%Var[ReturnSlot],DWORD;
#ELSE
_SetVar=MSG,No character meets the requirements. logging off;
#EXECUTE=Log;
#EXECUTE=End;
#ENDIF
Delay=500;
Mouse=%Var[Mouse_CharSelect_Start_X],%Var[Mouse_CharSelect_Start_Y]; // Start
Delay=750;
Mouse=%Var[Mouse_CharSelect_Start_X],%Var[Mouse_CharSelect_Start_Y]; // Start
Delay=2000;
_IFFrameVisibleByName=second_password_dialog; PIN window
#EXECUTE=PINCheck;
#ELSE
//_SetVar=MSG,Had the PIN bug;
//#EXECUTE=Log;
#ENDIF
Delay=500;
#DO=60000;
Delay=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetAFK,FLOAT,3-10;
Delay=500;
#DO=1500;
SendKey=0x1B;
Delay=25;
_UNTILMemPtrRead=%AddrESChwnd,%OffsetESChwnd,BYTE,=175;
Delay=15;
_IFMemRead=%AddrMap,DWORD,>999999999; // not successfully logged in
#EXECUTE=End;
#ENDIF
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%AionTitle::%Var[PlayerName] - %Var[ScriptTitle];

end_InstaScriptLogin;




start_SelectChar;
//Requires [Required_Name], [Required_Level]
//Uses [Array3], [%Var31], [%Var40], [%Var39], [OffsetStep], [CharacterName_%i], [CharacterLevel_%i], [CharacterClassID_%i]
//Returns [ReturnSlot]

_MemPtrReadVar=%AddrUsers,0x10C,DWORD,CharacterAmount; // Reads current rendered Entity Amount to CharacterAmount variable
_Calc[ScreenCharSlotAddress]=%AddrCharSlot-%Var[Offset_CharSelection_Array];
_SetVar31=0;

#DO=30000;
_Calc[OffsetStep]=%Var31*8;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Name],WCHAR[32],CharacterName_%Var31;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Level],BYTE,CharacterLevel_%Var31;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Class],BYTE,CharacterClassID_%Var31;

_SetArray3=999,%Var40; // already logged list
#IF=%Var[CharacterName_%Var31],%ARRAY3;
#ELSE
_SetArray3=999,%Var39; // character name whitelist
#IF=%Var[CharacterName_%Var31],%ARRAY3;
_SetVar40=%Var40,%Var[CharacterName_%Var31];
_SetVar=ReturnSlot,%Var31;
#Return
#ENDIF

_SetArray3=999,%Var40; // already logged list
#IF=%Var[CharacterName_%Var31],%ARRAY3;
#ELSE
#IF=%Var[CharacterLevel_%Var31],%Var[Required_Level];
_SetVar40=%Var40,%Var[CharacterName_%Var31];
_SetVar=ReturnSlot,%Var31;
#Return
#ENDIF

_Calc31=%Var31+1;
#UNTIL=%Var31,=%Var[CharacterAmount];

_SetVar=ReturnSlot,-1;

end_SelectChar;


start_SelectSlot;

Mouse=%Var[Mouse_CharSelect_SecondSlot_X],%Var[Mouse_CharSelect_SecondSlot_Y]; // Second Slot
Delay=550;
MemWrite=%AddrCharSlot,%Var[ReturnSlot],DWORD;

end_SelectSlot;


start_EmptyServerCheckup;

#DO=150000;
_IFMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_CreateChar]; // Create Char screen
Delay=1000;
Mouse=434,573; // Main Screen
Delay=1000;
Mouse=164,571; // Server Selection
Delay=9000;
Mouse=397,145; // Lowest Server
Delay=1000;
SendKey=0x0D; // Accept
Delay=5500;
#ENDIF
_UNTILMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_CharSelect]; // Char selection screen

end_EmptyServerCheckup;




start_PINCheck;

#DO=600000;
_IFFrameVisibleByName=second_password_dialog; PIN window
#EXECUTE=WrongPIN;
FrameActionByName=second_password_dialog,XPOS,0;
FrameActionByName=second_password_dialog,YPOS,0;
#EnterPIN=%Var[UserPIN];
Delay=1000;
SendKey=0x0D;
#ELSE
#Return
#ENDIF
Delay=750;
#UNTIL=1,=2;

end_PINCheck;


start_WrongPIN;

_IFFrameVisible=%ConfirmFrameID;
Mouse=%Var[Mouse_CharSelect_WrongPIN1_X],%Var[Mouse_CharSelect_WrongPIN1_Y];
Delay=125;
#ENDIF

_IFFrameVisible=%ConfirmFrameID;
_Calc[WrongPIN]=%Var[WrongPIN]+1;
Mouse=%Var[Mouse_CharSelect_WrongPIN2_X],%Var[Mouse_CharSelect_WrongPIN2_Y];//  You must use mouse..
Delay=50;
Mouse=%Var[Mouse_CharSelect_WrongPIN3_X],%Var[Mouse_CharSelect_WrongPIN3_Y]; // Prompt wrong PIN
Delay=1000;
#ENDIF

#IF=%Var[WrongPIN],>1;
_SetVar=MSG,entered the PIN {%Var[UserPIN]} incorrectly 2 times. logging off now;
#EXECUTE=Log;
#QuitAtRound=-1,True;
#ENDIF

end_WrongPIN;


start_End;

#IF=%Var[QuitClient],=1;
#QuitAtRound=-1,True;
#ELSE
#EndScript
#ENDIF

end_End;


start_AccountSettings; // Customize PIN and character amount for each account here

_SetVar=IgnoreThis,0;

#IF=%AionTitle,=Account1; // IF window title = Account1 then
_SetVar=UserPIN,024689; // Your PIN
_Calc[IgnoreThis]=%Var[IgnoreThis]+1;
#ENDIF

#IF=%AionTitle,=Account2; // IF window title = Account2 then
_SetVar=UserPIN,111111; // Your PIN
_Calc[IgnoreThis]=%Var[IgnoreThis]+1;
#ENDIF

#IF=%AionTitle,=Account3; // IF window title = Account3 then
_SetVar=UserPIN,1234567; // Your PIN
_Calc[IgnoreThis]=%Var[IgnoreThis]+1;
#ENDIF



#IF=%Var[IgnoreThis],=0; // IF neither of them is found use default values from top of script
_SetVar=UserPIN,%Var[UserPIN];
#ENDIF

end_AccountSettings;





// End of Gather Routine



