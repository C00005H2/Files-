start_OnScriptExit;

#IF=%Var[Offset_Base_Animation],>0;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],1,FLOAT; // Normal Animationspeed
#ENDIF
#IF=%Var[Offset_Base_SubText],>0;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_SubText],0,DWORD;
#ENDIF
Console=\g_maxfps 120;

_SetVar=TimeStamp_1,%Var[Startup_TimeStamp];
_MemReadVar=%AddrCurrentTime,DWORD,TimeStamp_2; // End Timestamp
#EXECUTE=GetReadableTime; // Transforms milliseconds between timestamps to HH:MM:SS
_SetVar=MSG,Script stopped | leveled Essencetapping from %Var[Main_Essencetapping_Level_Startup]p to %Var[Essencetapping_Level]p in [%Var[Time_Readable]];
#EXECUTE=Log;

end_OnScriptExit;


start_StartFreeFlight;

#DO=10000;
#EXECUTE=WaitForFlightCD;
SendAction=3,%Var[Action_StartFreeFlight];
Delay=2500;
_UNTILMemRead=%AddrFlightStatus,BYTE,=1;
#EXECUTE=TakingOffRoutine;

end_StartFreeFlight;


start_StopFreeFlight;

#DO=10000;
SendAction=3,%Var[Action_StopFreeFlight];
Delay=2500;
_UNTILMemRead=%AddrFlightStatus,BYTE,=0;
#EXECUTE=LandingRoutine;

end_StopFreeFlight;


start_TakingOffRoutine;

#IF=%Var[Animation],=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],10,FLOAT; // 10x Animationspeed
#ENDIF

end_TakingOffRoutine;


start_LandingRoutine;
#IF=%Var[Animation],=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],1,FLOAT; // 1x Animationspeed
#ENDIF
#IF=%Var[Regenerate],=1; // flight time reg toggle
#DO=300000;
Delay=1000;
_ACDetectIfAttacked=;
#UNTIL=%FlightTime,=%MaxFlightTime;  // regenerates flighttime for up to 5 minutes
#ENDIF
end_LandingRoutine;


start_FlyingRoutine;
#EXECUTE=CheckCaptcha;
#EXECUTE=CheckDead;
_IFMemRead=%AddrFlightStatus,BYTE,=0;
#EXECUTE=Stuck;
#Restart
#ENDIF
_IFBuffAlive=9961; // 30% Flightspeed buff
#ELSE
#IF=%Var[WindScroll],=1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,=0;
_IFInventoryContains=164000079; // Greater Raging Wind Scroll
_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player; // if not in loading screen
_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,>0; // if alive
#IF=%Timer=1001,15100; // If no cooldown on scroll
UseID=164000079;
Delay=333;
CreateTimer=1001;
#ENDIF
#IF=%Var[Thread],=1;
#Return
#ENDIF
#IF=%Var[FlightSkill],=1;
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightSkill_Gain];
_ACUseSkill=%Var[FlightSkill_ID];
#ENDIF
#IF=%Var[FlightSkill_2],=1;
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightSkill_2_Gain];
_ACUseSkill=%Var[FlightSkill_2_ID];
#ENDIF
_IFInventoryContains=%Var[FlightPotionID],1;
#ELSE
#EXECUTE=GetFlightPotionID;
#ENDIF
_IFInventoryContains=%Var[FlightPotionID],1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,%Var[PotionPermission];
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightPotionGain];
#IF=%Timer=162000024,%Var[FlightPotionCD];
_MemPtrReadVar=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],FLOAT,AnimCache;
UseID=%Var[FlightPotionID];
#DO=2000;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=%Var[FlightPotionID];
_IFMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=%Var[FlightPotionID];
#DO=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=0;
CreateTimer=162000024;
#ENDIF
_IFInventoryContains=162000063,1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,%Var[PotionPermission];
#IF=%FlightTime,<%MaxFlightTime-20;
#IF=%Timer=162000063,30500;
UseID=162000063; // essence of wind
#DO=2000;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=162000063;
_IFMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=162000063;
#DO=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=0;
CreateTimer=162000063;
#ENDIF
end_FlyingRoutine;


start_EssenceRoutine;
#EXECUTE=CheckDead;

_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,=4;
#IF=%Var[Animation],=1;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],10,FLOAT; // 10x Animationspeed
#ELSE
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_Animation],1,FLOAT; // 1x Animationspeed
#ENDIF

_IFBuffAlive=9960; // 30% Movement Scroll buff
#ELSE
#IF=%Var[RunScroll],=1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,=0;
_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player; // if not in loading screen
_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,>0; // if alive
_IFInventoryContains=164000076; // Greater Raging Wind Scroll
#IF=%Timer=1001,15100; // If no cooldown on scroll
UseID=164000076;
Delay=333;
CreateTimer=1001;
#ENDIF

end_EssenceRoutine;



start_ThreadRoutine;

#3DO=999999999;

_IFFrameVisibleByName=tool_making_dialog;
#2DO=260000;
_SetVar=WaitForFrame_Name,tool_making_dialog;
_SetVar=WaitForFrame_Timeout,3000;
#EXECUTE=WaitForFrameClosed;
#2UNTIL=%Var[t_WaitForFrame],=1;
#ENDIF

_IFMemRead=%AddrFlightStatus,BYTE,>0;
#IF=%Var[FlightSkill],=1;
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightSkill_Gain];
_ACUseSkill=%Var[FlightSkill_ID];
#ENDIF
_IFMemRead=%AddrFlightStatus,BYTE,>0;
#IF=%Var[FlightSkill_2],=1;
_IFMemPtrRead=%TargetBase,%OffsetData,UINT64,=0;
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightSkill_2_Gain];
_ACUseSkill=%Var[FlightSkill_2_ID];
#ENDIF
_IFInventoryContains=%Var[FlightPotionID],1;
#ELSE
#EXECUTE=GetFlightPotionID;
#ENDIF
_IFMemRead=%AddrFlightStatus,BYTE,>0;
_IFInventoryContains=%Var[FlightPotionID],1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,%Var[PotionPermission];
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightPotionGain];
#IF=%Timer=162000024,2000;
CreateTimer=162000024;
GetCooldown=%Var[FlightPotionID],PotionCooldown;
