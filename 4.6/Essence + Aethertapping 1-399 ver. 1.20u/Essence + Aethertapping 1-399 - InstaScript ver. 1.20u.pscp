start_GetReadableTime;

_Calc[WaitTime]=%Var[TimeStamp_2]-%Var[TimeStamp_1];
_Calc[Seconds]=%Var[WaitTime]/1000;
_Calc[Minutes]=%Var[Seconds]/60;
_Calc[Hours]=%Var[Minutes]/60;

_RegExp=%Var[Seconds],^([0-9]+),Seconds_Floor;
_RegExp=%Var[Minutes],^([0-9]+),Minutes_Floor;
_RegExp=%Var[Hours],^([0-9]+),Hours_Floor;

#IF=%Var[Hours_Floor],>0;
_Calc[Hours_Mod]=%Var[Hours_Floor]*3600000;
_Calc[WithoutHours]=%Var[WaitTime]-%Var[Hours_Mod];
_Calc[WithoutHours]=%Var[WithoutHours]/60000;
_RegExp=%Var[WithoutHours],^([0-9]+),WithoutHours_Floor;
#ELSE
_SetVar=WithoutHours_Floor,%Var[Minutes_Floor];
#ENDIF

#IF=%Var[Minutes_Floor],>0;
_Calc[Minutes_Mod]=%Var[Minutes_Floor]*60000;
_Calc[WithoutMinutes]=%Var[WaitTime]-%Var[Minutes_Mod];
_Calc[WithoutMinutes]=%Var[WithoutMinutes]/1000;
_RegExp=%Var[WithoutMinutes],^([0-9]+),WithoutMinutes_Floor;
#ELSE
_SetVar=WithoutMinutes_Floor,%Var[Seconds_Floor];
#ENDIF

#IF=%Var[Hours_Floor],<10;
_SetVar=Readable_Hours,0%Var[Hours_Floor];
#ELSE
_SetVar=Readable_Hours,%Var[Hours_Floor];
#ENDIF

#IF=%Var[WithoutHours_Floor],<10;
_SetVar=Readable_Minutes,0%Var[WithoutHours_Floor];
#ELSE
_SetVar=Readable_Minutes,%Var[WithoutHours_Floor];
#ENDIF

#IF=%Var[WithoutMinutes_Floor],<10;
_SetVar=Readable_Seconds,0%Var[WithoutMinutes_Floor];
#ELSE
_SetVar=Readable_Seconds,%Var[WithoutMinutes_Floor];
#ENDIF

_SetVar=Time_Readable,%Var[Readable_Hours]:%Var[Readable_Minutes]:%Var[Readable_Seconds];

end_GetReadableTime;
