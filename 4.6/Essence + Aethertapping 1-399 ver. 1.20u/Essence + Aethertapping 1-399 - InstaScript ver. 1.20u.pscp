start_AutoScroll;

_IFBuffAlive=9960; // 30% Movement buff
#ELSE
#IF=%Var[RunScroll],=1; // If scroll enabled
#IF=%Timer=1001,15100; // If no cooldown on scroll
_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player; // if not in loading screen
_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,>0; // if alive
_IFMemPtrRead=%PlayerBase,%OffsetAFK,FLOAT,<180; // if less than 3 minutes AFK
_IFMemRead=%AddrFlightStatus,BYTE,=0; // Not Flying
#EXECUTE=RunningScrolls;
#ENDIF

_IFBuffAlive=9961; // 30% Flightspeed buff
#ELSE
#IF=%Var[WindScroll],=1; // If scroll enabled
#IF=%Timer=1001,15100; // If no cooldown on scroll
_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player; // if not in loading screen
_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,>0; // if alive
_IFMemPtrRead=%PlayerBase,%OffsetAFK,FLOAT,<180; // if less than 3 minutes AFK
_IFMemRead=%AddrFlightStatus,BYTE,=1; // Flying
#EXECUTE=WindScrolls;
#ENDIF

end_AutoScroll;


