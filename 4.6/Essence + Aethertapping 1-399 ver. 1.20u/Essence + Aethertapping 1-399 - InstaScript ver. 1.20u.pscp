MemPtrWrite=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_XPos_D],9.375,DOUBLE;
MemPtrWrite=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_YPos_D],81.25,DOUBLE;


