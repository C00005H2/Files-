start_Check_ProfessionBug;

#IF=%Var[ProfessionBug],>4;
_SetVar=MSG,Error getting Essencetapping Level;
#EXECUTE=Log;
#EXECUTE=End;
#ENDIF

_GetProfessionLevel=Essencetapping;
#IF=%Var[Essencetapping_MaxLevel],=0;
#EXECUTE=Relog;
_Calc[ProfessionBug]=%Var[ProfessionBug]+1;
SendKey=0x4B; // K key
Delay=300;
#EXECUTE=CloseWindows;
Delay=150;
#EXECUTE=Check_ProfessionBug;
#ELSE
_SetVar=ProfessionBug,0;
#Return
#ENDIF

end_Check_ProfessionBug;


start_Relog;

#DO=360000;
_ACDetectIfAttacked=;
Delay=120;
Command=/logout;
#2DO=30000;
Delay=500;
_2UNTILMemRead=%AddrCharacterScene,DWORD,=%Var[CharacterScene_CharSelect]; // if in char selection
Delay=25000;
Mouse=%Var[Mouse_CharSelect_FirstSlot_X],%Var[Mouse_CharSelect_FirstSlot_Y]; // First slot
Delay=500;
Mouse=%Var[Mouse_CharSelect_FirstSlot_X],%Var[Mouse_CharSelect_FirstSlot_Y]; // First slot
Delay=1000;
Mouse=%Var[Mouse_CharSelect_Start_X],%Var[Mouse_CharSelect_Start_Y]; // Start
Delay=2000;
//#EXECUTE=PINCheck;
#2DO=60000;
Delay=500;
_2UNTILMemPtrRead=%PlayerBase,%OffsetAFK,FLOAT,3-10;
#2DO=6000;
Delay=25;
_UNTILMemPtrRead=%PlayerBase,%OffsetType,CHAR[16],=Player;
#2UNTIL=1,=2;

end_Relog;


start_Essence_Upgrade_Elyos;

