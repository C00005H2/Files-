Delay=250;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=0;
Delay=250;
_UNTILMemPtrRead=%PlayerBase,%OffsetActionID,DWORD,=0;

#IF=%Var[Animation],=1;
