#ENDIF

end_WaitForCraft;


start_SheatheWeapon;

_SetVar=temp_shard,0;
#DO=4000;
_IFMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_Stance],BYTE,=33; // combat mode without shard
UseID=%Var[SkillID_ToggleCombat];
Delay=1500;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetData/%Var[Offset_Base_Stance],BYTE,=161; // combat mode with shard
UseID=%Var[SkillID_ToggleCombat];
Delay=1500;
#ENDIF
