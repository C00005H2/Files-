start_GetPetID;

_SetVar=PetAvailable,0;

_IFMemRead=%AddrPet,BYTE,>0;
_SetVar=PetAvailable,1;
_Calc[CATempAddr]=%AddrPet-4;
_MemReadVar=%Var[CATempAddr],DWORD,PetID;
_SetVar=PetType,46;
#ELSE
#EXECUTE=FindPet; //This takes a while, preferable put the Pet into quickbar page 1, the further away the quickbar page is away the longer it will take
#ENDIF

end_GetPetID;


start_FindPet;

_SetVar=temp,0;
#DO=90000;
_Calc[tOffset]=%Var[temp]*0x10;
_Calc[tAddr]=%AddrFirstSlotType+%Var[tOffset];
_IFMemRead=%Var[tAddr],DWORD,=46; // Is Pet
_Calc[tAddr2]=%AddrFirstSlotID+%Var[tOffset];
_MemReadVar=%Var[tAddr2],DWORD,PetID;
_SetVar=PetAvailable,1;
_SetVar=PetType,46;
UseID=%Var[PetID],%Var[PetType];
#Return
#ENDIF
_Calc[temp]=%Var[temp]+1;
#UNTIL=%Var[temp],>100; // Total: 480

end_FindPet;



