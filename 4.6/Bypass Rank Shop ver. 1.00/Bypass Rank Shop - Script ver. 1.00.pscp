WaitForResponse=This script bypasses the rank requirement to buy items from a merchant/n/nMake sure you are already talking to the merchant and the shop window is opened;
#EXECUTE=GetOffsets;
#EXECUTE=DumpExchangeOffer;
#EXECUTE=SetExchangeBasket;



start_DumpExchangeOffer;

_SetVar=Data,Enter the number you want to buy:/n/n;

_SetVar=i,0;
#DO=999999999;
_Calc[tOffset]=%Var[i]*0x8;
_IFMemPtrRead=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_Offer]/%Var[Offset_Inv_Item]/%Var[tOffset]/%Var[Offset_Inv_ItemID],DWORD,>0;
_MemPtrReadVar=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_Offer]/%Var[Offset_Inv_Item]/%Var[tOffset]/%Var[Offset_Inv_ItemID],UINT64,Offer_%Var[i]_ItemID;
_MemPtrReadVar=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_Offer]/%Var[Offset_Inv_Item]/%Var[tOffset]/%Var[Offset_Inv_ItemHandle],UINT64,Offer_%Var[i]_Handle;
_MemPtrReadVar=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_Offer]/%Var[Offset_Inv_Item]/%Var[tOffset]/%Var[Offset_Inv_ItemAmount],UINT64,Offer_%Var[i]_Amount;
_MemPtrReadVar=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_Offer]/%Var[Offset_Inv_Item]/%Var[tOffset]/%Var[Offset_Inv_ItemName],WCHAR[128],Offer_%Var[i]_Name;
_SetVar=Data,%Var[Data]%Var[i]: %Var[Offer_%Var[i]_Name]/n;
#ENDIF
_Calc[i]=%Var[i]+1;
_UNTILMemPtrRead=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_Offer]/%Var[Offset_Inv_Item]/%Var[tOffset]/%Var[Offset_Inv_ItemID],DWORD,=0;

#SetVar=UserChoose,%Var[Data];

end_DumpExchangeOffer;



start_SetExchangeBasket;

MemPtrWrite=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_BuyBasket]/%Var[Offset_Inv_Item]/0x0/%Var[Offset_Inv_ItemID],%Var[Offer_%Var[UserChoose]_ItemID],UINT64;
MemPtrWrite=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_BuyBasket]/%Var[Offset_Inv_Item]/0x0/%Var[Offset_Inv_ItemHandle],%Var[Offer_%Var[UserChoose]_Handle],UINT64;
MemPtrWrite=%AddrFrameName[trade_dialog],%Var[Offset_Exchange_BuyBasket]/%Var[Offset_Inv_Item]/0x0/%Var[Offset_Inv_ItemAmount],%Var[Offer_%Var[UserChoose]_Amount],UINT64;

WaitForResponse=Magic done!/n/nClick on Buy at the shop window;

end_SetExchangeBasket;






start_GetOffsets;

#DO=60000;
#2DO=5000;
Delay=250;
#2UNTIL=%Timer=997,5000;

_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Frame_XPos,(?m)\[4\.6\]\n.*?^Frame_XPos=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Frame_YPos,(?m)\[4\.6\]\n.*?^Frame_YPos=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Frame_State,(?m)\[4\.6\]\n.*?^Frame_State=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Exchange_Offer,(?m)\[4\.6\]\n.*?^Exchange_Offer=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Exchange_BuyBasket,(?m)\[4\.6\]\n.*?^Exchange_BuyBasket=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_Cube,(?m)\[4\.6\]\n.*?^Inv_Cube=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_Item,(?m)\[4\.6\]\n.*?^Inv_Item=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_ItemID,(?m)\[4\.6\]\n.*?^Inv_ItemID=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_ItemHandle,(?m)\[4\.6\]\n.*?^Inv_ItemHandle=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_ItemAmount,(?m)\[4\.6\]\n.*?^Inv_ItemAmount=(.*?)$;
_HTTPGetVar=http://subvanillatool.com/Offsets.txt,,Offset_Inv_ItemName,(?m)\[4\.6\]\n.*?^Inv_ItemName=(.*?)$;

CreateTimer=997;
#UNTIL=%Var[Offset_Frame_XPos],>0;

end_GetOffsets;
