#IF=%FirstTime,;
MemWrite=%AddrFreeMem0,0,BYTE;
#ThreadEXECUTE=GMCheck,True,False,ThreadPID; // frequently checks for nearby GMs
#SetVar=Statues,What types of statues it should kill?/n/n0 = None | 1 = Large Only | 2 = Large Medium | 3 = All/n/nRecommended: 3;
#SetVar=BossroomChests,Should it loot the chests at the boss room?/n/n0 = No | 1 = Yes/n/nRecommended: 1;
#SetVar=Chests,Should it loot the chests outside of the boss room?/n/n0 = No | 1 = Yes/n/nRecommended: 1;
RequireVersion=10.48;
#UseGravity
#UseCollision
#SmoothBackground
Console=\g_maxfps 30;
UseSpeed=250;
UseSpeedGlobal=1.0; // can be increased to slow down the script, 1.2 would slow it down by 20%
WaitForResponse=Make sure you stay at the spawn of Miren Chamber/n/nMake sure you have a Bow equiped as Assassin or Gladiator/n/nMake sure you have a Book equiped as Sorcerer or Spiritmaster/n/nTemplar cannot kill the Statues by himself, you can send a templar along with any other class to share AP/n/nMake sure your client language is english;
Command=;
#SetWindow
#DO=60000;
Delay=500;
_UNTILMemRead=%AddrFreeMem0,BYTE,=1;
#ENDIF

_IFMemRead=%AddrFreeMem0,BYTE,=0;
WaitForResponse=GM Detection did not start, you can continue anyways or stop the script after clicking on OK;
#ENDIF

