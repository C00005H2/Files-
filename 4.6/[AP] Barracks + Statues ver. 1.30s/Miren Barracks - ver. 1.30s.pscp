start_GMCheck;

MemWrite=%AddrFreeMem0,1,BYTE;

#DO=999999999;

_IFMemPtrRead=%AddrUsers,0x15C,DWORD,>1; // If not alone in the instance
_MemReadVar=%AddrMap,DWORD,MapID;
_SetArray1=300130000,300140000,300120000,301290000,301280000,301300000;
#IF=%Var[MapID],%ARRAY1; // If inside
LogWrite=%VANILLATOOL\Logs\%DAY-%MONTH-%YEAR--Barracks.txt,%HOUR:%MIN:%SEC -- [%AionTitle::%Var[PlayerName]] was not alone in the luna instance (%Var[MapID]) (GM nearby?)/n,+;
#SetWindow
FrameActionByName=idscore_dialog,STATE,SHOW;
FrameActionByName=idscore_dialog,XPOS,0;
FrameActionByName=idscore_dialog,YPOS,0;
Delay=250;
Mouse=105,214; // Leave Instance
Delay=250;
SendKey=0x0D; // Enter
Delay=250;
Command=;
Command=/logout;
#UseNoLoop
#QuitAtRound=-1,True;
#ENDIF

Delay=100;

#UNTIL=1,=2;

end_GMCheck;

start_OnScriptExit;

MemWrite=%AddrFreeMem0,0,BYTE;
