MemPtrWrite=%AddrFrameName[inventory_dialog],%Var[Offset_Frame_XPos],4.032836914,FLOAT;
MemPtrWrite=%AddrFrameName[inventory_dialog],%Var[Offset_Frame_YPos],0,FLOAT;

_Calc[CubeAmount]=%InventoryMaxSlots/27;
_RegExp=%Var[CubeAmount],^([0-9]*?)(?:\.[0-9]*?$|$),CubeAmount;
_Calc[RemainingSlots]=%Var[CubeAmount]*27;
_Calc[RemainingSlots]=%InventoryMaxSlots-%Var[RemainingSlots];

_SetVar=DynamicCubeOffsetBase,%Var[Offset_Inv_Cube];
_SetVar=tResult,0;
_SetVar=tSlot,0;
_SetVar=CubeCount,0;
_Calc[DynamicCubeOffset]=%Var[CubeCount]*0x8;
_Calc[DynamicCubeOffset]=%Var[DynamicCubeOffsetBase]+%Var[DynamicCubeOffset];

#DO=90000;
_IFMemPtrRead=%AddrFrameName[inventory_dialog],%Var[DynamicCubeOffset]/%Var[Offset_Inv_Item]/%Var[DynamicSlotOffset]/%Var[Offset_Inv_ItemID],DWORD,=%Var[SearchedItemID];
_Calc[tResult]=%Var[tResult]+1;
#IF=%Var[tResult],>%Var[SecondResult];
#EXECUTE=InvSlotToCoord;
#Return
#ENDIF
_Calc[tSlot]=%Var[tSlot]+1;
_Calc[DynamicSlotOffset]=%Var[tSlot]*0x8;
#IF=%Var[tSlot],=27;
_SetVar=tSlot,0;
_Calc[CubeCount]=%Var[CubeCount]+1;
_Calc[DynamicCubeOffset]=%Var[CubeCount]*0x8;
_Calc[DynamicCubeOffset]=%Var[DynamicCubeOffsetBase]+%Var[DynamicCubeOffset];
#ENDIF
#UNTIL=%Var[CubeCount],=%Var[CubeAmount];
#UNTIL=%Var[tSlot],=%Var[RemainingSlots];

end_CheckInvSlot;


start_InvSlotToCoord;

_SetVar=FirstSlot_X,563;
_SetVar=FirstSlot_Y,48;
_SetVar=Icon_Width,27;
_SetVar=Icon_Height,27;
_SetVar=Cube_Height,21;

_Calc[tRow]=%Var[tSlot]/9;
_RegExp=%Var[tRow],^([0-9]*?)(?:\.[0-9]*?$|$),tRow;
_Calc[rSlots]=%Var[tRow]*9;
_Calc[cSlot]=%Var[tSlot]-%Var[rSlots];

_Calc[Cube_Distance]=%Var[CubeCount]*%Var[Cube_Height];
_Calc[Row_Distance]=%Var[CubeCount]*3;
_Calc[Row_Distance]=%Var[Row_Distance]+%Var[tRow];
_Calc[Row_Distance]=%Var[Row_Distance]*%Var[Icon_Height];
_Calc[Item_Coord_Y]=%Var[Cube_Distance]+%Var[Row_Distance];
