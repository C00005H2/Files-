Command=/logout;
Print=Logging off in 3..;
Delay=1000;
Print=Logging off in 2..;
Delay=1000;
Print=Logging off in 1..;
Delay=1000;
#QuitAtRound=-1,True;
#UseNoLoop
#EndScript
#ENDIF

