#IF=%Var[NotifyWhenPlayerClose],>0;
#IF=%Var[PlayerClose_Addr_Elements],>0; // player within 40m
_SetArray1=dark_binding_stone_01a,Binding_stone_01a,yun_binding_stone_01,Binding_stone_user_01a;
GetEntity=%OffsetRace,CHAR[32],%ARRAY1,Obelisk_Addr;
#IF=%Var[Obelisk_Addr_Elements],=0; // no obelisk within 100m
#IF=%Timer=105,60000;
#IF=%Var[NotifyWhenPlayerClose],>0;
_SetVar=MSG,%Var[tName] is close;
#EXECUTE=Log;
CreateTimer=105;
#IF=%Var[NotifyWhenPlayerClose],=2;
#SetAsActive
#Alarm
#ENDIF

_SetVar=Temp,0;
#IF=%Var[NotifyWhenPlayerTargets],>0;
_SetVar=Temp,1;
#ENDIF
#IF=%Var[WhisperWhenPlayerTargets],=1;
_SetVar=Temp,1;
#ENDIF

#IF=%Var[Temp],=1;
_MemPtrReadVar=%PlayerBase,%OffsetData/%Var[Offset_Base_EntityID],DWORD,Player_EntityID;
_SetArray2=999,%Var18;
GetEntity=%OffsetType,CHAR[32],=User,%OffsetName,WCHAR[16],!%ARRAY2,%OffsetData/%Var[Offset_Base_TargetNPCID],DWORD,=%Var[Player_EntityID],%Distance,FLOAT,<35,PlayerTargets_Addr;
#ELSE
#Return
#ENDIF

#IF=%Var[PlayerTargets_Addr_Elements],>0; // Player who targets us within 35m
MemPtrWrite=%Var[PlayerTargets_Addr_1],%OffsetData/%Var[Offset_Base_TargetNPCID],0,DWORD; // To ignore entity till it targets again
#IF=%Var[NotifyWhenPlayerTargets],>0;
#IF=%Timer=106,60000;
_SetVar=MSG,%Var[tName] has bot as target;
#EXECUTE=Log;
#IF=%Var[NotifyWhenPlayerTargets],=2;
#SetAsActive
#Alarm
CreateTimer=106;
#ENDIF
#IF=%Var[PlayerTargets_Addr_Elements],>0; // Player who targets us within 35m
#IF=%Var[WhisperWhenPlayerTargets],=1;
_MemPtrReadVar=%Var[PlayerTargets_Addr_1],%OffsetName,WCHAR[64],tName;
_IFMemPtrRead=%Var[PlayerTargets_Addr_1],%OffsetType,CHAR[32],=User;
Delay=%RNG{3000|6000};
#EXECUTE=WhisperPlayer;
#ENDIF

end_EntityFilter;



