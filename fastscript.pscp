start_FlyingRoutine;
_IFMemRead=%AddrFlightStatus,BYTE,=0;
#Return
#ENDIF
_IFBuffAlive=9961; // 30% Flightspeed buff
#ELSE
#IF=%Var[WindScroll],=1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,=0;
_IFInventoryContains=164000079; // Greater Raging Wind Scroll
_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player; // if not in loading screen
_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,>0; // if alive
#IF=%Timer=1001,15100; // If no cooldown on scroll
UseID=164000079;
Delay=333;
CreateTimer=1001;
#ENDIF
#IF=%Var[FlightTimeManagement],=0;
#Return
#ENDIF
#IF=%Var[FlightSkill],=1;
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightSkill_Gain];
_ACUseSkill=%Var[FlightSkill_ID];
#ENDIF
_IFInventoryContains=%Var[FlightPotionID],1;
#ELSE
#EXECUTE=GetFlightPotionID;
#ENDIF
_IFInventoryContains=%Var[FlightPotionID],1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,%Var[PotionPermission];
#IF=%FlightTime,<%MaxFlightTime-%Var[FlightPotionGain];
#IF=%Timer=162000024,%Var[FlightPotionCD];
UseID=%Var[FlightPotionID];
#DO=2000;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=%Var[FlightPotionID];
_IFMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=%Var[FlightPotionID];
#DO=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=0;
CreateTimer=162000024;
#ENDIF
_IFInventoryContains=162000063,1;
_IFMemPtrRead=%PlayerBase,%OffsetActionID,BYTE,%Var[PotionPermission];
#IF=%FlightTime,<%MaxFlightTime-20;
#IF=%Timer=162000063,30500;
UseID=162000063; // essence of wind
#DO=2000;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=162000063;
_IFMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=162000063;
#DO=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetCurrentItemID,DWORD,=0;
CreateTimer=162000063;
#ENDIF
end_FlyingRoutine;



