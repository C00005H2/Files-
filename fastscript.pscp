start_Init;

_SetArray1=5,6,15; // Classic Client IDs

#EXECUTE=GetOffsets;

MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_SubText],PlayerScan starting..,WCHAR[26];

_IFMemPtrRead=%PlayerBase,%OffsetRace,CHAR[1],=L;
_SetVar=RaceCode,0;
#ELSE
_SetVar=RaceCode,1;
#ENDIF

#IF=%ClientID,=1; // NA
_SetVar=ScanOffset,0x5DC;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=2; // EU
_SetVar=ScanOffset,0x5DC;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=5; // Classic NA
_SetVar=ScanOffset,0x240;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=6; // Classic EU
_SetVar=ScanOffset,0x240;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=10; // EuroAion
_SetVar=ScanOffset,0x39C;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=11; // Aion America
_SetVar=ScanOffset,0x39C;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=12; // Destiny
_SetVar=ScanOffset,0x39C;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=13; // Elden Aion
_SetVar=ScanOffset,0x39C;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=14; // GamezAion
_SetVar=ScanOffset,0x39C;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

#IF=%ClientID,=15; // Aion Nova
_SetVar=ScanOffset,0x1FC;
_Calc[ScanArray]=%AddrHidePlayer-%Var[ScanOffset];
#ENDIF

_MemPtrReadVar=%Var[ScanArray],0x4,FLOAT,XPos;
_MemPtrReadVar=%Var[ScanArray],0x8,FLOAT,YPos;
_MemPtrReadVar=%Var[ScanArray],0xC,FLOAT,ZPos;
_Calc[Checksum]=%Var[XPos]+%Var[YPos];
_Calc[Checksum]=%Var[Checksum]+%Var[ZPos];

Command=;
Print=____________________/n/nPlayerScan started/n/nType "/Who PlayerName" to locate a allied Player/n____________________/n;
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_Base_SubText],0,DWORD;

end_Init;



