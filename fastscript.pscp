#ENDIF

#IF=%Var[WordofProtection],=1;
_ACUseSkill=1224; // Word of Protection
#ENDIF

end_CheckChanter;



start_TabMod;

#IF=%Var[TabDistance],=1;
#TabMod=True;
#ENDIF

end_TabMod;



start_PlayerScan;

_MemPtrReadVar=%Var[ScanArray],0x4,FLOAT,XPos;
_MemPtrReadVar=%Var[ScanArray],0x8,FLOAT,YPos;
_MemPtrReadVar=%Var[ScanArray],0xC,FLOAT,ZPos;
_Calc[Checksum]=%Var[XPos]+%Var[YPos];
_Calc[Checksum]=%Var[Checksum]+%Var[ZPos];

#IF=%Var[Checksum],=0;
#Return
#ENDIF

#IF=%Var[Checksum],=%Var[CachedChecksum];
#ELSE
FrameActionByName=who_dialog,STATE,HIDE;
Delay=200;
_MemPtrReadVar=%Var[ScanArray],0x4,FLOAT,XPos;
_MemPtrReadVar=%Var[ScanArray],0x8,FLOAT,YPos;
_MemPtrReadVar=%Var[ScanArray],0xC,FLOAT,ZPos;
_Calc[Checksum]=%Var[XPos]+%Var[YPos];
_Calc[Checksum]=%Var[Checksum]+%Var[ZPos];
_SetVar=CachedChecksum,%Var[Checksum];
_MemPtrReadVar=%Var[ScanArray],0x0,DWORD,MapID;
_MemPtrReadVar=%Var[ScanArray],0x10,BYTE,Class_ID;
_MemPtrReadVar=%Var[ScanArray],0x12,BYTE,Level;
_MemPtrReadVar=%Var[ScanArray],0x14,WCHAR[16],Name;
#EXECUTE=GetClassByID;
#EXECUTE=Show;
#ENDIF

end_PlayerScan;



start_Show;

_SetVar=SubMap,0;

_RegExp=%Var[XPos],^([0-9]+),PosX_NoDecimal; // Remove Comma
_RegExp=%Var[YPos],^([0-9]+),PosY_NoDecimal; // Remove Comma
_RegExp=%Var[ZPos],^([0-9]+),PosZ_NoDecimal; // Remove Comma

#IF=%Var[MapID],=400010000; // Reshanta
#IF=%Var[ZPos],<1950; // Lower
_SetVar=SubMap,1;
#ENDIF
#IF=%Var[MapID],=400010000; // Reshanta
#IF=%Var[ZPos],1950-2225; // Center
_SetVar=SubMap,2;
#ENDIF
#IF=%Var[MapID],=400010000; // Reshanta
#IF=%Var[ZPos],>2225; // Upper
_SetVar=SubMap,3;
#ENDIF

#IF=%ClientID,%ARRAY1; // Classic
Print=[[pos:%Var[Name]/:%Var[MapID] %Var[PosX_NoDecimal] %Var[PosY_NoDecimal] 0.0 %Var[SubMap]]] - Lv: %Var[Level] | %Var[Class_String] | X: %Var[PosX_NoDecimal] | Y: %Var[PosY_NoDecimal] | Z: %Var[PosZ_NoDecimal] | Map: %Var[MapID];
#ELSE
Print=[[pos:%Var[Name]/:%Var[RaceCode] %Var[MapID] %Var[PosX_NoDecimal] %Var[PosY_NoDecimal] 0.0 %Var[SubMap]]] - Lv: %Var[Level] | %Var[Class_String] | X: %Var[PosX_NoDecimal] | Y: %Var[PosY_NoDecimal] | Z: %Var[PosZ_NoDecimal] | Map: %Var[MapID];
#ENDIF

end_Show;


start_PlayerScan_Set_MapID;

#IF=%Var[Addr_PlayerScan_MapID],=0;
_MemPattern=4A8B440950C3,0,False,True; // original code
#IF=%Var[PatternFound],>0;
MemWrite=%Var[PatternRet_1],0x48B8909E8E0600000000C333C0C3CC,BYTE[15];
_Calc[Addr_PlayerScan_Jmp]=%Var[PatternRet_1]-0x9;
MemWrite=%Var[Addr_PlayerScan_Jmp],0x13,BYTE[1];
_Calc[Addr_PlayerScan_MapID]=%Var[PatternRet_1]+0x2;
#ENDIF
#IF=%Var[Addr_PlayerScan_MapID],=0;
_MemPattern=48B8........00000000C333C0C3CC,0,False,True; // modified code
#IF=%Var[PatternFound],>0;
MemWrite=%Var[PatternRet_1],0x48B8909E8E0600000000C333C0C3CC,BYTE[15];
_Calc[Addr_PlayerScan_Jmp]=%Var[PatternRet_1]-0x9;
MemWrite=%Var[Addr_PlayerScan_Jmp],0x13,BYTE[1];
_Calc[Addr_PlayerScan_MapID]=%Var[PatternRet_1]+0x2;
#ENDIF

#IF=%Var[Addr_PlayerScan_MapID],>0;
MemWrite=%Var[Addr_PlayerScan_MapID],%Var[PlayerScan_MapID],DWORD;
#ENDIF

end_PlayerScan_Set_MapID;



