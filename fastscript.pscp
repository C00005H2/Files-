FastScript_Cooldown=350; // this fast script will run every 350ms
//PLAYERSCAN + REBUFF + Flighttime management
________________________________________

#IF=%FirstTime,;
//___Settings___________________________________________________________________________
// [GENERAL OPTIONS]
_SetVar=FPSCap,500; // Set the FPS cap (default 120)
_SetVar=TabDistance,1; // Increase the Distance the "Tab" key finds monsters? | 1 = Yes | 0 = No

// [MAIN OPTIONS]
_SetVar=PlayerScan,1; // Allows to locate any allied player by typing "/Who PlayerName" | 1 = Yes | 0 = No
_SetVar=Rebuff,0; // Allows to automatically keep buffs alive | 1 = Yes | 0 = No
_SetVar=WindScroll,1; // Use Greater Raging Wind Scroll? - 0 = No | 1 = Yes
_SetVar=FlightTimeManagement,1; // Automatically use Flight Potions / Flight Skill? - 0 = No | 1 = Yes
_SetVar=FlightPotion_Gathering,1; // Allow Flight Potion usage while gathering? - 0 = No | 1 = Yes

// [REBUFF OPTIONS]
// [Assassin]
_SetVar=ApplyPoison,1; // [Assassin] Keep [Apply Poison] buff alive | 1 = Yes | 0 = No
_SetVar=ApplyDeadlyPoison,1; // [Assassin] Keep [Apply Deadly Poison] buff alive | 1 = Yes | 0 = No
_SetVar=ApplyDeadlyAbandon,0; // [Assassin] Keep [Deadly Abandon] buff alive | 1 = Yes | 0 = No
// [Ranger]
_SetVar=FocusedShots,1; // [Ranger] Keep [Focused Shots] buff alive | 1 = Yes | 0 = No
_SetVar=BestialFury,1; // [Ranger] Keep [Bestial Fury] buff alive | 1 = Yes | 0 = No
_SetVar=StrongShots,0; // [Ranger] Keep [Strong Shots] buff alive | 1 = Yes | 0 = No
_SetVar=Aiming,0; // [Ranger] Keep [Aiming] buff alive | 1 = Yes | 0 = No
_SetVar=HuntersEye,0; // [Ranger] Keep [Hunter's Eye] buff alive | 1 = Yes | 0 = No
_SetVar=Dodging,0; // [Ranger] Keep [Dodging] buff alive | 1 = Yes | 0 = No
// [Chanter]
_SetVar=WordofInspiration,1; // [Chanter] Keep [Word of Inspiration] buff alive | 1 = Yes | 0 = No
_SetVar=WordofProtection,0; // [Chanter] Keep [Word of Protection] buff alive | 1 = Yes | 0 = No
// [Sorcerer]
_SetVar=SC_StoneSkin,1; // [Sorcerer] Keep [Stone Skin] buff alive | 1 = Yes | 0 = No
_SetVar=RobeOfFlame,1; // [Sorcerer] Keep [Robe of Flame] buff alive | 1 = Yes | 0 = No
_SetVar=RobeOfEarth,0; // [Sorcerer] Keep [Robe of Earth] buff alive | 1 = Yes | 0 = No
_SetVar=RobeOfCold,0; // [Sorcerer] Keep [Robe of Cold] buff alive | 1 = Yes | 0 = No
// [Spiritmaster]
_SetVar=SM_StoneSkin,1; // [Spiritmaster] Keep [Stone Skin] buff alive | 1 = Yes | 0 = No
//___End Settings______________________________________________________________________

// Ignore below
_ACRelyOnBuff=831,831; // Apply Poison
_ACRelyOnBuff=919,919; // Apply Deadly Poison
_ACRelyOnBuff=949,949; // Deadly Abandon
_ACRelyOnBuff=684,684; // Focused Shots
_ACRelyOnBuff=646,646; // Bestial Fury
_ACRelyOnBuff=786,786; // Strong Shots
_ACRelyOnBuff=776,776; // Aiming
_ACRelyOnBuff=693,693; // Hunter's Eye
_ACRelyOnBuff=777,777; // Dodging
_ACRelyOnBuff=1377,1377; // Stone Skin
_ACRelyOnBuff=1564,1564; // Robe of Flame
_ACRelyOnBuff=1574,1574; // Robe of Earth
_ACRelyOnBuff=1566,1566; // Robe of Cold
_ACRelyOnBuff=1223,1223; // Word of Inspiration
_ACRelyOnBuff=1224,1224; // Word of Protection
_ACSkills=831,919,684,646,786,776,693,777,1377,1564,1574,1566,1223,1224;
MemPtrWrite=%AddrFPS,%OffsetFPS1,%Var[FPSCap],BYTE;
MemPtrWrite=%AddrFPS,%OffsetFPS2,%Var[FPSCap],FLOAT;
#EXECUTE=TabMod;
#EXECUTE=Setup;
#ENDIF

#EXECUTE=CheckIngame;
#IF=%Var[Ingame],=1; // If ingame
#EXECUTE=Main;
#ENDIF


#EndScript









start_Main;

#IF=%Var[PlayerScan],=1;
#IF=%Var[ScanArray],=0;
#EXECUTE=Init;
//#EXECUTE=PlayerScan_Set_MapID;
#ENDIF

#IF=%Var[PlayerScan],=1;
#IF=%Var[ScanArray],>0;
#EXECUTE=PlayerScan;
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetHP,DWORD,=0; // Dead
#Return
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetHideLevel,BYTE,>0; // In hide
#Return
#ENDIF

#EXECUTE=FlyingRoutine;

#IF=%Var[Rebuff],=1;
#IF=%ClientID,%ARRAY1; // Classic
#ELSE
#Return
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=4; // Assassin
#EXECUTE=CheckAssassin;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=5; // Ranger
#EXECUTE=CheckRanger;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=7; // Sorcerer
#EXECUTE=CheckSorcerer;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=8; // Spiritmaster
#EXECUTE=CheckSpiritmaster;
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=11; // Chanter
#EXECUTE=CheckChanter;
#ENDIF

end_Main;




