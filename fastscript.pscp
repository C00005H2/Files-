_SetVar=FlightSkill_2_Gain,0;
_SetVar=FlightSkill_2_ID,0;
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=10; // Cleric
_IFMemPtrRead=%PlayerBase,%OffsetLevel,BYTE,>45;
_SetVar=FlightSkill,1;
_SetVar=FlightSkill_Gain,15;
_SetVar=FlightSkill_ID,1183;
_SetVar=FlightSkill_2,0;
_SetVar=FlightSkill_2_Gain,0;
_SetVar=FlightSkill_2_ID,0;
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=11; // Chanter
_IFMemPtrRead=%PlayerBase,%OffsetLevel,BYTE,>0;
_SetVar=FlightSkill,0;
_SetVar=FlightSkill_Gain,0;
_SetVar=FlightSkill_ID,0;
_SetVar=FlightSkill_2,0;
_SetVar=FlightSkill_2_Gain,0;
_SetVar=FlightSkill_2_ID,0;
#ENDIF

end_FlightSkillSort;

