MoveTo=525.689,147.417,174.339,False,False;
_IFMemRead=%AddrFlightCooldown,WORD,=0;
SendAction=3,%Var[Action_Glide];
Delay=150;
#ENDIF
_UNTILMemRead=%AddrFlightStatus,BYTE,>0;

