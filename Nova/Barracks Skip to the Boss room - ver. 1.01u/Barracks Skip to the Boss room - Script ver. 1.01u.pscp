#IF=%FirstTime,;
#EXECUTE=DeclareVariables;
WaitForResponse=This script takes you from the spawn of Kysis, Krotan and Miren to the boss room/n/nMake sure you have enough flight time, at least 2:11m are required but 2:20+ recommended;
#SmoothBackground
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetPosX,FLOAT,518-536;
_IFMemPtrRead=%PlayerBase,%OffsetPosY,FLOAT,106-131;
_IFMemPtrRead=%PlayerBase,%OffsetPosZ,FLOAT,174-178; // Nearby Instance spawn
#ELSE
WaitForResponse=You are not at the instance spawn of Krotan, Kysis or Miren;
#EndScript
#ENDIF

FlySmooth=527.4,117.4,175.9;
FlySmooth=527.4,117.4,175.9;
FlySmooth=522.4,124.8,175.9;
FlySmooth=522.4,124.8,175.9;
