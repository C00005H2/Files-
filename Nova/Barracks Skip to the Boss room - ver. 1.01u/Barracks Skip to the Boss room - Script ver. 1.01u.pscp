start_GlideEverywhere;
_MemPattern=F681........010F84........8B05........85C078083B05........7C,0x1F,False,True; //
#IF=%Var[PatternFound],>0;
_Calc[GE_O]=%Var[PatternRet_1]+0x3;
_MemReadVar=%Var[GE_O],DWORD,GE_Offset;
_SetArray1=1,2,5,6,15;
#IF=%ClientID,%ARRAY1;
_Calc[GE_Addr]=%Var[PatternRet_1]+0x7;
#ELSE
_Calc[GE_Addr]=%Var[PatternRet_1]+0x6;
#ENDIF
_Calc[GE_Addr]=%Var[GE_Addr]+%Var[GE_Offset];
MemWrite=%Var[GE_Addr],1,DWORD;
#ENDIF
end_GlideEverywhere;

