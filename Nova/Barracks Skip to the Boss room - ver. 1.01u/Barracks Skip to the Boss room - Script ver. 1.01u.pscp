FlySmooth=525.7,147.4,178.9;

#EXECUTE=WaitForFlightCD;
#DO=300000;
Delay=1000;
#UNTIL=%FlightTime,=%MaxFlightTime; // Waiting for max flight time

#IF=%FlightTime,<131;
WaitForResponse=You do not have enough flight time, you need at least 2:11m;
#EndScript
#ENDIF

#DO=300000;
Delay=1000;
_UNTILMemPtrRead=%PlayerBase,%OffsetMovement,FLOAT,>5.99; // waiting for enough movementspeed (soul sickness)

#EXECUTE=GlideEverywhere;

MemWrite=%AddrCamX,179,FLOAT;
MemWrite=%AddrCamY,56,FLOAT;

UseSpeed=200;
#DO=60000;
MoveTo=525.689,147.417,178.939,False,False;
