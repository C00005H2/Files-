#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=2;
//;;;;;;;;;Settings Templar Greatsword;;;;;;;;;
//(Based on Aioncodex level 55)

_ACAllowAllMobs=False;
_ACEnableAutoAttack=True;
_ACManaPercentage=80;
_ACIgnoreAtDistance=23;
