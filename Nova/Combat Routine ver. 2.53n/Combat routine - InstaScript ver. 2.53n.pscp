start_CheckPause;

_Calc[AddrRecoverableEXP]=%AddrMaxEXP+0x8;
_IFMemRead=%Var[AddrRecoverableEXP],DWORD,=0; // Has no recoverable exp (died to enemy race)
#IF=%Var[PauseAfterDeath],>0;
_SetVar=MSG,has died to enemy race;
#EXECUTE=Log;
_Calc[PauseAfterDeathTime]=%Var[PauseAfterDeath]*60000;
#DO=%Var[PauseAfterDeathTime];
Delay=1000;
#UNTIL=%Timer=105,%Var[PauseAfterDeathTime]; // If Timer with ID 105 has been running for ..ms
#Return
#ENDIF

_SetVar=temp,0;
_IFMemRead=%Var[AddrRecoverableEXP],DWORD,=%Var[RecoverableEXP_Cache];
_SetVar=temp,1;
#ENDIF
_IFMemRead=%Var[AddrRecoverableEXP],DWORD,=0;
_SetVar=temp,1;
#ENDIF

#IF=%Var[temp],=1; // If recoverable EXP equals cache or 0 return
#Return
#ELSE
_SetVar=MSG,has died to a mob;
#EXECUTE=Log;
_MemReadVar=%Var[AddrRecoverableEXP],DWORD,RecoverableEXP_Cache;
#ENDIF

_Calc[DiedToMob]=%Var[DiedToMob]+1;
_Calc[TotalDeaths]=%Var[TotalDeaths]+1;

#IF=%Var[DiedToMob],=4;
_SetVar=DiedToMob,1;
#ENDIF

#IF=%Var[DiedToMob],=1;
CreateTimer=10001;
#ENDIF
#IF=%Var[DiedToMob],=2;
CreateTimer=10002;
#ENDIF
#IF=%Var[DiedToMob],=3;
CreateTimer=10003;
#ENDIF

_SetVar=temp,0;
#IF=%Timer=10001,1200000;
_SetVar=temp,1;
#ENDIF
#IF=%Timer=10002,1200000;
_SetVar=temp,1;
#ENDIF
#IF=%Timer=10003,1200000;
_SetVar=temp,1;
#ENDIF

#IF=%Var[temp],=0; // If all 3 timers haven't passed 20 minutes yet
#IF=%Var[TotalDeaths],>2;
#IF=%Var[StopAfterDeath],=1;
_SetVar=MSG,has died more than 3 times within 20 minutes. ending script..;
#EXECUTE=Log;
#EXECUTE=End;
#ENDIF

end_CheckPause;


start_CheckBug;

_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[16],=Player;
#Return
#ELSE
