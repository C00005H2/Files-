start_ThreadRoutine;

Print=Thread started..;

_HTTPGetVar=http://pastebin.com/raw/kvP6EM6m,,GMList;

#DO=999999999;

_SetArray1=dark_binding_stone_01a,Binding_stone_01a,yun_binding_stone_01,Binding_stone_user_01a;
GetEntity=%OffsetRace,CHAR[32],%ARRAY1,Obelisk_Addr;

#IF=%Var[Obelisk_Addr_Elements],=0; // no obelisk within 100m
#IF=%Var[ParanoidTargeted],>0;
#EXECUTE=ParanoidTargeted;
#ENDIF

#IF=%Var[Obelisk_Addr_Elements],=0; // no obelisk within 100m
#IF=%Var[ParanoidNearby],>0;
#EXECUTE=ParanoidNearby;
#UNTIL=1,=2;
#ENDIF


_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player;
#IF=%Timer=101,5000; // If Timer with ID 101 has been running for 12000ms
#EXECUTE=GMScan; // Checks for nearby GM
CreateTimer=101; // Restart Timer with ID 101
#ENDIF

_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[6],=Player;
_IFMemPtrRead=%PlayerBase,%OffsetCastTime,WORD,=0;
#IF=%Timer=46,3000;
#EXECUTE=CheckWhisper;
#EXECUTE=EntityFilter;
CreateTimer=46; // Restart Timer with ID 46
#ENDIF

_SetArray1=520010000,510010000;
_IFMemRead=%AddrMap,DWORD,%ARRAY1; // In prison
#EXECUTE=Prison;
#ENDIF

Delay=1000;

#UNTIL=1,=2;

end_ThreadRoutine;


start_ParanoidTargeted;

_MemPtrReadVar=%PlayerBase,%OffsetData/%Var[Offset_Base_EntityID],DWORD,Player_EntityID;
GetEntity=%OffsetType,CHAR[32],=User,%OffsetData/%Var[Offset_Base_TargetNPCID],DWORD,=%Var[Player_EntityID],PlayerTargets_Addr;

#IF=%Var[PlayerTargets_Addr_Elements],=0;
#Return
#ENDIF

_MemPtrReadVar=%Var[PlayerTargets_Addr_1],%OffsetName,WCHAR[64],tName;
_SetVar=MSG,Player [%Var[tName]] targeted %Var[PlayerName].. closing client..;
#EXECUTE=Log;

#IF=%Var[ParanoidTargeted],=2; // Suicide
MemPtrWrite=%PlayerBase,%OffsetPosZ,0,FLOAT;
#ENDIF

#QuitAtRound=-1,True;
ProcessKill=%Var[MainVTPID];
#EXECUTE=End;

end_ParanoidTargeted;


start_ParanoidNearby;

_SetArray2=999,%Var18;
GetEntity=%OffsetType,CHAR[32],=User,%OffsetName,WCHAR[16],!%ARRAY2,%Distance,FLOAT,<%Var[ParanoidNearby],PlayerNearby_Addr;

#IF=%Var[PlayerNearby_Addr_Elements],=0;
#Return
#ENDIF

_MemPtrReadVar=%Var[PlayerTargets_Addr_1],%OffsetName,WCHAR[64],tName;
_SetVar=MSG,Player [%Var[tName]] is too close.. closing client..;
#EXECUTE=Log;

MemPtrWrite=%PlayerBase,%OffsetPosZ,0,FLOAT;

#QuitAtRound=-1,True;
ProcessKill=%Var[MainVTPID];
#EXECUTE=End;

end_ParanoidNearby;


start_Prison;

ProcessPause=%Var[MainVTPID],True;
#SetAsActive

_SetVar=MSG,Got teleported to Prison;
#EXECUTE=Log;

Command=/say %Var[PrisonAnswer_1_%RNG{1|5}];
#Alarm

Delay=%RNG{8000|15000};

_IFMemRead=%AddrMap,DWORD,%ARRAY1; // still in prison
Command=/say %Var[PrisonAnswer_2_%RNG{1|5}];
Delay=%RNG{8000|23000};
#ENDIF

_IFMemRead=%AddrMap,DWORD,%ARRAY1; // still in prison
_SetVar=MSG,Is still in prison.. logging out.;
#EXECUTE=Log;
#ELSE
_SetVar=MSG,Is not in prison anymore.. logging out.;
#EXECUTE=Log;
#ENDIF

Command=/logout;
Delay=15000;
#QuitAtRound=-1,True;
ProcessKill=%Var[MainVTPID];

end_Prison;


start_Suicide;
// If EXP is above 50% keeps suiciding till exp is below 5%

_MemReadVar=%AddrMaxEXP,DWORD,MaxExp;
_MemReadVar=%AddrCurrentEXP,DWORD,CurrentExp;
_Calc[ExpPercent]=%Var[CurrentExp]/%Var[MaxExp];
_Calc[ExpPercent]=%Var[ExpPercent]*100;
#IF=%Var[ExpPercent],<50;
#Return
#ENDIF

_MemPtrReadVar=%PlayerBase,%OffsetLevel,BYTE,Player_Level;

#IF=%Var[Player_Level],=%Var[Suicide_Level];
#ELSE
#IF=%Var[Suicide_Level],>0;
#Return
#ENDIF

_SetVar=MSG,[Suicide] beginning suicide at level %Var[Player_Level] at %Var[ExpPercent]% EXP;
#EXECUTE=Log;

#EXECUTE=IsCloseToBindpoint;
_IFMemPtrRead=%PlayerBase,%OffsetRace,CHAR[1],=L; // Elyos
#IF=%Var[BindPoint_MapID],=400010000; // Reshanta
#EXECUTE=AdvancedSuicide_Elyos;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetRace,CHAR[1],=D; // Asmo
#IF=%Var[BindPoint_MapID],=400010000; // Reshanta
#EXECUTE=AdvancedSuicide_Asmo;
#ENDIF

#EXECUTE=IsCloseToBindpoint;
#IF=%Var[BindPoint_MapID],=400010000; // Reshanta
#ELSE
#DO=600000;
MemPtrWrite=%PlayerBase,%OffsetPosZ,0,FLOAT;
_MemReadVar=%AddrCurrentEXP,DWORD,CurrentExp;
_Calc[ExpPercent]=%Var[CurrentExp]/%Var[MaxExp];
_Calc[ExpPercent]=%Var[ExpPercent]*100;
#UNTIL=%Var[ExpPercent],<5; //Until below 5% exp
_RegExp=%Var[ExpPercent],^([0-9]+),ExpPercent; // Remove Comma
_SetVar=MSG,[Suicide] successfully suicided till exp is at %Var[ExpPercent]%;
#EXECUTE=Log;
#EXECUTE=FindSoulHealer;
#ENDIF

#EXECUTE=Return;

end_Suicide;



