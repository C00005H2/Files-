start_CheckInvSlot;

_SetVar=Item_Coord_X,0;
_SetVar=Item_Coord_Y,0;

_IFInventoryContains=%Var[SearchedItemID];
#ELSE
#Return
#ENDIF

MemPtrWrite=%AddrFrameName[inventory_dialog],%Var[Offset_Frame_XPos],4.032836914,FLOAT;
