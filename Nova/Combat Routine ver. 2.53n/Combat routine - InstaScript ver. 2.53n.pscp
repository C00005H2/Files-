Delay=2500;
_UNTILMemRead=%AddrFlightStatus,BYTE,=1;

end_StartFreeFlight;


start_StopFreeFlight;

#DO=10000;
SendAction=3,%Var[Action_StopFreeFlight];
Delay=2500;
_UNTILMemRead=%AddrFlightStatus,BYTE,=0;

end_StopFreeFlight;



