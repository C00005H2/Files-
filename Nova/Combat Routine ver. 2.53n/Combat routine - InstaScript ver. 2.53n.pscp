_Calc[Addr_BindPoint_PosY]=%AddrCurrentTime-%Var[Offset_BindPoint_PosY];
_Calc[Addr_BindPoint_PosZ]=%AddrCurrentTime-%Var[Offset_BindPoint_PosZ];

_MemReadVar=%Var[Addr_BindPoint_MapID],DWORD,BindPoint_MapID;
_Calc[cTemp]=%Var[BindPoint_MapID]/100;
_RegExp=%Var[cTemp],^([0-9]+),cTemp; // Remove Comma
_Calc[BindPoint_MapID]=%Var[cTemp]*100;

_MemReadVar=%Var[Addr_BindPoint_PosX],FLOAT,BindPoint_PosX;
_MemReadVar=%Var[Addr_BindPoint_PosY],FLOAT,BindPoint_PosY;
_MemReadVar=%Var[Addr_BindPoint_PosZ],FLOAT,BindPoint_PosZ;

