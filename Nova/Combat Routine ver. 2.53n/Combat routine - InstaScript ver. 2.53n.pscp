start_CheckTimeEvent;

_SetVar=TimeEvent_Result,0;

StringSplit=TimeRange,-,%Var[Time];
#IF=%Var[TimeRange_Elements],<2;
#Return
#ENDIF

StringSplit=TimeRange_1,:,%Var[TimeRange_1];
#IF=%Var[TimeRange_1_Elements],<2;
#Return
#ENDIF

StringSplit=TimeRange_2,:,%Var[TimeRange_2];
#IF=%Var[TimeRange_2_Elements],<2;
#Return
#ENDIF

_Calc[TimeEvent_Start]=%Var[TimeRange_1_1]*60;
_Calc[TimeEvent_Start]=%Var[TimeEvent_Start]+%Var[TimeRange_1_2];

_Calc[TimeEvent_End]=%Var[TimeRange_2_1]*60;
_Calc[TimeEvent_End]=%Var[TimeEvent_End]+%Var[TimeRange_2_2];

_Calc[TimeEvent_Current]=%THour*60;
_Calc[TimeEvent_Current]=%Var[TimeEvent_Current]+%TMin;


#IF=%Var[TimeEvent_End],<%Var[TimeEvent_Start];
_Calc[TimeEvent_Start_t]=%Var[TimeEvent_Start]-1;
_Calc[TimeEvent_End_t]=%Var[TimeEvent_End]+1;
#IF=%Var[TimeEvent_Current],>%Var[TimeEvent_Start_t];
_SetVar=TimeEvent_Result,1;
#Return
#ENDIF
#IF=%Var[TimeEvent_End],<%Var[TimeEvent_Start];
#IF=%Var[TimeEvent_Current],<%Var[TimeEvent_End_t];
_SetVar=TimeEvent_Result,1;
#Return
#ENDIF

#IF=%Var[TimeEvent_Current],%Var[TimeEvent_Start]-%Var[TimeEvent_End];
_SetVar=TimeEvent_Result,1;
#Return
#ENDIF

_SetVar=TimeEvent_Result,0;
#Return

end_CheckTimeEvent;





