start_IsCloseToBindpoint;

#IF=%Var[BindPoint_PosX1],=;
_Calc[Addr_BindPoint_MapID]=%AddrCurrentTime-%Var[Offset_BindPoint_MapID];
_Calc[Addr_BindPoint_PosX]=%AddrCurrentTime-%Var[Offset_BindPoint_PosX];
_Calc[Addr_BindPoint_PosY]=%AddrCurrentTime-%Var[Offset_BindPoint_PosY];
_Calc[Addr_BindPoint_PosZ]=%AddrCurrentTime-%Var[Offset_BindPoint_PosZ];

_MemReadVar=%Var[Addr_BindPoint_MapID],DWORD,BindPoint_MapID;
_Calc[cTemp]=%Var[BindPoint_MapID]/100;
_RegExp=%Var[cTemp],^([0-9]+),cTemp; // Remove Comma
_Calc[BindPoint_MapID]=%Var[cTemp]*100;

_MemReadVar=%Var[Addr_BindPoint_PosX],FLOAT,BindPoint_PosX;
_MemReadVar=%Var[Addr_BindPoint_PosY],FLOAT,BindPoint_PosY;
_MemReadVar=%Var[Addr_BindPoint_PosZ],FLOAT,BindPoint_PosZ;

_Calc[BindPoint_PosX1]=%Var[BindPoint_PosX]-7.5;
_Calc[BindPoint_PosY1]=%Var[BindPoint_PosY]-7.5;
_Calc[BindPoint_PosZ1]=%Var[BindPoint_PosZ]-3;
_Calc[BindPoint_PosX2]=%Var[BindPoint_PosX]+7.5;
_Calc[BindPoint_PosY2]=%Var[BindPoint_PosY]+7.5;
_Calc[BindPoint_PosZ2]=%Var[BindPoint_PosZ]+3;
#ENDIF

#EXECUTE=GetMapID;
#IF=%Var[MapID],=%Var[BindPoint_MapID];
_IFMemPtrRead=%PlayerBase,%OffsetPosX,FLOAT,%Var[BindPoint_PosX1]-%Var[BindPoint_PosX2];
_IFMemPtrRead=%PlayerBase,%OffsetPosY,FLOAT,%Var[BindPoint_PosY1]-%Var[BindPoint_PosY2];
_IFMemPtrRead=%PlayerBase,%OffsetPosZ,FLOAT,%Var[BindPoint_PosZ1]-%Var[BindPoint_PosZ2];
_Calc[BindPoint_RandomPosX]=%Var[BindPoint_PosX]-1.5;
