#EXECUTE=Log;
LogWrite=%VANILLATOOL\Logs\%DAY-%MONTH-%YEAR--Combat_Log.txt,%HOUR:%MIN:%SEC -- [%AionTitle::%Var[PlayerName]] Player pointer successfully repaired/n,+;
#ENDIF

end_CheckBug;


