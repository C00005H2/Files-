_ACRegHPPercentage=50; // Starts sitting when HP drop below 50%

_ACHealPercentage=100; // Will check trough _ACHeals if below 100% health (each skill has it's own HP rule defined)

_ACRelyOnDistance=1805,>7; //1805 Herb Treatment
_ACRelyOnDistance=1824,>7; //1824 Mana Treatment
_ACRelyOnDistance=1974,<7; //1974 Punishing Wave

_ACRelyOnPlayerHP=516,<10; //516 Hand of Healing
_ACRelyOnPlayerHP=475,<20; //475 Nezekan's Shield (Elyos)
_ACRelyOnPlayerHP=476,<20; //476 Zikel's Shield (Asmo)
_ACRelyOnPlayerHP=543,<75; //543 Power of Restoration
_ACRelyOnPlayerHP=2041,<60; //2041 Prayer of Resilience
_ACRelyOnPlayerHP=401,<60; //401 Aether Armor
_ACRelyOnPlayerHP=527,<80; //527 Holy Shield
_ACRelyOnPlayerHP=426,<60; //426 Iron Skin
_ACRelyOnPlayerHP=426,<70; //506 Empyrean Armor
_ACRelyOnPlayerHP=1805,<80; //1805 Herb Treatment
_ACRelyOnPlayerHP=1978,<30; //1978 Empyrean Providence

_ACRelyOnTargetHP=513,>80; //513 Divine Fury

_ACRelyOnRace=475,Elyos; //475 Nezekan's Shield (Elyos)
