#UNTIL=1,=2;

end_PINCheck;


start_WrongPIN;

_IFFrameVisible=%ConfirmFrameID;
Mouse=496,335;
Delay=125;
#ENDIF

_IFFrameVisible=%ConfirmFrameID;
_Calc[WrongPIN]=%Var[WrongPIN]+1;
