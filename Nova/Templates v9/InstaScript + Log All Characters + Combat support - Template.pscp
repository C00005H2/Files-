start_StartGlide;

_MemPtrReadVar=%PlayerBase,%OffsetPosX,FLOAT,1;
_MemPtrReadVar=%PlayerBase,%OffsetPosY,FLOAT,2;
_MemPtrReadVar=%PlayerBase,%OffsetPosZ,FLOAT,3;

_IFMemPtrRead=%PlayerBase,%OffsetGravity,BYTE,=5;
#ELSE
_Calc3=%Var3+2.95;
#ENDIF

#DO=60000;
MoveTo=%Var1,%Var2,%Var3,True,False;
#EXECUTE=WaitForFlightCD;
MoveTo=%Var1,%Var2,%Var3,False,False;
Delay=175;
SendAction=1,2;
UseSpeed=1;
#2DO=500;
MoveTo=%Var1,%Var2,%Var3,False,False;
#2UNTIL=1,=2;
Delay=65;
#2DO=2500;
MoveTo=%Var1,%Var2,%Var3,False,False;
SendAction=3,16;
Delay=100;
_2UNTILMemPtrRead=%PlayerBase,%OffsetFlightStatus,BYTE,=1;
_UNTILMemPtrRead=%PlayerBase,%OffsetFlightStatus,BYTE,=1;
UseSpeed=170;
MoveTo=%Var1,%Var2,%Var3,False,False;
MoveTo=%Var1,%Var2,%Var3,False,False;
_UNTILMemPtrRead=%PlayerBase,%OffsetFlightStatus,BYTE,=1;
UseSpeed=1;

end_StartGlide;


start_WaitForFlightCD;

#DO=10000;
Delay=250;
_UNTILMemRead=%AddrFlightCooldown,WORD,=0;

end_WaitForFlightCD;



start_Log;

_IFMemPtrRead=%PlayerBase,%OffsetType,CHAR[16],=Player;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
_RegExp=%Var[PlayerName],^([a-zA-Z0-9]*),PlayerName;
#ELSE
_SetVar=PlayerName,[Unknown];
#ENDIF

LogWrite=%VANILLATOOL\Logs\%DAY-%MONTH-%YEAR--%Var[ScriptTitle].txt,%HOUR:%MIN:%SEC -- [%AionTitle::%Var[PlayerName]] %Var[MSG]/n,+;

MemWrite=%AddrFreeMem5,%Var[DiscordURL],WCHAR[1];
_IFMemRead=%AddrFreeMem5,BYTE,=104;
_HTTPPost=https://subvanillatool.com/discord.php,url=%Var[DiscordURL]&message=__**[%Var[ScriptTitle]] [%AionTitle::%Var[PlayerName]]**__ [%THour:%TMin:%TSec] %Var[MSG];
#ENDIF

end_Log;


start_CloseWindows;

#DO=1500;
SendKey=0x1B;
Delay=20;
_UNTILMemPtrRead=%AddrESChwnd,%OffsetESChwnd,BYTE,=175;
Delay=25;
MemPtrWrite=%AddrESChwnd,%OffsetESChwnd,142,BYTE;

end_CloseWindows;


start_OnScriptExit;

Console=\g_maxfps 120;

end_OnScriptExit;



start_ChangeCharacter;

#IF=%Timer=44,360000; // If tried to changechar for 6 minutes
_SetVar=MSG,script got aborted. stuck in ChangeCharacter function (%Var[CharCounter]|%Var[CharacterAmount]);
#EXECUTE=Log;
#EXECUTE=End;
#ENDIF

Command=/logout;
#DO=60000;
Delay=1000;
_UNTILMemRead=%AddrCharacterScene,DWORD,=11; // if in char selection

_IFMemRead=%AddrCharacterScene,DWORD,>13; // if still ingame
#EXECUTE=ChangeCharacter;
#Return
#ENDIF

_IFMemRead=%AddrCharacterScene,DWORD,=11; // if in char selection
Delay=5500;
#EXECUTE=SelectChar;
#IF=%Var[ReturnSlot],>-1; // If char was found
_Calc[CharCounter]=%Var[CharCounter]+1;
#EXECUTE=SelectSlot;
Delay=1500;
MemPtrWrite=%PlayerBase,%OffsetAFK,600,FLOAT;
Mouse=292,562; // Start
Delay=750;
Mouse=292,562; // Start
Delay=2000;
#EXECUTE=PINCheck;
#DO=60000;
Delay=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetAFK,FLOAT,3-10;
Delay=3500;
#ENDIF

#IF=%Var[ReturnSlot],=-1; // If char was not found
_SetVar=MSG,script is finished with all characters (%Var[CharCounter]|%Var[CharacterAmount]);
#EXECUTE=Log;
#EXECUTE=End;
#ENDIF

_IFMemRead=%AddrCharacterScene,DWORD,<14; // If not ingame
#EXECUTE=ChangeCharacter;
#Return
#ENDIF

end_ChangeCharacter;





start_SelectChar;
//Requires [Required_Name], [Required_Level]
//Uses [Array3], [%Var31], [%Var40], [%Var39], [OffsetStep], [CharacterName_%i], [CharacterLevel_%i], [CharacterClassID_%i]
//Returns [ReturnSlot]

_MemPtrReadVar=%AddrUsers,0x10C,DWORD,CharacterAmount; // Reads current rendered Entity Amount to CharacterAmount variable
_Calc[ScreenCharSlotAddress]=%AddrCharSlot-%Var[Offset_CharSelection_Array];
_SetVar31=0;

#DO=30000;
_Calc[OffsetStep]=%Var31*8;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Name],WCHAR[32],CharacterName_%Var31;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Level],BYTE,CharacterLevel_%Var31;
_MemPtrReadVar=%Var[ScreenCharSlotAddress],%Var[OffsetStep]/%Var[Offset_CharSelection_Array_Class],BYTE,CharacterClassID_%Var31;

_SetArray3=999,%Var40; // already logged list
#IF=%Var[CharacterName_%Var31],%ARRAY3;
#ELSE
_SetArray3=999,%Var39; // character name whitelist
#IF=%Var[CharacterName_%Var31],%ARRAY3;
_SetVar40=%Var40,%Var[CharacterName_%Var31];
_SetVar=ReturnSlot,%Var31;
#Return
#ENDIF

_SetArray3=999,%Var40; // already logged list
#IF=%Var[CharacterName_%Var31],%ARRAY3;
#ELSE
#IF=%Var[CharacterLevel_%Var31],%Var[Required_Level];
_SetVar40=%Var40,%Var[CharacterName_%Var31];
_SetVar=ReturnSlot,%Var31;
#Return
#ENDIF

_Calc31=%Var31+1;
#UNTIL=%Var31,=%Var[CharacterAmount];

_SetVar=ReturnSlot,-1;

end_SelectChar;


start_SelectSlot;

Mouse=151,498; // Second Slot
Delay=550;
MemWrite=%AddrCharSlot,%Var[ReturnSlot],DWORD;

end_SelectSlot;


start_HidePlayers;

MemWrite=%AddrHidePlayer,%Var[HidePlayers],DWORD;

end_HidePlayers;






start_InstaScriptLogin;

CreateTimer=997;
#EXECUTE=GetOffsets;
#EXECUTE=HidePlayers;

#IF=%FirstTime,;
_SetVar=WrongPIN,0;
MemPtrWrite=%AddrFPS,%OffsetFPS1,%Var[FPSCap],BYTE;
MemPtrWrite=%AddrFPS,%OffsetFPS2,%Var[FPSCap],FLOAT;
MemWrite=%AddrMouseX,0x00000000000000000000000000000000,BYTE[16]; // initialize mouse usage
#ENDIF

_IFMemRead=%AddrMap,DWORD,<999999999;
_IFMemRead=%AddrMap,DWORD,>0; // if already logged in
#SetWindow
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%AionTitle::%Var[PlayerName] - %Var[ScriptTitle];
#Return
#ENDIF

#DO=600000;
Delay=1500;
_UNTILMemRead=%AddrCharacterScene,DWORD,=8;
_IFMemRead=%AddrCharacterScene,DWORD,=8; // Accept EULA screen
#SetWindow
#DO=600000;
Delay=1500;
_UNTILMemRead=%AddrMap,DWORD,=4294967295;
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%AionTitle::%Var[PlayerName] - %Var[ScriptTitle];
Delay=2500;
SendKey=0x0D; // Accept
Delay=9000;
#ENDIF
_IFMemRead=%AddrCharacterScene,DWORD,=9; // Select Server screen
SendKey=0x0D; // Connect to Game Server
Delay=1500;
SendKey=0x0D; // Connect to Game Server
Delay=1500;
#ENDIF
_IFFrameVisible=%ConfirmFrameID; // New player cannot create new characters prompt
FrameAction=%ConfirmFrameID,XPOS,0;
FrameAction=%ConfirmFrameID,YPOS,0;
Delay=450;
Mouse=146,94;
#ENDIF
_Calc[CautionFrameID]=%ConfirmFrameID+20;
_IFFrameVisible=%Var[CautionFrameID];
FrameAction=%Var[CautionFrameID],XPOS,0;
FrameAction=%Var[CautionFrameID],YPOS,0;
MemPtrWrite=%AddrFrameID[%Var[CautionFrameID]],0x580/0x28,7,BYTE;
MemPtrWrite=%AddrFrameID[%Var[CautionFrameID]],0x588/0x28,7,BYTE;
MemPtrWrite=%AddrFrameID[%Var[CautionFrameID]],0x590/0x28,7,BYTE;
Delay=225;
Mouse=229,130;
Delay=450;
#ENDIF
Delay=10500;
_IFMemRead=%AddrCharacterScene,DWORD,=11; // Select Char screen
//#EXECUTE=EmptyServerCheckup;
Delay=5500;
#EXECUTE=SelectChar;
#IF=%Var[ReturnSlot],>-1; // If char was found
_Calc[CharCounter]=%Var[CharCounter]+1;
Mouse=51,496; // First Char
MemWrite=%AddrCharSlot,%Var[ReturnSlot],DWORD;
#ELSE
_SetVar=MSG,No character meets the requirements. logging off;
#EXECUTE=Log;
#EXECUTE=End;
#ENDIF
Delay=500;
Mouse=292,565; // Start
Delay=750;
Mouse=292,565; // Start
Delay=2000;
_IFFrameVisibleByName=second_password_dialog; PIN window
#EXECUTE=PINCheck;
#ELSE
//_SetVar=MSG,Had the PIN bug;
//#EXECUTE=Log;
#ENDIF
Delay=500;
#DO=60000;
Delay=500;
_UNTILMemPtrRead=%PlayerBase,%OffsetAFK,FLOAT,3-10;
Delay=500;
#DO=1500;
SendKey=0x1B;
Delay=25;
_UNTILMemPtrRead=%AddrESChwnd,%OffsetESChwnd,BYTE,=175;
Delay=15;
_IFMemRead=%AddrMap,DWORD,>999999999; // not successfully logged in
#EXECUTE=End;
#ENDIF
_MemPtrReadVar=%PlayerBase,%OffsetName,WCHAR[32],PlayerName;
SetScriptTitle=%AionTitle::%Var[PlayerName] - %Var[ScriptTitle];

end_InstaScriptLogin;



start_EmptyServerCheckup;

#DO=150000;
_IFMemRead=%AddrCharacterScene,DWORD,=13; // Create Char screen
Delay=1000;
Mouse=434,573; // Main Screen
Delay=1000;
Mouse=164,571; // Server Selection
Delay=9000;
Mouse=397,145; // Lowest Server
Delay=1000;
SendKey=0x0D; // Accept
Delay=5500;
#ENDIF
_UNTILMemRead=%AddrCharacterScene,DWORD,=11; // Char selection screen

end_EmptyServerCheckup;



start_PINCheck;

#DO=600000;
_IFFrameVisibleByName=second_password_dialog; PIN window
