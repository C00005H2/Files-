_ACRelyOnRace=1649,Elyos; // Summon Earth Spirit
_ACRelyOnRace=1615,Asmo; // Summon Earth Spirit
_ACRelyOnRace=1751,Elyos; // Summon Fire Energy
_ACRelyOnRace=1748,Asmo; // Summon Fire Energy

_ACManaRecover=1370;
// 1370 Absorb energy

_ACBuffs=1377;
// 1649 | 1615 Summon Earth Spirit (If not already summoned)
// 1377 Stoneskin
// 1683 Enmity Swap
// 1677 Replenish Element

_ACSkills=1358,1751,1748,1631,2295,1756;
// 1358 Erosion (If not already applied)
// 1751 | 1748 Summon Fire Energy
// 1631 Chain of Earth (has chain)
// 2295 Vacuum Choke
// 1756 Absorb Vitality

//;;;;;;;End Settings Spiritmaster Gravity;;;;;;;
