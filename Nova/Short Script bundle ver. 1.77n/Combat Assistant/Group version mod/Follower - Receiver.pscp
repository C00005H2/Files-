start_CombatSort_ForGravity;

//;;;;;;;;BASIC SETTINGS;;;;;;;;;;;

#IF=%Var4,=1;
_ACUseAnimation=True;
#ENDIF

_SetVar=PotionHP,75; // Use Potion if HP below 75%
_SetVar=PotionMP,66; // Use Potion if MP below 66%
_ACRegenerateEnabled=False; // Enables sitting
_ACRegMPPercentage=30; // Starts sitting when MP drop below 35%
_ACRegHPPercentage=35; // Starts sitting when HP drop below 35%
_ACTimeoutNoDamage=12000; // combat times out if the mob hasn't taken any damage within the first 12000 milliseconds
_ACTimeout=900; // Combat times out if the fight takes longer than 900 seconds
_ACMob_Looting=False; // Enables Looting
_ACAllowAllMobs=True; // Keeps fighting if enemy has another entity as target
_ACEnableAutoAttack=False; // Enables AutoAttacks while fighting
_ACResetPosition=False; // Reset the player position after a fight to where he was before the fight started
_ACExperimentalCooldown=True; // Leave that on True
_ACMidAirDistance=3; // Distance it moves with each step
_ACMidAirTiming=950; // moves after at least 950 milliseconds
_ACIncreasedAttackrange=1; // 1 Increased attackrange by 1 meter, both skills and auto attack work at max distance | 2 increases by 2 meters, only skills works at max distance

#EXECUTE=GetPotionID;

//;;;;;;;END BASIC SETTINGS;;;;;;;;



