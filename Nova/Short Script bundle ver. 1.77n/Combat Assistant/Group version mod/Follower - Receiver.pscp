#IF=%FirstTime,;
UseSpeed=1;
#UseGravity
#SmoothBackground
Console=\g_maxfps 30;
Command=;
_SetArray2=Player,User,NPC; // Valid Target
_SetVar8=10000;
_SetVar9=10000;
_SetVar4=10000;
#EXECUTE=CombatSort_ForGravity;
#ENDIF


#DO=99999999;
SessionGetVar=1;
SessionGetVar=2;
SessionGetVar=3;
SessionGetVar=4;
SessionGetVar=6;
SessionGetVar=7;
#IF=%Var4,=%Var9;
#ELSE
#IF=%Var4,>0;
_SetVar9=%Var4;
MoveTo=%Var1,%Var2,%Var3,True,False;
#ENDIF
#IF=%Var7,=%Var8;
#ELSE
#IF=%Var7,>0;
_SetVar8=%Var7;
Command=/select %Var6;
#EXECUTE=WaitForTarget;
Command=/skill Select Target's Target;
#EXECUTE=WaitForTarget;
_AutoCombat=True;
#ENDIF
#UNTIL=1,=2;



start_WaitForTarget;
