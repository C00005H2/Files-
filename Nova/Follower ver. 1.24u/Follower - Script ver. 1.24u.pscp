#IF=%FirstTime,;
_SetVar=RunScroll,1; // Use Greater Running Scroll? - 0 = No | 1 = Yes
_SetVar=AtkSpeedScroll,0; // Use Greater Courage Scroll? - 0 = No | 1 = Yes
_SetVar=CritStrikeScroll,0; // Use Major Crit Strike Scroll? - 0 = No | 1 = Yes
_SetVar=CastSpeedScroll,0; // Use Greater Awakening Scroll? - 0 = No | 1 = Yes
_SetVar=CritSpellScroll,0; // Use Major Crit Spell Running Scroll? - 0 = No | 1 = Yes
_SetVar=RallySerumAndFocusAgent,5; // Use Rally Serum and Focus Agent? - 0 = No | 1 = Lesser | 2 = Normal | 3 = Greater | 4 = Major | 5 = Fine
RequireVersion=8.17;
#UseLoop
#SmoothBackground
#EXECUTE=GetOffsets;
Console=\g_maxfps 20;
Command=;
UseSpeed=1;
_SetVar1=0;
#EXECUTE=WaitForName;
//#SetVar=FakeLevel,Set the level artificially to a lower level so not the latest skill books and stigmas are required/n/n0 = use real level/n/nOtherwise enter desired level;
_SetVar=Leader,%Var5;
_SetArray2=Player,User,NPC; // Valid Target
MovementTimeout=2550;
_SetVar=LastRotation,0;
#EXECUTE=CombatSort;
#ENDIF

#DO=999999999;
#EXECUTE=Command;
#UNTIL=1,=2;


start_Command;

SessionGetVar=1; // Get Command

#IF=%Var1,=0; // Wait
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],WAIT,WCHAR[16];
#ENDIF
#IF=%Var1,=1; // Follow
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],FOLLOW,WCHAR[16];
#EXECUTE=Follow;
#ENDIF
#IF=%Var1,=2; // Combat
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],COMBAT,WCHAR[16];
#EXECUTE=Attack;
#ENDIF
#IF=%Var1,=3; // Loot
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],LOOT,WCHAR[16];
#EXECUTE=Loot;
#ENDIF
#IF=%Var1,=4; // Regenerate
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],REGENERATE,WCHAR[16];
#EXECUTE=Regenerate;
#ENDIF
#IF=%Var1,=5; // Quest
MemPtrWrite=%PlayerBase,%OffsetData/%Var[Offset_SubText],QUEST,WCHAR[16];
#EXECUTE=Quest;
#ENDIF

end_Command;




start_WaitForTarget;
#DO=750;
_UNTILMemPtrRead=%TargetBase,%OffsetType,CHAR[16],%ARRAY2;
end_WaitForTarget;


start_Follow;

_SetVar=temp,1;
#DO=99999999;

#EXECUTE=MemoryCheck;

_IFMemPtrRead=%AddrFreeMem4,%OffsetFlightStatus2,BYTE,=1; // Leader is flying
_IFMemPtrRead=%PlayerBase,%OffsetFlightStatus2,BYTE,=0; // Player is not flying
SendAction=3,4; // Start Flight
Delay=200;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetFlightStatus2,BYTE,=1; // Player is flying
_IFMemPtrRead=%AddrFreeMem4,%OffsetFlightStatus2,BYTE,=0; // Leader is not flying
SendAction=3,8; // Stop Flight
Delay=200;
#ENDIF

_MemPtrReadVar=%AddrFreeMem4,%OffsetPosX,FLOAT,LeaderX;
_MemPtrReadVar=%AddrFreeMem4,%OffsetPosY,FLOAT,LeaderY;
_MemPtrReadVar=%AddrFreeMem4,%OffsetPosZ,FLOAT,LeaderZ;
FlySmooth=%Var[LeaderX],%Var[LeaderY],%Var[LeaderZ];


SessionGetVar=1; // Get Command
#IF=%Var1,=1; // Follow
#ELSE
_SetVar=temp,0;
#ENDIF
#UNTIL=%Var[temp],=0;


end_Follow;



start_Attack;

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,%ARRAY1; // If Player class is DPS
#ELSE
#EXECUTE=HealSort;
#Return
#ENDIF

#EXECUTE=MemoryCheck;
_MemPtrReadVar=%PlayerBase,%OffsetData/%Var[Offset_Base_NPCID],WORD,PlayerID; // Player ID
_MemPtrReadVar=%AddrFreeMem4,%OffsetData/%Var[Offset_Base_NPCID],WORD,LeaderID; // Leader ID
_MemPtrReadVar=%AddrFreeMem4,%OffsetData/%Var[Offset_Base_TargetNPCID],WORD,LeaderTargetID; // Leader's Target ID

_SetVar=temp,0;
#IF=%Var[LeaderTargetID],=%Var[PlayerID]; // if leader has player as target
_SetVar=temp,1;
#ENDIF
#IF=%Var[LeaderTargetID],=%Var[LeaderID]; // if leader has himself as target
_SetVar=temp,1;
#ENDIF
#IF=%Var[LeaderTargetID],=0; // if leader has nothing as target
_SetVar=temp,1;
#ENDIF

#IF=%Var[temp],=0;
Command=/select %Var[Leader];
#EXECUTE=WaitForTarget;
_IFMemPtrRead=%AddrFrameName[target_assist_dialog],%Var[Offset_TargetsTarget],WORD,>0; // if leader's target is alive
Command=/skill Select Target's Target;
#EXECUTE=WaitForTarget;
#EXECUTE=Combat;
#ENDIF

end_Attack;



start_Combat;

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,%ARRAY1; // If Player class is DPS
_AutoCombat=;
#ELSE
#EXECUTE=HealSort;
#ENDIF

end_Combat;

start_Quest;

#EXECUTE=MemoryCheck;
_MemPtrReadVar=%PlayerBase,%OffsetData/%Var[Offset_Base_NPCID],WORD,PlayerID; // Player ID
_MemPtrReadVar=%AddrFreeMem4,%OffsetData/%Var[Offset_Base_NPCID],WORD,LeaderID; // Leader ID
_MemPtrReadVar=%AddrFreeMem4,%OffsetData/%Var[Offset_Base_TargetNPCID],WORD,LeaderTargetID; // Leader's Target ID

_SetVar=temp,0;
#IF=%Var[LeaderTargetID],=%Var[PlayerID]; // if leader has player as target
_SetVar=temp,1;
#ENDIF
#IF=%Var[LeaderTargetID],=%Var[LeaderID]; // if leader has himself as target
_SetVar=temp,1;
#ENDIF
#IF=%Var[LeaderTargetID],=0; // if leader has nothing as target
_SetVar=temp,1;
#ENDIF

#IF=%Var[temp],=0;
Command=/select %Var[Leader];
#EXECUTE=WaitForTarget;
_IFMemPtrRead=%AddrFrameName[target_assist_dialog],%Var[Offset_TargetsTarget],WORD,>0; // if leader's target is alive
Command=/skill Select Target's Target;
#EXECUTE=WaitForTarget;
#DO=6000;
Command=/attack;
Delay=300;
_UNTILMemPtrRead=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_State],BYTE,=175;
_IFMemPtrRead=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_State],BYTE,=175;
#EXECUTE=DoQuest;
#ENDIF

end_Quest;



start_DoQuest;

MemPtrWrite=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_XPos],2.545898438,FLOAT;
MemPtrWrite=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_YPos],3.321690083,FLOAT;

_SetVar9=0; // x-cache
_SetVar10=0; // y-cache

#DO=120000;
DialogScroll=1;
#EXECUTE=WaitForMousePos;
#IF=%Var2,>0;
#IF=%Var3,>0;
Mouse=%Var2,%Var3;
Delay=500;
#ENDIF

SessionGetVar=1;
#IF=%Var1,=5; // Quest
#ELSE
_SetVar=temp,1;
#ENDIF
_IFMemPtrRead=%AddrFrameName[dlg_dialog],%Var[Offset_Frame_State],BYTE,=142;
_SetVar=temp,1;
#ENDIF
#UNTIL=%Var[temp],=1;

#EXECUTE=CloseWindows;

end_DoQuest;




start_WaitForMousePos;

_SetVar=temp2,0;
#DO=99999999;
DialogScroll=1;
SessionGetVar=2; //Mouse x
SessionGetVar=3; //Mouse y
#IF=%Var2,>0;
#IF=%Var3,>0;
_SetVar=temp2,1;
#ENDIF
#IF=%Var2,=%Var9;
_SetVar=temp2,0;
#ENDIF
#IF=%Var3,=%Var10;
_SetVar=temp2,0;
#ENDIF
SessionGetVar=1;
#IF=%Var1,=5; // Quest
#ELSE
#Return
#ENDIF
#UNTIL=%Var[temp2],=1;
_SetVar9=%Var2; // x-cache
_SetVar10=%Var3; // y-cache

end_WaitForMousePos;




start_HealSort;

_IFMemPtrRead=%AddrFrameName[party_dialog],%Var[Offset_PMember2],BYTE,>0;
#EXECUTE=HealWithParty;
#ELSE
#EXECUTE=HealWithoutParty;
#ENDIF

end_HealSort;



start_HealWithParty;

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=9; // Priest
_SetVar=Healer,Priest;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=10; // Cleric
_SetVar=Healer,Cleric;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=11; // Chanter
_SetVar=Healer,Chanter;
#ENDIF

_IFMemPtrRead=%AddrFrameName[party_dialog],%Var[Offset_PMember1],BYTE,>0;
_MemPtrReadVar=%AddrFrameName[party_dialog],%Var[Offset_PMember1],WCHAR[32],PMember1;
_SetVar=MemberAmount,1;
_IFMemPtrRead=%AddrFrameName[party_dialog],%Var[Offset_PMember2],BYTE,>0;
_MemPtrReadVar=%AddrFrameName[party_dialog],%Var[Offset_PMember2],WCHAR[32],PMember2;
_SetVar=MemberAmount,2;
_IFMemPtrRead=%AddrFrameName[party_dialog],%Var[Offset_PMember3],BYTE,>0;
_MemPtrReadVar=%AddrFrameName[party_dialog],%Var[Offset_PMember3],WCHAR[32],PMember3;
_SetVar=MemberAmount,3;
_IFMemPtrRead=%AddrFrameName[party_dialog],%Var[Offset_PMember4],BYTE,>0;
_MemPtrReadVar=%AddrFrameName[party_dialog],%Var[Offset_PMember4],WCHAR[32],PMember4;
_SetVar=MemberAmount,4;
_IFMemPtrRead=%AddrFrameName[party_dialog],%Var[Offset_PMember5],BYTE,>0;
_MemPtrReadVar=%AddrFrameName[party_dialog],%Var[Offset_PMember5],WCHAR[32],PMember5;
_SetVar=MemberAmount,5;
_IFMemPtrRead=%AddrFrameName[party_dialog],%Var[Offset_PMember6],BYTE,>0;
_MemPtrReadVar=%AddrFrameName[party_dialog],%Var[Offset_PMember6],WCHAR[32],PMember6;
_SetVar=MemberAmount,6;
#ENDIF

_SetVar=BaseAddr,%AddrFreeMem12;
_Calc[AddrPMember1]=%Var[BaseAddr]+0x0;
_Calc[AddrPMember2]=%Var[BaseAddr]+0x8;
_Calc[AddrPMember3]=%Var[BaseAddr]+0x10;
_Calc[AddrPMember4]=%Var[BaseAddr]+0x18;
_Calc[AddrPMember5]=%Var[BaseAddr]+0x20;
_Calc[AddrPMember6]=%Var[BaseAddr]+0x28;

_SetVar=temp,1;
_SetVar30=0;
#DO=99999999;
#IF=%Var30,=%Var[MemberAmount];
_SetVar30=1;
#ELSE
_Calc30=%Var30+1;
#ENDIF
#EXECUTE=MemoryCheckParty;

_IFMemPtrRead=%Var[AddrPMember%Var30],%OffsetPercentHP,BYTE,<97;
Command=/select %Var[PMember%Var30];
#EXECUTE=WaitForTarget;
#EXECUTE=HealSkill%Var[Healer];
#ENDIF

SessionGetVar=1; // Get Command
#IF=%Var1,=2; // Attack
#ELSE
_SetVar=temp,0;
#ENDIF
#UNTIL=%Var[temp],=0;

end_HealWithParty;



start_HealWithoutParty;

_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=9; // Priest
_SetVar=Healer,Priest;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=10; // Cleric
_SetVar=Healer,Cleric;
#ENDIF
_IFMemPtrRead=%PlayerBase,%OffsetClassID,BYTE,=11; // Chanter
_SetVar=Healer,Chanter;
